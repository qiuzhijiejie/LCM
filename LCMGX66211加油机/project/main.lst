 101          void Uart_Init(void)    //串口初始化
 102          {
 103   1          SCON = 0x50;            //8-bit variable UART
 104   1          TMOD |= 0x20;            //Set Timer1 as 8-bit auto reload mode
 105   1          TH1 = TL1 = -(FOSC/12/32/BAUD); //Set auto-reload vaule
 106   1          TR1 = 1;                //Timer1 start run
 107   1          ES = 1;                 //Enable UART interrupt
