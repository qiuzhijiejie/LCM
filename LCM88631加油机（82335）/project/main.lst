 123          //-----------------------------------------------
 124          void Uart_Send_Byte(u8 dat)
 125          {
 126   1              SBUF = dat;
 127   1              while(TI==0);
 128   1              TI=0;   
 129   1      }
 130          
 131          void Uart_Send_Hex(u8 Byte_HEX)
 132          {
 133   1              Uart_Send_Byte(DBHEX[Byte_HEX/16]);
 134   1              Uart_Send_Byte(DBHEX[Byte_HEX%16]);
 135   1      }
 136          
 137          
 138          void Uart_Send_IntHex(u16 Byte_HEX)
 139          {
 140   1              Uart_Send_Byte(DBHEX[(Byte_HEX>>8)/16]);
 141   1              Uart_Send_Byte(DBHEX[(Byte_HEX>>8)%16]);
 142   1              Uart_Send_Byte(DBHEX[(Byte_HEX&0xff)/16]);
 143   1              Uart_Send_Byte(DBHEX[(Byte_HEX&0xff)%16]);
 144   1      }
 145          
 146          
 147          void Uart_Send_Dec(u8 Byte_Dec)
 148          {
 149   1              Uart_Send_Byte(DBHEX[(Byte_Dec/100)%10]);
 150   1              Uart_Send_Byte(DBHEX[(Byte_Dec/10)%10]);
 151   1              Uart_Send_Byte(DBHEX[(Byte_Dec/1)%10]);
 152   1      }
 153          
 154          
 155          void Uart_Send_IntDec(u16 Int_dec)
 156          {
 157   1              Uart_Send_Byte(DBHEX[(Int_dec/10000)%10]);
 158   1              Uart_Send_Byte(DBHEX[(Int_dec/1000)%10]);
 159   1              Uart_Send_Byte(DBHEX[(Int_dec/100)%10]);
 160   1              Uart_Send_Byte(DBHEX[(Int_dec/10)%10]);
 161   1              Uart_Send_Byte(DBHEX[(Int_dec/1)%10]);
 162   1      }
