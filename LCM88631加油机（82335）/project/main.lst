 114          void Uart_Init(void)    //串口初始化
 115          {
 116   1          SCON = 0x50;            //8-bit variable UART
C51 COMPILER V9.60.7.0   MAIN                                                              09/20/2025 14:16:10 PAGE 3   

 117   1          TMOD |= 0x20;            //Set Timer1 as 8-bit auto reload mode
 118   1          TH1 = TL1 = -(FOSC/12/32/BAUD); //Set auto-reload vaule
 119   1          TR1 = 1;                //Timer1 start run
 120   1          ES = 1;                 //Enable UART interrupt
