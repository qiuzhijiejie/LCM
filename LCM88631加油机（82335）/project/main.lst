 193          
 194          u8 KEY_Scan(u8 mode)            //按键扫描函数
 195          {        
 196   1              static u8 key_up=1;
 197   1              if(mode)key_up=1;  
 198   1              if(key_up&&(KEY0==0||KEY1==0||KEY2==0||KEY3==0))
 199   1              {
 200   2                      delay_ms(10);
 201   2                      key_up=0;
 202   2                      if(KEY0==0)return KEY_UP;
 203   2                      else if(KEY1==0)return KEY_DOWN;
 204   2                      else if(KEY2==0)return KEY_RESET;
 205   2                      else if(KEY3==0)return KEY_FULL;
 206   2              }else if(KEY0==1&&KEY1==1&&KEY2==1&&KEY3==1)key_up=1;       
 207   1              return 0;
 208   1      }
