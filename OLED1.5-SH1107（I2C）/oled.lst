 259          void OLED_Init(void)
 260          {
 261   1          OLED_RES_Clr();
 262   1          delay_ms(2);
 263   1          OLED_RES_Set();
 264   1          
 265   1          OLED_WR_Byte(0xAE, OLED_CMD); // Display OFF
 266   1      
 267   1          OLED_WR_Byte(0xDC, OLED_CMD); // Set Display Start Line
 268   1          OLED_WR_Byte(0x00, OLED_CMD);
 269   1      
 270   1          OLED_WR_Byte(0x81, OLED_CMD); // Set Contrast Control
 271   1          OLED_WR_Byte(0x2F, OLED_CMD);
 272   1      
 273   1          OLED_WR_Byte(0x20, OLED_CMD); // Set Memory Addressing Mode = Page addressing
 274   1      
 275   1          OLED_WR_Byte(0xA0, OLED_CMD); // Set Segment Re-map (0xA0/0xA1)
 276   1          OLED_WR_Byte(0xC0, OLED_CMD); // Set COM Output Scan Direction (0xC0/0xC8)
 277   1      
 278   1          OLED_WR_Byte(0xA6, OLED_CMD); // Normal Display (0xA6) / Inverse (0xA7)
 279   1      
 280   1          OLED_WR_Byte(0xA8, OLED_CMD); // Set Multiplex Ratio
 281   1          OLED_WR_Byte(0x7F, OLED_CMD); // Duty = 1/128
 282   1      
 283   1          OLED_WR_Byte(0xD3, OLED_CMD); // Set Display Offset
 284   1          OLED_WR_Byte(0x60, OLED_CMD); // 常见模组要加偏移 0x60
 285   1      
 286   1          OLED_WR_Byte(0xAD, OLED_CMD); // Set DC-DC Control Mode
 287   1          OLED_WR_Byte(0x8A, OLED_CMD); // DC-DC ON
 288   1      
 289   1          OLED_WR_Byte(0xAF, OLED_CMD); // Display ON
 290   1      
 291   1      
 292   1      }
