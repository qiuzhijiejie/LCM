 304          // 按列填充 OLED，根据列号是奇数还是偶数选择不同的数据填充
 305          void OLED_Fill_Column(int oddData, int evenData) 
 306          {
 307   1          unsigned char page, column;
 308   1          for (page = 0; page < 16; page++) { // OLED 128x64 屏幕有 8 页
 309   2              OLED_Set_Pos(0, page); // 设置当前页的位置
 310   2              for (column = 0; column < 128; column++) { // 每页有 128 列
 311   3                  if (column % 2 == 0) { // 偶数列
 312   4                      OLED_WR_Byte((char)oddData, 1); // 使用 oddData 填充偶数列
 313   4                  } else { // 奇数列
 314   4                      OLED_WR_Byte((char)evenData, 1); // 使用 evenData 填充奇数列
 315   4                  }
 316   3              }
 317   2          }
 318   1      }


