  85          //写入一个字节
  86          void Send_Byte(u8 dat)
  87          {
  88   1              u8 i;
  89   1              for(i=0;i<8;i++)
  90   1              {
  91   2                      OLED_SCL_Clr();//将时钟信号设置为低电平
  92   2                      if(dat&0x80)//将dat的8位从最高位依次写入
  93   2                      {
  94   3                              OLED_SDA_Set();
  95   3          }
  96   2                      else
  97   2                      {
  98   3                              OLED_SDA_Clr();
  99   3          }
 100   2                      IIC_delay();
 101   2                      OLED_SCL_Set();
 102   2                      IIC_delay();
 103   2                      OLED_SCL_Clr();
 104   2                      dat<<=1;
 105   2        }
 106   1      }
