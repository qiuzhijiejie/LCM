 108          //发送一个字节
 109          //向SSD1306写入一个字节。
 110          //mode:数据/命令标志 0,表示命令;1,表示数据;
 111          void OLED_WR_Byte(u8 dat,u8 mode)
 112          {
 113   1              I2C_Start();
 114   1              Send_Byte(0x78);
 115   1              I2C_WaitAck();
 116   1              if(mode){Send_Byte(0x40);}
C51 COMPILER V9.60.7.0   OLED                                                              08/23/2025 15:05:13 PAGE 3   

 117   1          else{Send_Byte(0x00);}
 118   1              I2C_WaitAck();
 119   1              Send_Byte(dat);
 120   1              I2C_WaitAck();
 121   1              I2C_Stop();
 122   1      }
