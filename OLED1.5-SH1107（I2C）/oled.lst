 294          void OLED_Fill_Row(int Data) 
 295          {
 296   1          for ( row = 0; row < 16; row++) { // OLED 128x64 的 8 页（每页 8 行）
 297   2              OLED_Set_Pos(0, row); // 设置起始位置，从 (0, row) 开始
 298   2              for ( col = 0; col < 128; col++) { // 每页 128 列
 299   3                  OLED_WR_Byte((char)Data, 1); // 写入数据
 300   3              }
 301   2          }
 302   1      }
