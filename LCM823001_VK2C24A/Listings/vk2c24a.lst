 187          /*******************************************************************************
 188          * Function Name  : WriteCmd
 189          * Description    : 写1字节命令带参数
 190          * Input          : cmd-要写入的命令
 191          *                : data-要写入的参数
 192          * Output         : None
 193          * Return         : 0-ok 1-fail
 194          *******************************************************************************/
 195          unsigned char WriteCmdVk2c24a(unsigned char cmd, unsigned char Data )
 196          {
 197   1              Vk2c24a_I2CStart();
 198   1      
 199   1              Vk2c24a_I2CWriteByte( Vk2c24a_ADDR|0x00 );
 200   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 201   1              {
 202   2                      Vk2c24a_I2CStop(); 
 203   2                      return 0;   
 204   2              }
 205   1              Vk2c24a_I2CWriteByte( cmd );
 206   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 207   1              {
 208   2                      Vk2c24a_I2CStop(); 
 209   2                      return 0;   
 210   2              }
 211   1              Vk2c24a_I2CWriteByte( Data );
 212   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 213   1              {
 214   2                      Vk2c24a_I2CStop(); 
 215   2                      return 0;   
 216   2              }
 217   1        Vk2c24a_I2CStop();
 218   1       
 219   1        return 0;    //返回操作成败标志
 220   1      }
 221          /*******************************************************************************
 222          * Function Name  : Write1Data
 223          * Description    : 写1字节数据到显示RAM
 224          * Input          : Addr-写入ram的地址
 225          *                : Dat->写入ram的数据
 226          * Output         : None
 227          * Return         : 0-ok 1-fail
 228          *******************************************************************************/
 229          unsigned char Write1DataVk2c24a(unsigned char Addr,unsigned char Dat)
 230          {
 231   1              //START 信号
 232   1              Vk2c24a_I2CStart(); 
 233   1              //SLAVE地址
 234   1              Vk2c24a_I2CWriteByte(Vk2c24a_ADDR); 
 235   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 236   1              {               
 237   2                      Vk2c24a_I2CStop();
 238   2                      return 1; 
 239   2              }
 240   1              //写显示RAM命令
C51 COMPILER V9.60.7.0   VK2C24A                                                           03/04/2025 09:07:23 PAGE 5   

 241   1              Vk2c24a_I2CWriteByte(Vk2c24a_RWRAM);                                            
 242   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 243   1              {
 244   2                      Vk2c24a_I2CStop();                                                                                                      
 245   2                      return 0;
 246   2              }
 247   1              //显示RAM地址
 248   1              Vk2c24a_I2CWriteByte(Addr); 
 249   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 250   1              {
 251   2                      Vk2c24a_I2CStop();
 252   2                      return 1;
 253   2              }
 254   1              //显示数据，1字节数据包含2个SEG
 255   1              Vk2c24a_I2CWriteByte(Dat);
 256   1              if( Vk2c24a_I2CSlaveAck()==1 )
 257   1              {
 258   2                      Vk2c24a_I2CStop();
 259   2                      return 1;
 260   2              }
 261   1              //STOP信号
 262   1       Vk2c24a_I2CStop();
 263   1       return 0;   
 264   1      }
 265          /*******************************************************************************
 266          * Function Name  : WritenData
 267          * Description    : 写多个数据到显示RAM
 268          * Input          : Addr-写入ram的起始地址
 269          *                : Databuf->写入ram的数据buffer指针
 270          *                : Cnt->写入ram的数据个数
 271          * Output         : None
 272          * Return         : 0-ok 1-fail
 273          *******************************************************************************/
 274          unsigned char  WritenDataVk2c24a(unsigned char Addr,unsigned char *Databuf,unsigned char Cnt)
 275          {
 276   1              unsigned char n;
 277   1              
 278   1              //START信号     
 279   1              Vk2c24a_I2CStart();                                                                     
 280   1              //SLAVE地址
 281   1              Vk2c24a_I2CWriteByte(Vk2c24a_ADDR);     
 282   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 283   1              {
 284   2                      Vk2c24a_I2CStop();                                                                                                      
 285   2                      return 0;                                                                               
 286   2              }
 287   1              //写显示RAM命令
 288   1              Vk2c24a_I2CWriteByte(Vk2c24a_RWRAM);                                            
 289   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 290   1              {
 291   2                      Vk2c24a_I2CStop();                                                                                                      
 292   2                      return 0;
 293   2              }
 294   1              //显示RAM起始地址
 295   1              Vk2c24a_I2CWriteByte(Addr);                                             
 296   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 297   1              {
 298   2                      Vk2c24a_I2CStop();                                                                                                      
 299   2                      return 0;
 300   2              }
 301   1              //发送Cnt个数据到显示RAM
 302   1              for(n=0;n<Cnt;n++)
C51 COMPILER V9.60.7.0   VK2C24A                                                           03/04/2025 09:07:23 PAGE 6   

 303   1              { 
 304   2                      Vk2c24a_I2CWriteByte(*Databuf++);
 305   2                      if( Vk2c24a_I2CSlaveAck()==1 )
 306   2                      {
 307   3                              Vk2c24a_I2CStop();                                                                                                      
 308   3                              return 0;
 309   3                      }
 310   2              }
 311   1              //STOP信号
 312   1               Vk2c24a_I2CStop();                                                                                     
 313   1               return 0;    
 314   1      }
 315          /*******************************************************************************
 316          * Function Name  : Vk2c24a_DisAll
 317          * Description    : 所有SEG显示同一个数据，bit7/bit3-COM3 bit6/bit2-COM2 bit5/bit1-COM1 bit4/bit0-COM0
 318          *                                : 例如：0xff全亮 0x00全灭 0x55灭亮灭亮 0xaa亮灭亮灭 0x33灭灭亮亮 
 319          * Input          ：dat->写入ram的数据(1个字节数据对应2个SEG)  
 320          * Output         : None
 321          * Return         : None
 322          *******************************************************************************/
 323          void Vk2c24a_DisAll(unsigned char dat)
 324          {
 325   1              unsigned char segi;
 326   1              unsigned char dispram[120];
 327   1              
 328   1              if(vk2c24a_maxcom==4)
 329   1              {
 330   2                      for(segi=0;segi<36;segi++)
 331   2                      {
 332   3                              dispram[segi]=dat;
 333   3                      }
 334   2                      WritenDataVk2c24a(0,dispram,36);//这里送8bit数据对应2个SEG，每8bit数据地址加1，每8位数据1个ACK
 335   2              }
 336   1              else if(vk2c24a_maxcom==8)
 337   1              {
 338   2                      for(segi=0;segi<68;segi++)
 339   2                      {
 340   3                              dispram[segi]=dat;
 341   3                      }
 342   2                      WritenDataVk2c24a(0,dispram,68);//这里送8bit数据对应1个SEG，每8bit数据地址加1，每8位数据1个ACK
 343   2              }
 344   1              else if(vk2c24a_maxcom==16)
 345   1              {
 346   2                      for(segi=0;segi<120;segi++)
 347   2                      {
 348   3                              dispram[segi]=dat;
 349   3                      }
 350   2                      WritenDataVk2c24a(0,dispram,120);//这里送8bit数据对应1个SEG，每8bit数据地址加1，每8位数据1个ACK
 351   2              }
 352   1      }
 353          /*******************************************************************************
 354          * Function Name  : DisSegComOn
 355          * Description    : 点亮1个点(1个seg和1个com交叉对应的显示点)
 356          * Input          ：seg->点对应的seg脚  
 357          *                        ：com->点对应com脚  
 358          * Output         : None
 359          * Return         : None
 360          *******************************************************************************/
 361          void Vk2c24a_DisSegComOn(unsigned char seg,unsigned char com)
 362          {
 363   1      //      if(vk2c24a_maxcom==4)
 364   1      //      {
C51 COMPILER V9.60.7.0   VK2C24A                                                           03/04/2025 09:07:23 PAGE 7   

 365   1      //              if(seg%2==0)
 366   1      //                      Write1DataVk2c24a(seg/2,(1<<(com)));//这里送8位数据低4bit有效，每8bit数据地址加1，每8位数据1个ACK)
 367   1      //              else
 368   1      //                      Write1DataVk2c24a(seg/2,(1<<(4+com)));//这里送8位数据高4bit有效，每8bit数据地址加1，每8位数据1个ACK
 369   1      //      }
 370   1      //      else
 371   1      //      {
 372   1      //              Write1DataVk2c24a(seg,(1<<(com)));//这里送8位数据低4bit有效，每8bit数据地址加1，每8位数据1个ACK
 373   1      //      }
 374   1              
 375   1              unsigned char addrbit, tempdat;
 376   1          if (seg % 2 == 0)//判断是不是偶数
 377   1              addrbit = (1 << com); // 对应低 4 位
 378   1          else
 379   1              addrbit = (1 << (4 + com)); // 对应高 4 位
 380   1          // 将显示状态累加，而不是覆盖
 381   1          tempdat = vk2c24a_dispram[seg / 2] | addrbit;
 382   1          vk2c24a_dispram[seg / 2] = tempdat;
 383   1          WritenDataVk2c24a(seg / 2, &tempdat, 1);    
 384   1      }
 385          /*******************************************************************************
 386          * Function Name  : DisSegComOff
 387          * Description    : 关闭1个点(1个seg和1个com交叉对应的显示点)
 388          * Input          ：seg->点对应的seg脚  
 389          *                        ：com->点对应com脚  
 390          * Output         : None
 391          * Return         : None
 392          *******************************************************************************/
 393          void Vk2c24a_DisSegComOff(unsigned char seg,unsigned char com)
 394          {
 395   1              if(vk2c24a_maxcom==4)
 396   1              {
 397   2                      if(seg%2==0)
 398   2                              Write1DataVk2c24a(seg/2,~(1<<com));//这里送8位数据低4bit有效，每8bit数据地址加1，每8位数据1个ACK
 399   2                      else
 400   2                              Write1DataVk2c24a(seg/2,~(1<<(4+com)));//这里送8位数据高4bit有效，每8bit数据地址加1，每8位数据1个ACK
 401   2              }
 402   1              else
 403   1              {
 404   2                      Write1DataVk2c24a(seg,~(1<<com));//这里送8位数据低4bit有效，每8bit数据地址加1，每8位数据1个ACK
 405   2              }
 406   1      }
