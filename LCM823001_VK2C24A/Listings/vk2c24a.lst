 488          /*******************************************************************************
C51 COMPILER V9.60.7.0   VK2C24A                                                           03/04/2025 09:07:23 PAGE 9   

 489          * Function Name  : disp_3num
 490          * Description    : 显示3位数字
 491          * Input          ：dat->3位数字 十进制 
 492          * Output         : None
 493          * Return         : None
 494          *******************************************************************************/
 495          void disp_3num(unsigned int dat)
 496          {               
 497   1              unsigned dat8;
 498   1                      
 499   1              if(vk2c24a_maxcom==4)
 500   1              {
 501   2                      dat8=dat/100%10;        //显示百位
 502   2                      vk2c24a_dispram[2]&=0xf0;
 503   2                      vk2c24a_dispram[2]|=shuzi_zimo[dat8]&0x0f;
 504   2                      vk2c24a_dispram[2]&=0x8f;
 505   2                      vk2c24a_dispram[2]|=shuzi_zimo[dat8]&0xf0;
 506   2                      
 507   2                      dat8=dat/10%10;         //显示十位
 508   2                      vk2c24a_dispram[3]&=0xf0;
 509   2                      vk2c24a_dispram[3]|=shuzi_zimo[dat8]&0x0f;
 510   2                      vk2c24a_dispram[3]&=0x8f;
 511   2                      vk2c24a_dispram[3]|=shuzi_zimo[dat8]&0xf0;
 512   2                      
 513   2                      dat8=dat%10;                    //显示个位
 514   2                      vk2c24a_dispram[4]&=0xf0;
 515   2                      vk2c24a_dispram[4]|=shuzi_zimo[dat8]&0x0f;
 516   2                      vk2c24a_dispram[4]&=0x8f;
 517   2                      vk2c24a_dispram[4]|=shuzi_zimo[dat8]&0xf0;
 518   2                              
 519   2                      if(dat<100)                             //数字小于100，百位不显示
 520   2                      {
 521   3                      vk2c24a_dispram[2]&=0xf0;
 522   3                      vk2c24a_dispram[2]&=0x8f;
 523   3                      }
 524   2                      if(dat<10)      //数字小于10，十位不显示
 525   2                      {
 526   3                      vk2c24a_dispram[3]&=0xf0;
 527   3                      vk2c24a_dispram[3]&=0x8f;
 528   3                      }
 529   2                      //SEG不连续1个1个数据送
 530   2      //              Write1DataVk2c24a(2,vk2c24a_dispram[2]);
 531   2      //              Write1DataVk2c24a(3,vk2c24a_dispram[3]);
 532   2      //              Write1DataVk2c24a(4,vk2c24a_dispram[4]);
 533   2                      //SEG连续送多个数据
 534   2                      WritenDataVk2c24a(2,&vk2c24a_dispram[2],3);
 535   2              }
 536   1              else
 537   1              {
 538   2                      dat8=dat/100%10;        //显示百位
 539   2                      vk2c24a_dispram[2]&=0x80;
 540   2                      vk2c24a_dispram[2]|=shuzi_zimo[dat8];
 541   2                      
 542   2                      dat8=dat/10%10;         //显示十位
 543   2                      vk2c24a_dispram[3]&=0x80;
 544   2                      vk2c24a_dispram[3]|=shuzi_zimo[dat8];
 545   2                      
 546   2                      dat8=dat%10;                    //显示个位
 547   2                      vk2c24a_dispram[4]&=0x80;
 548   2                      vk2c24a_dispram[4]|=shuzi_zimo[dat8];
 549   2                              
 550   2                      if(dat<100)                             //数字小于100，百位不显示
C51 COMPILER V9.60.7.0   VK2C24A                                                           03/04/2025 09:07:23 PAGE 10  

 551   2                      {
 552   3                              vk2c24a_dispram[2]&=0x80;
 553   3                      }
 554   2                      if(dat<10)      //数字小于10，十位不显示
 555   2                      {
 556   3                              vk2c24a_dispram[3]&=0x80;
 557   3                      }
 558   2                      //SEG不连续1个1个数据送
 559   2      //              Write1DataVk2c24a(2,vk2c24a_dispram[2]);
 560   2      //              Write1DataVk2c24a(3,vk2c24a_dispram[3]);
 561   2      //              Write1DataVk2c24a(4,vk2c24a_dispram[4]);
 562   2                      //SEG连续送多个数据
 563   2                      WritenDataVk2c24a(2,&vk2c24a_dispram[2],3);
 564   2              }
 565   1      }       
