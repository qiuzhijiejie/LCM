  63          /*******************************************************************************
  64          * Function Name  : delay_nus
  65          * Description    : 延时1uS程序
  66          * Input          : n->延时时间nuS
  67          * Output         : None
  68          * Return         : None
  69          *******************************************************************************/
  70          void delay_nus(unsigned int n)     
  71          {
  72   1              unsigned char i;
  73   1              while(n--)
  74   1              {
  75   2                      i=20;
  76   2                      while(i--)
  77   2                      {//nop指令根据单片机做相应的修改
  78   3                              _nop_();
  79   3                      }
  80   2              }
  81   1      }
  82          /*******************************************************************************
  83          * Function Name  : delay_nms
  84          * Description    : 延时1mS程序
  85          * Input          : n->延时时间nmS
  86          * Output         : None
  87          * Return         : None
  88          *******************************************************************************/
  89          void delay_nms(unsigned long int n)
  90          {
  91   1              while(n--)
  92   1              {
  93   2                      delay_nus(1000);
  94   2              }
  95   1      }
  96          /*******************************************************************************
  97          * Function Name  : I2CStart
  98          * Description    : 时钟线高时，数据线由高到低的跳变，表示I2C开始信号
  99          * Input          : None
 100          * Output         : None
 101          * Return         : None
 102          *******************************************************************************/
 103          void Vk2c24a_I2CStart( void )
 104          {
 105   1        Vk2c24a_SCL_H();
 106   1        Vk2c24a_SDA_H();
 107   1        delay_nus(Vk2c24a_CLK);
 108   1        Vk2c24a_SDA_L();
 109   1        delay_nus(Vk2c24a_CLK);
 110   1      }
 111          /*******************************************************************************
 112          * Function Name  : I2CStop
 113          * Description    : 时钟线高时，数据线由低到高的跳变，表示I2C停止信号
 114          * Input          : None
 115          * Output         : None
 116          * Return         : None
C51 COMPILER V9.60.7.0   VK2C24A                                                           03/04/2025 09:07:23 PAGE 3   

 117          *******************************************************************************/
 118          void Vk2c24a_I2CStop( void )
 119          {
 120   1        Vk2c24a_SCL_H();
 121   1        Vk2c24a_SDA_L();
 122   1        delay_nus(Vk2c24a_CLK);
 123   1        Vk2c24a_SDA_H();
 124   1        delay_nus(Vk2c24a_CLK);
 125   1      }
 126          /*******************************************************************************
 127          * Function Name  : I2CSlaveAck
 128          * Description    : I2C从机设备应答查询
 129          * Input          : None
 130          * Output         : None
 131          * Return         : 0-ok 1-fail
 132          *******************************************************************************/
 133          unsigned char Vk2c24a_I2CSlaveAck( void )
 134          {
 135   1        unsigned int TimeOut;
 136   1        unsigned char RetValue;
 137   1              
 138   1        Vk2c24a_SCL_L();
 139   1              //单片机SDA脚为单向IO要设为输入脚
 140   1      //      Vk2c24a_SET_SDA_IN();
 141   1        delay_nus(Vk2c24a_CLK);
 142   1        Vk2c24a_SCL_H();//第9个sclk上升沿
 143   1      
 144   1        TimeOut = 10000;
 145   1        while( TimeOut-- > 0 )
 146   1        {
 147   2          if( Vk2c24a_GET_SDA()!=0 )//读取ack
 148   2          {
 149   3            RetValue = 1;
 150   3          }
 151   2          else
 152   2          {
 153   3            RetValue = 0;
 154   3            break;
 155   3          }
 156   2        } 
 157   1              Vk2c24a_SCL_L();
 158   1              //单片机SDA脚为单向IO要设为输出脚
 159   1      //      Vk2c24a_SET_SDA_OUT(); 
 160   1        
 161   1        return RetValue;
 162   1      }
 163          /*******************************************************************************
 164          * Function Name  : I2CWriteByte
 165          * Description    : I2C写一字节,先送高位
 166          * Input          : byte-要写入的数据
 167          * Output         : None
 168          * Return         : None
 169          *******************************************************************************/
 170          void Vk2c24a_I2CWriteByte( unsigned char byte )
 171          {
 172   1              unsigned char i=8;
 173   1              while (i--)
 174   1              { 
 175   2                      Vk2c24a_SCL_L();
 176   2                      if(byte&0x80)
 177   2                              Vk2c24a_SDA_H();
 178   2                      else
C51 COMPILER V9.60.7.0   VK2C24A                                                           03/04/2025 09:07:23 PAGE 4   

 179   2                              Vk2c24a_SDA_L();
 180   2                      byte<<=1; 
 181   2                      delay_nus(Vk2c24a_CLK);
 182   2                      Vk2c24a_SCL_H();     
 183   2                      delay_nus(Vk2c24a_CLK);
 184   2              }
 185   1      }
