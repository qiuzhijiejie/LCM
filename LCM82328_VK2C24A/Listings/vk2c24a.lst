 491   3                      }
 492   2                      if(dat<10)      //数字小于10，十位不显示
 493   2                      {
 494   3                      vk2c24a_dispram[3]&=0xf0;
 495   3                      vk2c24a_dispram[3]&=0x8f;
 496   3                      }
 497   2                      //SEG不连续1个1个数据送
 498   2      //              Write1DataVk2c24a(2,vk2c24a_dispram[2]);
 499   2      //              Write1DataVk2c24a(3,vk2c24a_dispram[3]);
