  55          /*******************************************************************************
  56          * Function Name  : I2CStart
  57          * Description    : 时钟线高时，数据线由高到低的跳变，表示I2C开始信号
  58          * Input          : None
  59          * Output         : None
  60          * Return         : None
  61          *******************************************************************************/
  62          void Vk2c24a_I2CStart( void )
  63          {
  64   1        Vk2c24a_SCL_H();
  65   1        Vk2c24a_SDA_H();
  66   1        delay_nus(Vk2c24a_CLK);
  67   1        Vk2c24a_SDA_L();
  68   1        delay_nus(Vk2c24a_CLK);
  69   1      }
  70          /*******************************************************************************
  71          * Function Name  : I2CStop
  72          * Description    : 时钟线高时，数据线由低到高的跳变，表示I2C停止信号
  73          * Input          : None
  74          * Output         : None
  75          * Return         : None
  76          *******************************************************************************/
  77          void Vk2c24a_I2CStop( void )
  78          {
  79   1        Vk2c24a_SCL_H();
  80   1        Vk2c24a_SDA_L();
  81   1        delay_nus(Vk2c24a_CLK);
  82   1        Vk2c24a_SDA_H();
  83   1        delay_nus(Vk2c24a_CLK);
  84   1      }
  85          /*******************************************************************************
  86          * Function Name  : I2CSlaveAck
  87          * Description    : I2C从机设备应答查询
  88          * Input          : None
  89          * Output         : None
  90          * Return         : 0-ok 1-fail
  91          *******************************************************************************/
  92          unsigned char Vk2c24a_I2CSlaveAck( void )
  93          {
  94   1        unsigned int TimeOut;
  95   1        unsigned char RetValue;
  96   1              
  97   1        Vk2c24a_SCL_L();
  98   1              //单片机SDA脚为单向IO要设为输入脚
  99   1      //      Vk2c24a_SET_SDA_IN();
 100   1        delay_nus(Vk2c24a_CLK);
 101   1        Vk2c24a_SCL_H();//第9个sclk上升沿
 102   1      
 103   1        TimeOut = 10000;
 104   1        while( TimeOut-- > 0 )
 105   1        {
 106   2          if( Vk2c24a_GET_SDA()!=0 )//读取ack
 107   2          {
 108   3            RetValue = 1;
 109   3          }
 110   2          else
 111   2          {
 112   3            RetValue = 0;
 113   3            break;
 114   3          }
 115   2        } 
 116   1              Vk2c24a_SCL_L();
C51 COMPILER V9.60.7.0   VK2C24A                                                           01/06/2025 16:22:12 PAGE 3   

 117   1              //单片机SDA脚为单向IO要设为输出脚
 118   1      //      Vk2c24a_SET_SDA_OUT(); 
 119   1        
 120   1        return RetValue;
 121   1      }
 122          /*******************************************************************************
 123          * Function Name  : I2CWriteByte
 124          * Description    : I2C写一字节,先送高位
 125          * Input          : byte-要写入的数据
 126          * Output         : None
 127          * Return         : None
 128          *******************************************************************************/
 129          void Vk2c24a_I2CWriteByte( unsigned char byte )
 130          {
 131   1              unsigned char i=8;
 132   1              while (i--)
 133   1              { 
 134   2                      Vk2c24a_SCL_L();
 135   2                      if(byte&0x80)
 136   2                              Vk2c24a_SDA_H();
 137   2                      else
 138   2                              Vk2c24a_SDA_L();
 139   2                      byte<<=1; 
 140   2                      delay_nus(Vk2c24a_CLK);
 141   2                      Vk2c24a_SCL_H();     
 142   2                      delay_nus(Vk2c24a_CLK);
 143   2              }
 144   1      }
