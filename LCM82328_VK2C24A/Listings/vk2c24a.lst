 463          void disp_3num(unsigned int dat)
 464          {               
 465   1              unsigned dat8;
 466   1                      
 467   1              if(vk2c24a_maxcom==4)
 468   1              {
 469   2                      dat8=dat/100%10;        //显示百位
 470   2                      vk2c24a_dispram[2]&=0xf0;
 471   2                      vk2c24a_dispram[2]|=shuzi_zimo[dat8]&0x0f;
 472   2                      vk2c24a_dispram[2]&=0x8f;
 473   2                      vk2c24a_dispram[2]|=shuzi_zimo[dat8]&0xf0;
 474   2                      
 475   2                      dat8=dat/10%10;         //显示十位
 476   2                      vk2c24a_dispram[3]&=0xf0;
 477   2                      vk2c24a_dispram[3]|=shuzi_zimo[dat8]&0x0f;
 478   2                      vk2c24a_dispram[3]&=0x8f;
 479   2                      vk2c24a_dispram[3]|=shuzi_zimo[dat8]&0xf0;
 480   2                      
 481   2                      dat8=dat%10;                    //显示个位
 482   2                      vk2c24a_dispram[4]&=0xf0;
