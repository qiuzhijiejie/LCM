 512   2                      vk2c24a_dispram[3]|=shuzi_zimo[dat8];
 513   2                      
 514   2                      dat8=dat%10;                    //显示个位
 515   2                      vk2c24a_dispram[4]&=0x80;
 516   2                      vk2c24a_dispram[4]|=shuzi_zimo[dat8];
 517   2                              
 518   2                      if(dat<100)                             //数字小于100，百位不显示
 519   2                      {
