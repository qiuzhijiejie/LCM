 485   2                      vk2c24a_dispram[4]|=shuzi_zimo[dat8]&0xf0;
 486   2                              
 487   2                      if(dat<100)                             //数字小于100，百位不显示
 488   2                      {
C51 COMPILER V9.60.7.0   VK2C24A                                                           01/06/2025 16:22:12 PAGE 9   

 489   3                      vk2c24a_dispram[2]&=0xf0;
