  22          /*******************************************************************************
  23          * Function Name  : delay_nus
  24          * Description    : 延时1uS程序
  25          * Input          : n->延时时间nuS
  26          * Output         : None
  27          * Return         : None
  28          *******************************************************************************/
  29          void delay_nus(unsigned int n)     
  30          {
  31   1              unsigned char i;
  32   1              while(n--)
  33   1              {
  34   2                      i=20;
  35   2                      while(i--)
  36   2                      {//nop指令根据单片机做相应的修改
  37   3                              _nop_();
  38   3                      }
  39   2              }
  40   1      }
  41          /*******************************************************************************
  42          * Function Name  : delay_nms
  43          * Description    : 延时1mS程序
  44          * Input          : n->延时时间nmS
  45          * Output         : None
  46          * Return         : None
  47          *******************************************************************************/
  48          void delay_nms(unsigned long int n)
  49          {
  50   1              while(n--)
  51   1              {
  52   2                      delay_nus(1000);
  53   2              }
  54   1      }
