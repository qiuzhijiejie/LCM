 535          
 536          void DisplayDigitOrChar(unsigned char pos, unsigned char index) 
 537          {
 538   1              unsigned char  Data;
 539   1          // 检查索引是否在数组范围内
 540   1          if (index >= sizeof(shuzi_zimo)) 
 541   1                      return;
 542   1      
 543   1          // 获取字模数据
 544   1          Data = shuzi_zimo[index];
 545   1      
 546   1          // 使用 Write1DataVk2c22 将数据写入显示 RAM 的指定位置
 547   1          Write1DataVk2c24a(pos, Data);
 548   1      }


