 146          /*******************************************************************************
 147          * Function Name  : WriteCmd
 148          * Description    : 写1字节命令带参数
 149          * Input          : cmd-要写入的命令
 150          *                : data-要写入的参数
 151          * Output         : None
 152          * Return         : 0-ok 1-fail
 153          *******************************************************************************/
 154          unsigned char WriteCmdVk2c24a(unsigned char cmd, unsigned char Data )
 155          {
 156   1              Vk2c24a_I2CStart();
 157   1      
 158   1              Vk2c24a_I2CWriteByte( Vk2c24a_ADDR|0x00 );
 159   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 160   1              {
 161   2                      Vk2c24a_I2CStop(); 
 162   2                      return 0;   
 163   2              }
 164   1              Vk2c24a_I2CWriteByte( cmd );
 165   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 166   1              {
 167   2                      Vk2c24a_I2CStop(); 
 168   2                      return 0;   
 169   2              }
 170   1              Vk2c24a_I2CWriteByte( Data );
 171   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 172   1              {
 173   2                      Vk2c24a_I2CStop(); 
 174   2                      return 0;   
 175   2              }
 176   1        Vk2c24a_I2CStop();
 177   1       
 178   1        return 0;    //返回操作成败标志
C51 COMPILER V9.60.7.0   VK2C24A                                                           01/06/2025 16:22:12 PAGE 4   

 179   1      }
 180          /*******************************************************************************
 181          * Function Name  : Write1Data
 182          * Description    : 写1字节数据到显示RAM
 183          * Input          : Addr-写入ram的地址
 184          *                : Dat->写入ram的数据
 185          * Output         : None
 186          * Return         : 0-ok 1-fail
 187          *******************************************************************************/
 188          unsigned char Write1DataVk2c24a(unsigned char Addr,unsigned char Dat)
 189          {
 190   1              //START 信号
 191   1              Vk2c24a_I2CStart(); 
 192   1              //SLAVE地址
 193   1              Vk2c24a_I2CWriteByte(Vk2c24a_ADDR); 
 194   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 195   1              {               
 196   2                      Vk2c24a_I2CStop();
 197   2                      return 1; 
 198   2              }
 199   1              //写显示RAM命令
 200   1              Vk2c24a_I2CWriteByte(Vk2c24a_RWRAM);                                            
 201   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 202   1              {
 203   2                      Vk2c24a_I2CStop();                                                                                                      
 204   2                      return 0;
 205   2              }
 206   1              //显示RAM地址
 207   1              Vk2c24a_I2CWriteByte(Addr); 
 208   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 209   1              {
 210   2                      Vk2c24a_I2CStop();
 211   2                      return 1;
 212   2              }
 213   1              //显示数据，1字节数据包含2个SEG
 214   1              Vk2c24a_I2CWriteByte(Dat);
 215   1              if( Vk2c24a_I2CSlaveAck()==1 )
 216   1              {
 217   2                      Vk2c24a_I2CStop();
 218   2                      return 1;
 219   2              }
 220   1              //STOP信号
 221   1       Vk2c24a_I2CStop();
 222   1       return 0;   
 223   1      }
 224          /*******************************************************************************
 225          * Function Name  : WritenData
 226          * Description    : 写多个数据到显示RAM
 227          * Input          : Addr-写入ram的起始地址
 228          *                : Databuf->写入ram的数据buffer指针
 229          *                : Cnt->写入ram的数据个数
 230          * Output         : None
 231          * Return         : 0-ok 1-fail
 232          *******************************************************************************/
 233          unsigned char  WritenDataVk2c24a(unsigned char Addr,unsigned char *Databuf,unsigned char Cnt)
 234          {
 235   1              unsigned char n;
 236   1              
 237   1              //START信号     
 238   1              Vk2c24a_I2CStart();                                                                     
 239   1              //SLAVE地址
 240   1              Vk2c24a_I2CWriteByte(Vk2c24a_ADDR);     
C51 COMPILER V9.60.7.0   VK2C24A                                                           01/06/2025 16:22:12 PAGE 5   

 241   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 242   1              {
 243   2                      Vk2c24a_I2CStop();                                                                                                      
 244   2                      return 0;                                                                               
 245   2              }
 246   1              //写显示RAM命令
 247   1              Vk2c24a_I2CWriteByte(Vk2c24a_RWRAM);                                            
 248   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 249   1              {
 250   2                      Vk2c24a_I2CStop();                                                                                                      
 251   2                      return 0;
 252   2              }
 253   1              //显示RAM起始地址
 254   1              Vk2c24a_I2CWriteByte(Addr);                                             
 255   1              if( 1 == Vk2c24a_I2CSlaveAck() )
 256   1              {
 257   2                      Vk2c24a_I2CStop();                                                                                                      
 258   2                      return 0;
 259   2              }
 260   1              //发送Cnt个数据到显示RAM
 261   1              for(n=0;n<Cnt;n++)
 262   1              { 
 263   2                      Vk2c24a_I2CWriteByte(*Databuf++);
 264   2                      if( Vk2c24a_I2CSlaveAck()==1 )
 265   2                      {
 266   3                              Vk2c24a_I2CStop();                                                                                                      
 267   3                              return 0;
 268   3                      }
 269   2              }
 270   1              //STOP信号
 271   1               Vk2c24a_I2CStop();                                                                                     
 272   1               return 0;    
 273   1      }
 274          /*******************************************************************************
 275          * Function Name  : Vk2c24a_DisAll
 276          * Description    : 所有SEG显示同一个数据，bit7/bit3-COM3 bit6/bit2-COM2 bit5/bit1-COM1 bit4/bit0-COM0
 277          *                                            : 例如：0xff全亮 0x00全灭 0x55灭亮灭亮 0xaa亮灭亮灭 0x33灭灭亮亮 
 278          * Input          ：dat->写入ram的数据(1个字节数据对应2个SEG)  
 279          * Output         : None
 280          * Return         : None
 281          *******************************************************************************/
 282          void Vk2c24a_DisAll(unsigned char dat)
 283          {
 284   1              unsigned char segi;
 285   1              unsigned char dispram[120];
 286   1              
 287   1              if(vk2c24a_maxcom==4)
 288   1              {
 289   2                      for(segi=0;segi<36;segi++)
 290   2                      {
 291   3                              dispram[segi]=dat;
 292   3                      }
 293   2                      WritenDataVk2c24a(0,dispram,36);//这里送8bit数据对应2个SEG，每8bit数据地址加1，每8位数据1个ACK
 294   2              }
 295   1              else if(vk2c24a_maxcom==8)
 296   1              {
 297   2                      for(segi=0;segi<68;segi++)
 298   2                      {
 299   3                              dispram[segi]=dat;
 300   3                      }
 301   2                      WritenDataVk2c24a(0,dispram,68);//这里送8bit数据对应1个SEG，每8bit数据地址加1，每8位数据1个ACK
 302   2              }
C51 COMPILER V9.60.7.0   VK2C24A                                                           01/06/2025 16:22:12 PAGE 6   

 303   1              else if(vk2c24a_maxcom==16)
 304   1              {
 305   2                      for(segi=0;segi<120;segi++)
 306   2                      {
 307   3                              dispram[segi]=dat;
 308   3                      }
 309   2                      WritenDataVk2c24a(0,dispram,120);//这里送8bit数据对应1个SEG，每8bit数据地址加1，每8位数据1个ACK
 310   2              }
 311   1      }
