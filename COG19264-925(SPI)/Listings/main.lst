  79          //LCD模块初始化
  80          //=======对比度设置值0xa5=======//
  81          void initial_lcd()
  82          {
  83   1              reset=0;        //低电平复位
  84   1              delay(100);
  85   1              reset=1;                    //复位完毕
  86   1              delay(200);        
  87   1              transfer_command(0xe2);  //软复位
  88   1              delay(200);
  89   1              transfer_command(0x2f);  //打开内部升压
  90   1              delay(200);
  91   1              transfer_command(0xa0);  //
  92   1              transfer_command(0x81);  //微调对比度V0-XV0=10.21v
  93   1              transfer_command(0x79);  //微调对比度的值，可设置范围0x00～0xFF
  94   1              transfer_command(0xeb);  //1/9偏压比（bias）
  95   1              transfer_command(0xc4);  //行列扫描顺序：从上到下 
  96   1      //      transfer_command(0xc6);  //行列扫描顺序：从上到下 
  97   1              transfer_command(0xaf);  //开显示       
  98   1      }
