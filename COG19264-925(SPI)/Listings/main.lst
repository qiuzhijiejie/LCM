 100          
 101          void lcd_address(uchar page,uchar column)
 102          {
 103   1              column=column-1;                                                        //我们平常所说的第1列，在LCD驱动IC里是第0列。所以在这里减去1.
 104   1              page=page-1;
 105   1              transfer_command(0xb0+page);                    //设置页地址。每页是8行。一个画面的64行被分成8个页。我们平常所说的第1页
             -，在LCD驱动IC里是第0页，所以在这里减去1
 106   1              transfer_command(((column>>4)&0x0f)+0x10);      //设置列地址的高4位
 107   1              transfer_command(column&0x0f);                          //设置列地址的低4位
 108   1      }
