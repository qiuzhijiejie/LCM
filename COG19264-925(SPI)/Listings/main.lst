  23          //写指令到LCD模块
  24          void transfer_command(int data1)   
  25          {
  26   1              char i;
  27   1              cs1=0;
  28   1              rs=0;
  29   1              for(i=0;i<8;i++)
  30   1              {
  31   2                      sclk=0;
  32   2                      if(data1&0x80) sid=1;
  33   2                      else sid=0;
  34   2                      sclk=1;
  35   2                      data1=data1<<=1;
  36   2              }
  37   1              cs1=1;
  38   1      }
  39          
