 131          /**
 132            * @brief  LCD2002设置光标位置
 133            * @param  Line 行位置，范围：1~2
 134            * @param  Column 列位置，范围：1~20
 135            * @retval 无
 136            */
 137          void LCD_SetCursor(unsigned int Line, unsigned int Column) 
 138          {
 139   1          // 确保列值在0-19之间
 140   1          if (Column >= 20) Column = 0;
 141   1          // 确保行值在0-2之间
 142   1          Line &= 0x01;  // 限制 Y 位置在 0 到 3 之间         
 143   1          if (Line == 0) 
 144   1          {
 145   2              LCD_WriteCommand(0x80 | Column);  // 第一行
 146   2          } 
 147   1          else  
 148   1          {
 149   2              LCD_WriteCommand(0xC0 | Column);  // 第二行
 150   2          } 
 151   1      
 152   1      }
