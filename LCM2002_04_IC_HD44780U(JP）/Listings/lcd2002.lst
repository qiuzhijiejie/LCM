  24          void  Delay(xms)        //@12.000MHz
  25          {
  26   1      while(xms--){
  27   2              unsigned char data i, j;
  28   2      
  29   2              i = 12;
  30   2              j = 169;
  31   2              do
  32   2              {
  33   3                      while (--j);
  34   3              } while (--i);
  35   2      }
  36   1              }
