 254          // 向 LCD 的 CGRAM 写入自定义字符数据
 255          void Write_CGRAM(unsigned char a[])
 256          {
 257   1          unsigned char k;
 258   1          
 259   1          // 发送命令 0x40，选择 CGRAM 地址
 260   1          LCD_WriteCommand(0x40); 
 261   1          
 262   1          // 将自定义字符数据写入 CGRAM
 263   1          for(k = 0; k < 64; k++)
 264   1          {
 265   2              LCD_WriteData(a[k]);  // 写入字符数据
 266   2          }
 267   1      }
