 269          
 270          void displayCustomCharacter1(const unsigned char pattern[8]) 
 271          {
 272   1          unsigned char row, col;
 273   1      
 274   1          // 将自定义字符数组写入CGRAM
 275   1          Write_CGRAM(pattern);
 276   1      
 277   1          // 遍历LCD的每一行和每一列，显示自定义字符
 278   1          for (row = 0; row < 2; row++) 
 279   1          {
 280   2              for (col = 0; col < 20; col++) 
 281   2              {
 282   3                  // 针对LCD2002的行起始地址做出修正
 283   3                  unsigned char position;
 284   3                  if (row == 0) 
 285   3                                      {
 286   4                      position = 0x80 + col;   // 第1行地址 0x80 起始
 287   4                                      } else //if (row == 1) {
 288   3                      position = 0xC0 + col;   // 第2行地址 0xC0 起始
 289   3      
 290   3                  // 设置光标位置并显示自定义字符
 291   3                  LCD_WriteCommand(position);
 292   3                  LCD_WriteData(0x00);  // 显示存储在CGRAM中的第一个自定义字符
 293   3              }
 294   2          }
 295   1      }
