  39          //判断忙不忙
  40          void Busy()
  41          {
  42   1              unsigned char temp;
  43   1              LCD_DataPort=0xff;
  44   1              LCD_RS=0;//RW=1,RS=0读状态
  45   1              LCD_RW=1;
  46   1              do{
  47   2                      LCD_EN=1;
  48   2                      temp=LCD_DataPort;
  49   2                      LCD_EN=0;
  50   2              }while(temp&0x80);}/*对控制器每次进行读写操作之前， 
  51                                                    都必须进行读写检测，确保STA7为0*/
