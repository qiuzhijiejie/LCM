 104          /**
 105            * @brief  LCD2002初始化函数
 106            * @param  无
 107            * @retval 无
 108            */
 109          void LCD_Init() 
 110          {
 111   1          LCD_WriteCommand(0x38); // 设置20×4显示,5X7点阵,8位数据接口 
 112   1          LCD_WriteCommand(0x0c); // 显示开,光标关,闪烁关
 113   1      //      LCD_WriteCommand(0x0f);//显示开,光标开.闪烁开
 114   1          LCD_WriteCommand(0x06); // 当读或写一个字符后地址指针加一,不移动
