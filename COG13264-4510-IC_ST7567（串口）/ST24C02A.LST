  27          /********** 24C02 读写程序 ************/
  28          /********** Function Definition　函数定义 ************/
  29          
  30          void DELAY2(unsigned int t) /*延时函数*/
  31          {
  32   1      while(t!=0)
  33   1      t--;
  34   1      }
  35          
  36          void I2C_Start(void)
  37          {
  38   1      /*启动I2C总线的函数，当SCL为高电平时使SDA产生一个负跳变*/
  39   1      SDA=1;
  40   1      SCL=1;
  41   1      DELAY2(DELAY_TIME);
  42   1      SDA=0;
  43   1      DELAY2(DELAY_TIME);
  44   1      SCL=0;
  45   1      DELAY2(DELAY_TIME);
  46   1      }
  47          
  48          void I2C_Stop(void)
  49          {
  50   1      /*终止I2C总线，当SCL为高电平时使SDA产生一个正跳变*/
  51   1      SDA=0;
  52   1      SCL=1;
  53   1      DELAY2(DELAY_TIME);
  54   1      SDA=1;
  55   1      DELAY2(DELAY_TIME);
C51 COMPILER V7.50   ST24C02A                                                              08/06/2013 15:41:52 PAGE 2   

  56   1      SCL=0;
  57   1      DELAY2(DELAY_TIME);
  58   1      }
  59          
  60          void SEND_0(void) /* SEND ACK */
  61          {
  62   1      /*发送0，在SCL为高电平时使SDA信号为低*/
  63   1      SDA=0;
  64   1      SCL=1;
  65   1      DELAY2(DELAY_TIME);
  66   1      SCL=0;
  67   1      DELAY2(DELAY_TIME);
  68   1      }
  69          
  70          void SEND_1(void)
  71          {
  72   1      /*发送1，在SCL为高电平时使SDA信号为高*/
  73   1      SDA=1;
  74   1      SCL=1;
  75   1      DELAY2(DELAY_TIME);
  76   1      SCL=0;
  77   1      DELAY2(DELAY_TIME);
  78   1      }
  79          
  80          bit Check_Acknowledge(void)
  81          {
  82   1      /*发送完一个字节后检验设备的应答信号*/
  83   1      SDA=1;
  84   1      SCL=1;
  85   1      DELAY2(DELAY_TIME/2);
  86   1      F0=SDA;
  87   1      DELAY2(DELAY_TIME/2);
  88   1      SCL=0;
  89   1      DELAY2(DELAY_TIME);
  90   1      if(F0==1)
  91   1      return FALSE;
  92   1      return TRUE;
  93   1      }
  94          
  95          void WriteI2CByte(char b)reentrant
  96          {
  97   1      /*向I2C总线写一个字节*/
  98   1      char i;
  99   1      for(i=0;i<8;i++)
 100   1      if((b<<i)&0x80)
 101   1      SEND_1();
 102   1      else
 103   1      SEND_0();
 104   1      }
 105          
 106          
 107          
 108          char ReadI2CByte(void)reentrant
 109          {
 110   1      /*从I2C总线读一个字节*/
 111   1      char b=0,i;
 112   1      for(i=0;i<8;i++)
 113   1      {
 114   2      SDA=1; /*释放总线*/
 115   2      SCL=1; /*接受数据*/
 116   2      DELAY2(DELAY_TIME/2);
 117   2      F0=SDA;
C51 COMPILER V7.50   ST24C02A                                                              08/06/2013 15:41:52 PAGE 3   

 118   2      DELAY2(DELAY_TIME/2);
 119   2      SCL=0;
 120   2      if(F0==1)
 121   2      {
 122   3      b=b<<1;
 123   3      b=b|0x01;
 124   3      }
 125   2      
 126   2      else
 127   2      b=b<<1;
 128   2      
 129   2      }
 130   1      
 131   1      return b;
 132   1      
 133   1      }
