   7          #define DELAY_TIME 60 /*经实验，不要小于50！否则可能造成时序混乱*/
   8          #define TRUE 1
   9          #define FALSE 0
  10          sbit SCL=P2^6;/*假设由P2.7和P2.6控制*/
  11          sbit SDA=P2^7;
