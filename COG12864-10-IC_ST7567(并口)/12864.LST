 134           //------------------显示方框-----------------------
 135          void lcd_kuang(void)
 136          {
 137   1       uchar i,j;
 138   1        for(i=0;i<8;i++)
 139   1         {     
 140   2          for(j=0;j<128;j++)
 141   2               { 
 142   3                if((j==0)||(j==127)) { GotoXY(i,j); write_cmd_dat(1,0xff);}
 143   3                if(i==0)
 144   3                 { 
 145   4                  if((j>0)&&(j<127)) { GotoXY(i,j); write_cmd_dat(1,0x01);}}
 146   3                if(i==7)
 147   3                 { 
 148   4                  if((j>0)&&(j<127)) { GotoXY(i,j); write_cmd_dat(1,0x80);}}
 149   3               }
 150   2         }
 151   1      }
