 211   2                              index = ((*ptrAscii)-0x20)*16; 
 212   2                        
 213   2                              for(i=0;i<16;i++)
 214   2                              {
 215   3                               if(i%8==0)
 216   3                                {
 217   4                                xclum=startC;
 218   4                                }
 219   3                               write_data(AsciiDot0816[index++],startP+i/8,xclum++);                   
 220   3                              }
 221   2                              startC+=8;
 222   2                         ptrAscii++;                            
 223   2                      //      if((128-xclum)<8)
 224   2              //      {
 225   2                      // startP+=2;
 226   2                      //       startC=0;
 227   2                               //if(startP<8)
 228   2                      //       {Gotoxy(startP,startC);}
 229   2                      //      }
 230   2              }
 231   1      }
