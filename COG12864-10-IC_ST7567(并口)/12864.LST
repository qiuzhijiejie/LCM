 202          //------------------显示8X16点阵字符串-------------------------         
 203           void disp_ascii0816(uchar *ptrAscii, uchar startP, uchar startC)
 204                  {
 205   1      
 206   1                      uchar i,xclum;
 207   1                      uint index;
 208   1                      GotoXY(startP,startC);
