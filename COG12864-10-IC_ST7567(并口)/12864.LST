 154          void lcd_nested_frames(void)
 155          {
 156   1          uchar top = 0;
 157   1          uchar bottom = 7;
 158   1          uchar left = 0;
 159   1          uchar right = 127;
 160   1          uchar i, j;
 161   1      
 162   1          while (top <= bottom && left <= right)
 163   1          {
 164   2              // 上边
 165   2              for(j = left; j <= right; j++)
 166   2              {
 167   3                  GotoXY(top, j);
 168   3                  write_cmd_dat(1, 0xFF);
 169   3              }
 170   2      
 171   2              // 下边
 172   2              for(j = left; j <= right; j++)
 173   2              {
 174   3                  GotoXY(bottom, j);
 175   3                  write_cmd_dat(1, 0xFF);
 176   3              }
 177   2      
 178   2              // 左边
 179   2              for(i = top; i <= bottom; i++)
C51 COMPILER V9.60.7.0   12864                                                             08/02/2025 09:48:49 PAGE 4   

 180   2              {
 181   3                  GotoXY(i, left);
 182   3                  write_cmd_dat(1, 0xFF);
 183   3              }
 184   2      
 185   2              // 右边
 186   2              for(i = top; i <= bottom; i++)
 187   2              {
 188   3                  GotoXY(i, right);
 189   3                  write_cmd_dat(1, 0xFF);
 190   3              }
 191   2      
 192   2              // 缩小一圈
 193   2              top++;
 194   2              bottom--;
 195   2              left += 2;
 196   2              right -= 2;
 197   2          }
 198   1      }
