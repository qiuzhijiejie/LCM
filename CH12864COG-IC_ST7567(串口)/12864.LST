 255          void Init_IC()   
 256          {   
 257   1       cs  =  0;   
 258   1       P1  =  0xFF;   
 259   1       LCD_Reset(); 
 260   1       write_cmd_dat(0,0xE2);   //initialize interal function
 261   1       write_cmd_dat(0,0xA2); //LCD Bias selection(1/65 Duty,1/9Bias) 
 262   1       write_cmd_dat(0,0xC8);  //SHL selection(COM64->COM0) //改变COM扫描方向         
 263   1       write_cmd_dat(0,0xA0);  //ADC selection(SEG0->SEG128) //改变SEG扫描方向 
 264   1       write_cmd_dat(0,0x2F);  //power control(VB,VR,VF=1,1,1)
 265   1       write_cmd_dat(0,0x25); //Regulator resistor select 110 内部电位器调节
 266   1       write_cmd_dat(0,0x81); //set reference voltage mode
 267   1       write_cmd_dat(0,0x15); //set reference voltage //改变此值可以改变效果  
 268   1       write_cmd_dat(0,0x60); //Initial Display Line 0x40
 269   1       write_cmd_dat(0,0xAF); //Display on 
 270   1       Clear();
 271   1      }   
