   8          // Delay microsecond less than 255us
   9          void delayUs(uint Tus)
  10          {
  11   1              // If Tus >= 18, the delay is precise, otherwise not!
  12   1              if (Tus > 17)
  13   1              {
  14   2                      Tus = Tus/2 - 9;
  15   2                      if (Tus != 0)
  16   2                              while(--Tus != 0);
  17   2              }
  18   1      }
  19          
  20          // Delay Tms ms
  21          void delayMs(uint Tms)
  22          {
  23   1              uint i;
  24   1              while(Tms-- != 0)
  25   1              {
  26   2                      i = 4;
  27   2                      while(i-- != 0)
  28   2                      delayUs(250);
  29   2              }
  30   1      }
