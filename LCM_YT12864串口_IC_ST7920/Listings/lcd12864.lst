 451   3                  putchar(charCode);  // 显示ASCII字符
 452   3              }
 453   2              else
 454   2              {
 455   3                  // 处理扩展字符（高位和低位字节组合）
 456   3                  putchar(charCode * 256 + *str);
 457   3                  str++;  // 跳过下一个字符（低位字节）
 458   3              }
 459   2          }
 460   1      }
