 518           * 它通过循环逐个字符地在屏幕上显示，直到返回到初始位置（0,0），从而完成整个屏幕的填充。
 519           * @param c 要显示的ASCII字符
 520           */
 521          void charlcdfill(unsigned int c) // 整屏显示指定ASCII字符的子程序
 522          {   
 523   1          for (X = Y = 0; 1;) // 初始化X和Y坐标为0,0，并开始无限循环
 524   1          {   
 525   2              putchar(c); // 调用putchar函数，在当前位置显示字符
 526   2              if ((X == 0) && (Y == 0)) break; // 如果已经返回到屏幕起始位置(0,0)，则退出循环
 527   2          }
 528   1      }
