 427          void DisplayString(unsigned char code *str) 
 428          {
 429   1          unsigned int charCode;
 430   1      
 431   1          while (1) 
 432   1          {
 433   2              charCode = *str;  // 读取当前字符
 434   2              str++;  // 移动到下一个字符
 435   2      
 436   2              if (charCode == 0) break;  // 如果字符码为0，结束字符串显示
 437   2      
 438   2              if (charCode < 128)
 439   2              {
 440   3                  putchar(charCode);  // 显示ASCII字符
 441   3              }
 442   2              else
 443   2              {
 444   3                  // 处理扩展字符（高位和低位字节组合）
 445   3                  putchar(charCode * 256 + *str);
 446   3                  str++;  // 跳过下一个字符（低位字节）
 447   3              }
 448   2          }
 449   1      }
