  82          /**
  83            * @brief  向LCD12864写指令  
  84            * @param  None
  85            * @retval None
  86            */
  87          void Write_Command(unsigned char e)
  88          {
  89   1          CS = 1; //11111 00 0    // 激活片选信号
  90   1          Trans_Byte(0xf8);      // 发送控制字节,进行同步 P26 P10
  91   1          Trans_Byte(e & 0xf0);  // 发送命令的高四位
  92   1          Trans_Byte((e & 0x0f) << 4); // 发送命令的低四位
  93   1          CS = 0;                // 取消片选信号
  94   1      }
