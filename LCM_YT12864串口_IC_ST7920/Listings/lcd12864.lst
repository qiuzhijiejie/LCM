 463          /**
 464           * @brief 显示字符到LCD屏幕上，并处理字符类型和自动对齐
 465           *
 466           * 该函数用于在LCD上显示字符，支持ASCII字符和汉字的显示，并处理字符位置的对齐。
 467           * 对于汉字（字符码大于128），会自动处理两个字节并根据当前光标位置进行对齐；
 468           * 对于ASCII字符（字符码小于128），如果在奇数位置会进行适当的对齐补充。
 469           * 
 470           * @param c 要显示的字符，可能是ASCII字符或汉字字符。
 471           * 
 472           * @note 
 473           * - 汉字字符码大于128，且占两个字节（高字节和低字节）。该函数会自动分段显示。
 474           * - 自定义字符的高字节为0xFF，转换为ST7920控制器的字符码格式。
 475           */
 476          void putchar(unsigned int c) 
 477          {
 478   1          if (c > 128) // 字符码大于128表示为汉字
 479   1          {
 480   2              if ((X & 0x1) == 1) // 如果CXPOS字符位置在奇数位置
 481   2              {
 482   3                  Write_Data(' '); // 自动补添一个空格对齐
 483   3                  moveToNextCharPosition(); // 置字符位置为下一个有效位置
 484   3              }
 485   2              setLcdCursorPosition(); // 设置字符位置
 486   2              if ((c & 0xff00) == 0xff00) // 如果高位字节为0xFF表示自定义字符
 487   2              {
 488   3                  c = 0xffff - c; // 转换为ST7920的字符码
C51 COMPILER V9.60.7.0   LCD12864                                                          07/28/2025 16:09:50 PAGE 9   

 489   3              }
 490   2              Write_Data(c / 256); // 256写高位字符
 491   2              moveToNextCharPosition(); // 置字符位置为下一个有效位置
 492   2              Write_Data(c & 0xff); // 写低位字符
 493   2              moveToNextCharPosition(); // 置字符位置为下一个有效位置
 494   2          }
 495   1          else // 字符码小于128表示为ASCII字符
 496   1          {
 497   2              setLcdCursorPosition(); // 设置字符位置
 498   2              if ((X& 0x1) == 1) // 如果CXPOS字符位置在奇数位置
 499   2              {
 500   3                  Write_Data(FCHARBUF); // 重新写高位字符缓冲区内容
 501   3                  Write_Data(c); // 写当前字符
 502   3              }
 503   2              else // 如果CXPOS字符位置在偶数位置
 504   2              {
 505   3                  Write_Data(c); // 直接写当前字符
 506   3                  FCHARBUF = c; // 保存当前字符到高位字符缓冲变量
 507   3                  Write_Data(' '); // 自动补显一个空格
 508   3              }
 509   2              moveToNextCharPosition(); // 置字符位置为下一个有效位置
 510   2          }
 511   1      }
