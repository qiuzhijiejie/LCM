  61          /**
  62            * @brief  向LCD12864发一字节显示数据/指令  
  63            * @param  d
  64            * @retval None
  65            */
  66          
  67          void Trans_Byte(unsigned char d)
  68          {
  69   1          unsigned char i;
  70   1          for(i = 0; i < 8; i++)//一个字节
  71   1          {
  72   2              if((d & 0x80) == 0x80)//检查数据字节的最高位
  73   2                  Trans_Bit(1);
