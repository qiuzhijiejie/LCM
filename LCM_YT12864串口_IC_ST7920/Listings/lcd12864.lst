 374          //                                    128                  64
 375          void drawImageWithSize(unsigned char width, unsigned char height, unsigned char code *imgeData)
 376          {
 377   1          unsigned char pixelX, pixelY, x;
 378   1           x = XPosition;  // 保存当前X位置
 379   1      
 380   1          // 遍历图像的高度（逐行显示）
 381   1          for (pixelY = 0; pixelY < height; pixelY++, YPosition++)  // 每次遍历一行，GYPOS增加一行
 382   1          {
 383   2              // 遍历图像的宽度
 384   2              for (XPosition = x, pixelX = 0; pixelX < width;)
 385   2              {       if ((XPosition & 0x08) == 0) Set_DrawingPosition();  // 根据位置设置光标
 386   3                  Write_Data(*imgeData);                   // 显示当前字节的图像数据
 387   3                  imgeData++;                         // 移动到下一个字节
