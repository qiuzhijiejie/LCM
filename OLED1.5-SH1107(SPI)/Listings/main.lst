 287          //写入  最后将SDA拉高，以等待从设备产生应答
 288          void IIC_write(unsigned char date)
 289          {
 290   1              unsigned char i, temp;
 291   1              temp = date;
 292   1                              
 293   1              for(i=0; i<8; i++)
 294   1              {       IIC_SCK_0;
 295   2                      
 296   2                      if ((temp&0x80)==0)
 297   2                        IIC_SDA_0;
 298   2                      else IIC_SDA_1;
 299   2                      temp = temp << 1;
 300   2                                                        //最少250ns延时
 301   2                      IIC_SCK_1;
 302   2                      
C51 COMPILER V9.60.7.0   MAIN                                                              08/25/2025 20:47:34 PAGE 6   

 303   2              }
 304   1              IIC_SCK_0;
 305   1              
 306   1              IIC_SDA_1;
 307   1              
 308   1              IIC_SCK_1;
 309   1              
 310   1               ACK =0;
 311   1              IIC_SCK_0;
 312   1              
 313   1      
 314   1      }
 315          //启动信号
 316          //SCL在高电平期间，SDA由高电平向低电平的变化定义为启动信号
 317          void IIC_start()
 318          {
 319   1              IIC_SDA_1;
 320   1              
 321   1              IIC_SCK_1;
 322   1                                                 //所有操作结束释放SCL        
 323   1              IIC_SDA_0;
 324   1              
 325   1              IIC_SCK_0;
 326   1              
 327   1              IIC_write(0x78);
 328   1              
 329   1      }
 330          
 331          //停止信号
 332          //SCL在高电平期间，SDA由低电平向高电平的变化定义为停止信号
 333          void IIC_stop()
 334          {
 335   1              IIC_SDA_0;
 336   1              
 337   1              IIC_SCK_1;
 338   1              
 339   1              IIC_SDA_1;
 340   1              
 341   1      }
