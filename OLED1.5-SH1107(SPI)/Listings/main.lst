 343          void OLED_send_cmd(unsigned char o_command)
 344            {
 345   1          
 346   1          IIC_start();
 347   1          IIC_write(0x00); 
 348   1          IIC_write(o_command);
 349   1          IIC_stop();
 350   1          
 351   1        }
 352          void OLED_send_data(unsigned char o_data)
 353            { 
 354   1          IIC_start();
 355   1          IIC_write(0x40);
 356   1          IIC_write(o_data);
 357   1          IIC_stop();
 358   1         }
