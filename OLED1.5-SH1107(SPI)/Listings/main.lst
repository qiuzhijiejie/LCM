 370          void OLED_clear(void)
 371            {
 372   1          unsigned char page,column;
 373   1          for(page=0;page<OLED_PAGE_NUMBER;page++)             //page loop
 374   1            { 
 375   2                Page_set(page);
 376   2                Column_set(0);          
 377   2                for(column=0;column<OLED_COLUMN_NUMBER;column++)      //column loop
 378   2                  {
 379   3                    OLED_send_data(0x00);
 380   3                  }
 381   2            }
 382   1        }
 383            
 384          void OLED_full(unsigned char oddData, unsigned char evenData)
 385          {
 386   1          unsigned char page, column;
 387   1          for(page = 0; page < OLED_PAGE_NUMBER; page++)   // page loop
 388   1          { 
 389   2              Page_set(page);
 390   2              Column_set(0);    
 391   2              for(column = 0; column < OLED_COLUMN_NUMBER; column++) // column loop
 392   2              {
 393   3                  if(column % 2 == 0)      // 偶数列
 394   3                      OLED_send_data(evenData);
 395   3                  else                     // 奇数列
 396   3                      OLED_send_data(oddData);
 397   3              }
 398   2          }
 399   1      }
