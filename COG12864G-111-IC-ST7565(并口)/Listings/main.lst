 482          void initial_lcd() 
C51 COMPILER V9.60.7.0   MAIN                                                              10/30/2025 14:59:19 PAGE 9   

 483          { 
 484   1      reset=0;                 
 485   1      delay(20); 
 486   1      reset=1;   
 487   1      /*低电平复位*/ 
 488   1      /*复位完毕*/ 
 489   1      delay(20);         
 490   1      transfer_command(0xe2);  /*软复位*/
 491   1              delay(5); 
 492   1      transfer_command(0x2c);  /*升压步聚 1*/ 
 493   1      delay(5);  
 494   1      transfer_command(0x2e);  /*升压步聚 2*/ 
 495   1      delay(5); 
 496   1      transfer_command(0x2f);  /*升压步聚 3*/ 
 497   1      delay(5); 
 498   1      transfer_command(0x23);  /*粗调对比度，可设置范围0x20～0x27*/ 
 499   1      transfer_command(0x81);  /*微调对比度*/ 
 500   1      transfer_command(0x2f);  /*微调对比度的值，可设置范围0x00～0x3f*/ 
 501   1      transfer_command(0xa2);  /*1/9 偏压比（bias）*/ 
 502   1      transfer_command(0xc8);  /*行扫描顺序：从上到下*/ 
 503   1      transfer_command(0xa0);  /*列扫描顺序：从左到右*/ 
 504   1      transfer_command(0x60);  /*起始行：第一行开始*/ 
 505   1      transfer_command(0xaf);  /*开显示*/ 
 506   1      }
