 138          //------------------------------------------
 139          // 封装显示流程的函数
 140          //------------------------------------------
 141          void run_display(bit speedFlag)
 142          {
 143   1          unsigned int delayTime = speedFlag ? 200 : 500;
 144   1      
 145   1          LCD_Init(); 
 146   1          LCD_Clear();
 147   1      
 148   1          displayCustomCharacter1(pattern1); Delay(delayTime);
 149   1          displayCustomCharacter1(pattern2); Delay(delayTime);
 150   1          displayCustomCharacter1(pattern3); Delay(delayTime);
 151   1          displayCustomCharacter1(pattern4); Delay(delayTime);
 152   1          displayCustomCharacter1(pattern5); Delay(delayTime);
 153   1          displayCustomCharacter1(pattern6); Delay(delayTime);
 154   1          displayCustomCharacter1(pattern7); Delay(delayTime);
 155   1      
 156   1          write_CGROM(0x21); Delay(200);
 157   1          write_CGROM(0xA1); Delay(200);
 158   1          Write_DDRAM(0xCE); Delay(200);
 159   1          LCD_Clear();
 160   1          LCD_ShowString(1,3,"LCM1602_10");
 161   1          LCD_ShowString(0,2,"Made in China");
 162   1          Delay(200);
 163   1      }
 164          
 165          bit speedFlag = 0;  // 0=慢速, 1=快速
 166          
 167          void main(void)
 168          {
 169   1          LCD_Init(); 
 170   1          LCD_Clear();
 171   1      
 172   1          // 上电时默认先执行一次慢速显示
 173   1          run_display(speedFlag);
 174   1      
 175   1          while(1)
 176   1          {
 177   2              if (ReadKey1())        // 检测按键按下
 178   2              {
C51 COMPILER V9.60.7.0   MAIN                                                              11/10/2025 11:42:53 PAGE 4   

 179   3                  Delay(20);         // 消抖
 180   3                  if (ReadKey1())    // 确认按下
 181   3                  {
 182   4                      speedFlag = !speedFlag;   // 切换速度档位
 183   4                      while(ReadKey1());        // 等待松手
 184   4                      run_display(speedFlag);   // 按一次键重新显示（速度改变）
 185   4                  }
 186   3              }
 187   2          }
 188   1      }
