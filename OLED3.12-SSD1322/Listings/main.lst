 446          // 按列填充屏幕，根据列号选择不同的数据
 447          // data_odd  : 奇数列填充的数据
 448          // data_even : 偶数列填充的数据
 449          void Screen_fill_param(unsigned char data_odd, unsigned char data_even)
 450          {
 451   1          unsigned char row, column;
 452   1      
 453   1          // 设置列地址
 454   1          Ins_trans(0x15); // Set column address
 455   1          Data_trans(0x1C); // start column
 456   1          Data_trans(0x5B); // end column
 457   1      
 458   1          // 设置行地址
 459   1          Ins_trans(0x75); // Set row address
 460   1          Data_trans(0x00); // start row
 461   1          Data_trans(0x3F); // end row
 462   1      
 463   1          // 写入RAM
 464   1          Ins_trans(0x5C);
 465   1      
 466   1          for(row = 0; row < 64; row++) // 行循环
 467   1          {
 468   2              for(column = 0; column < 128; column++) // 列循环
 469   2              {
 470   3                  if(column % 2 == 0)       // 偶数列
 471   3                      Data_trans(data_even);
 472   3                  else                      // 奇数列
 473   3                      Data_trans(data_odd);
 474   3              }
 475   2          }
 476   1      }
