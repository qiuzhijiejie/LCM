 581          void send_2bit(unsigned char two_bit_data)
 582          {
 583   1              if(two_bit_data==0x00)
 584   1                      Data_trans(0x00);
 585   1              else if(two_bit_data==0x40)
 586   1                      Data_trans(0x0f);
 587   1              else if(two_bit_data==0x80)
 588   1                      Data_trans(0xf0);
 589   1              else
 590   1                      Data_trans(0xff);
 591   1      }
