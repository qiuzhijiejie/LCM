 375   2                      F_WriteInst(0x54);              //PUMP VOLTAGE SET
 376   2                      F_WriteData(constr);    ////VLCD = 2.5 + VSET * 0.05 5.0V
 377   2              }
 378   1                              
 379   1              delay_n_ms(150);
 380   1      }
