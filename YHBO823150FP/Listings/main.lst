 241          
 242          void lcd_inital(void)
 243          {
 244   1          constr = 20;   // 对应 VLCD 电压调整
 245   1          RST = 0;
 246   1          delay_n_ms(30);
 247   1          RST = 1;
 248   1          delay_n_ms(20);
 249   1      
 250   1          // 软件复位
 251   1          F_WriteInst(0x50);
 252   1          delay_n_ms(10);
 253   1      
 254   1          // 设备选择
 255   1          F_WriteInst(0x51);
 256   1          F_WriteData(0x00);
 257   1      
 258   1          // 帧率设置（80Hz）
 259   1          F_WriteInst(0x52);
 260   1          F_WriteData(0x01);
 261   1      
 262   1          // Pump 控制
 263   1          F_WriteInst(0x53);
 264   1          F_WriteData(0x01);  // 内部VLCD启用
 265   1      
 266   1          // Pump电压设置
 267   1          F_WriteInst(0x54);
 268   1          F_WriteData(constr); // 可调亮度（2.5 + VSET*0.05）
 269   1      
 270   1          // 显示模式设置（1/4 Duty, 1/3 Bias 通常更亮）
 271   1          F_WriteInst(0x55);
 272   1          F_WriteData(0x03);  // 尝试改成0x03看看亮不亮
 273   1      
 274   1          delay_n_ms(50);
 275   1      
 276   1          // 地址初始化
 277   1          F_WriteInst(0x56);
 278   1          F_WriteData(0x00);
 279   1      
 280   1          // 打开显示输出
 281   1          F_WriteInst(0x59);
 282   1          F_WriteData(0x01);  // Display ON
 283   1      
 284   1          delay_n_ms(100);
 285   1      
 286   1          // 全显测试（可选，测试所有段是否通）
 287   1          F_WriteInst(0x58);
 288   1          F_WriteData(0x01);
 289   1          delay_n_ms(300);
 290   1          F_WriteData(0x00);  // 关闭全显
 291   1      }
