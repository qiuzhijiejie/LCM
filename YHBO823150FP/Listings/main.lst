 223          ////$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
 224          void display_d(uchar *ptr)
 225          {
 226   1                      uchar i;
 227   1                      F_WriteInst(0x51);      // device
 228   1                      F_WriteData(0x00);
 229   1              
C51 COMPILER V9.60.7.0   MAIN                                                              11/04/2025 20:06:33 PAGE 5   

 230   1                      F_WriteInst(0x56);      // ADDRESS
 231   1                      F_WriteData_R(0x00);// seg 0    
 232   1                              
 233   1                      for(i=0;i<59;i++)
 234   1                      {
 235   2                       F_WriteData_R(*ptr);  
 236   2                        ptr++;        
 237   2                      } 
 238   1            IC_Stop();
 239   1      }
