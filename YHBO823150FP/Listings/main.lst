 346   2              }
 347   1                      
 348   1              //       ? bmp_id--
 349   1              if((tkeyin&SUBD)==0x00)
 350   1              {
 351   2                      dispid=1;               //? ± ?  "1"
 352   2                      if(bmp_id>0) 
 353   2                      {
