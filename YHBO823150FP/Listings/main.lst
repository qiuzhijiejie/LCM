 101          void F_Serial_WR_I2C(char R_Data_CMD)
 102          {       
 103   1              char i;
 104   1              for(i=0;i<8;i++)
 105   1              {               
C51 COMPILER V9.60.7.0   MAIN                                                              11/04/2025 20:06:33 PAGE 3   

 106   2                  SCL=0;
 107   2                      
 108   2                      if(R_Data_CMD&0x80)             
 109   2                              SDA=1;
 110   2                      else
 111   2                              SDA=0;
 112   2                      R_Data_CMD<<=1;
 113   2      
 114   2               nop();
 115   2                 nop();
 116   2                 SCL=1;
 117   2                         nop();
 118   2                         nop();
 119   2                 SCL=0;               
 120   2              }       
 121   1                nop();
 122   1            nop();
 123   1            SCL=0;
 124   1            delay10us();
 125   1            SCL=1;
 126   1            nop();
 127   1            nop();   
 128   1            nop();
 129   1            while(SDA==1);
 130   1                SCL=0;
 131   1      }       
