 206          void display_all_on(void)
 207          {
 208   1          uchar i;
 209   1      
 210   1          F_WriteInst(0x51);      // Device select
 211   1          F_WriteData(0x00);
 212   1      
 213   1          F_WriteInst(0x56);      // Address pointer
 214   1          F_WriteData_R(0x00);    // 从 SEG0 开始
 215   1      
 216   1          for(i = 0; i < 120; i++)   // 全屏段码写满
 217   1          {
 218   2              F_WriteData_R(0xFF);
 219   2          }
 220   1          IC_Stop();
 221   1      }
