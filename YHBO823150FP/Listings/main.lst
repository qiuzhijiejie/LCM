 359   3                      }
 360   2       
 361   2              }
 362   1      
 363   1                              
 364   1              // ???   constr++
 365   1              if((tkeyin&ADUP)==0x00)
 366   1              {
 367   2                      if(constr<63) constr++;
 368   2                      F_WriteInst(0x54);              //PUMP VOLTAGE SET
 369   2                      F_WriteData(constr);    ////VLCD = 2.5 + VSET * 0.05 5.0V
 370   2              }
 371   1              // ???   constr--
