 725          void disp_char(uint x,uint y,uchar dat[])  //Ò»¸ö×Ö·û´óÐ¡£º16bit*8bit
 726          {
 727                  unsigned char j;
 728                  ST7567_WriteComd(0xb0|x);         //PAGE
