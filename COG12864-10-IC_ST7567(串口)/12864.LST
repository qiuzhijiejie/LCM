 137           //------------------显示方框-----------------------
 138          void lcd_kuang(void)
 139          {
 140   1       uchar i,j;
 141   1        for(i=0;i<8;i++) // 外循环：共8页（8个水平带）
 142   1         {     
 143   2          for(j=0;j<128;j++) // 内循环：每页128列
 144   2               { 
 145   3                if((j==0)||(j==127)) { GotoXY(i,j); write_cmd_dat(1,0xff);}//竖线部分
 146   3                if(i==0)
 147   3                 { 
 148   4                  if((j>0)&&(j<127)) { GotoXY(i,j); write_cmd_dat(1,0x01);}}//顶部横线
 149   3                if(i==7)
 150   3                 { 
 151   4                  if((j>0)&&(j<127)) { GotoXY(i,j); write_cmd_dat(1,0x80);}}//底部横线
 152   3               }
 153   2         }
 154   1      }
