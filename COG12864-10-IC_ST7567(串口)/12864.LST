  20          // Delay Tms ms
  21          void delayMs(uint Tms)
  22          {
  23   1              uint i;
  24   1              while(Tms-- != 0)
  25   1              {
  26   2                      i = 4;
  27   2                      while(i-- != 0)
  28   2                      delayUs(250);
  29   2              }
  30   1      }
