 156          void lcd_nested_frames(void)
 157          {
 158   1          uchar top = 0;
 159   1          uchar bottom = 7;
 160   1          uchar left = 0;
 161   1          uchar right = 127;
 162   1          uchar i, j;
 163   1      
 164   1          while (top <= bottom && left <= right)
 165   1          {
 166   2              // 上边
 167   2              for(j = left; j <= right; j++)
 168   2              {
 169   3                  GotoXY(top, j);
 170   3                  write_cmd_dat(1, 0xFF);
 171   3              }
 172   2      
 173   2              // 下边
 174   2              for(j = left; j <= right; j++)
 175   2              {
 176   3                  GotoXY(bottom, j);
 177   3                  write_cmd_dat(1, 0xFF);
 178   3              }
 179   2      
C51 COMPILER V9.60.7.0   12864                                                             11/14/2025 14:31:36 PAGE 4   

 180   2              // 左边
 181   2              for(i = top; i <= bottom; i++)
 182   2              {
 183   3                  GotoXY(i, left);
 184   3                  write_cmd_dat(1, 0xFF);
 185   3              }
 186   2      
 187   2              // 右边
 188   2              for(i = top; i <= bottom; i++)
 189   2              {
 190   3                  GotoXY(i, right);
 191   3                  write_cmd_dat(1, 0xFF);
 192   3              }
 193   2      
 194   2              // 缩小一圈
 195   2              top++;
 196   2              bottom--;
 197   2              left += 2;
 198   2              right -= 2;
 199   2          }
 200   1      }
