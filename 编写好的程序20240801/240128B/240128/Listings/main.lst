 740          //-------------------------------------------------------------------------------
 741          //子程序名称:unsigned char lcdrdata(void).
 742          //功能:从液晶显示控制器中读数据.
 743          //修改日期:2009.08.07
 744          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 745          //-------------------------------------------------------------------------------
 746          unsigned char lcdrdata(void)            //读数据子程序
 747          {   unsigned char d;
 748   1          lcdwaitidle();                      //检测液晶显示控制器是否空闲
 749   1          P1=0xff;
 750   1          CDPIN=0;                            //CD=0 CE=0 RD=0
 751   1          CEPIN=0;
 752   1          RDPIN=0;
 753   1          _nop_();
 754   1          d=P1;
 755   1          RDPIN=1;
 756   1          CEPIN=1;
 757   1          return d;
 758   1      }
 759          //-------------------------------------------------------------------------------
 760          //子程序名称:void lcdwdata(unsigned char d).
 761          //功能:向液晶显示控制器送数据.
 762          //修改日期:2009.08.07
 763          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 764          //-------------------------------------------------------------------------------
 765          void lcdwdata(unsigned char d)          //送数据子程序
 766          {   lcdwaitidle();                      //检测液晶显示控制器是否空闲
 767   1          P1=d;
 768   1          CDPIN=0;                            //CD=0 CE=0 WR=0
 769   1          CEPIN=0;
 770   1          WRPIN=0;
 771   1          _nop_();
 772   1          WRPIN=1;
 773   1          CEPIN=1;
 774   1      }
 775          //-------------------------------------------------------------------------------
 776          //子程序名称:voidlcdwaitidle(void).
 777          //功能:忙检测,在对液晶显示控制器操作的每一条指令之前,需检测液晶显示器是否空闲.
 778          //修改日期:2009.08.07
 779          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 780          //-------------------------------------------------------------------------------
 781          void lcdwaitidle(void)                  //忙检测子程序
 782          {   unsigned char i,d;
 783   1          P1=0xff;
 784   1          CDPIN=1;                            //CD=1 CE=0 RD=0
 785   1          CEPIN=0;
 786   1          for(i=0;i<20;i++)                   //
 787   1          {   RDPIN=0;
 788   2              _nop_();
 789   2              d=P1;
 790   2              RDPIN=1;
 791   2              if( (d&0x3) == 0x3 ) break;     //D0D1=11 空闲退出
 792   2          }
 793   1          CEPIN=1;
 794   1      }


