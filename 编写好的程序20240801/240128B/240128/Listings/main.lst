 427   1          while(1)
 428   1          {   if(max-min<2)
 429   2              {   if(ChineseCode[min]==ac)
 430   3                      mid=min;
 431   3                  else if(ChineseCode[max]==ac)
 432   3                      mid=max;
 433   3                  else
 434   3                      mid=0;
 435   3                  break;
 436   3              }
 437   2              mid=(max+min)/2;
