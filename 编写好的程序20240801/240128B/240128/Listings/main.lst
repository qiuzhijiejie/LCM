 396          //-------------------------------------------------------------------------------
 397          void putstr(unsigned char code *s)      //显示字符串子程序,字符码为0时退出
 398          {   unsigned int c;
 399   1          while(1)
 400   1          {   c=*s;
 401   2              s++;
 402   2              if(c==0) break;
 403   2              if(c<128)
 404   2                  putchar(c);
 405   2              else
 406   2              {   putchar(c*256+*s);
 407   3                  s++;
 408   3              }
 409   2          }
 410   1      }
 411          //-------------------------------------------------------------------------------
 412          //子程序名称:unsigned char code *getchinesecodepos(unsigned char ac).
 413          //功能:根据当前中文字符码查表后计算得到当前中文字符码的字库点阵位置.
 414          //修改日期:2009.8.18
 415          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 416          //-------------------------------------------------------------------------------
 417          unsigned char code *getchinesecodepos(unsigned int ac)
 418          {   unsigned int min,max,mid,midc;
 419   1          min=0;
 420   1          max=CHINESECHARNUMBER-1;
 421   1          while(1)
 422   1          {   if(max-min<2)
 423   2              {   if(ChineseCode[min]==ac)
 424   3                      mid=min;
 425   3                  else if(ChineseCode[max]==ac)
 426   3                      mid=max;
C51 COMPILER V9.60.7.0   MAIN                                                              06/16/2025 17:45:05 PAGE 8   

 427   3                  else
 428   3                      mid=0;
 429   3                  break;
 430   3              }
 431   2              mid=(max+min)/2;
 432   2              midc=ChineseCode[mid];
 433   2              if(midc==ac)
 434   2                  break;
 435   2              else if(midc>ac)
 436   2                  max=mid-1;
 437   2              else
 438   2                  min=mid+1;
 439   2          }
 440   1          return ChineseCharDot+mid*CHINESECHARDOTSIZE;
 441   1      }
