 746          //-------------------------------------------------------------------------------
 747          //子程序名称:unsigned char lcdrdata(void).
 748          //功能:从液晶显示控制器中读数据.
 749          //修改日期:2009.08.07
 750          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 751          //-------------------------------------------------------------------------------
 752          unsigned char lcdrdata(void)            //读数据子程序
 753          {   unsigned char d;
 754   1          lcdwaitidle();                      //检测液晶显示控制器是否空闲
 755   1          P1=0xff;
 756   1          CDPIN=0;                            //CD=0 CE=0 RD=0
 757   1          CEPIN=0;
 758   1          RDPIN=0;
 759   1          _nop_();
 760   1          d=P1;
 761   1          RDPIN=1;
 762   1          CEPIN=1;
 763   1          return d;
 764   1      }
 765          //-------------------------------------------------------------------------------
 766          //子程序名称:void lcdwdata(unsigned char d).
 767          //功能:向液晶显示控制器送数据.
 768          //修改日期:2009.08.07
 769          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 770          //-------------------------------------------------------------------------------
 771          void lcdwdata(unsigned char d)          //送数据子程序
 772          {   lcdwaitidle();                      //检测液晶显示控制器是否空闲
 773   1          P1=d;
 774   1          CDPIN=0;                            //CD=0 CE=0 WR=0
 775   1          CEPIN=0;
 776   1          WRPIN=0;
 777   1          _nop_();
 778   1          WRPIN=1;
 779   1          CEPIN=1;
 780   1      }
 781          //-------------------------------------------------------------------------------
 782          //子程序名称:voidlcdwaitidle(void).
 783          //功能:忙检测,在对液晶显示控制器操作的每一条指令之前,需检测液晶显示器是否空闲.
 784          //修改日期:2009.08.07
 785          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 786          //-------------------------------------------------------------------------------
 787          void lcdwaitidle(void)                  //忙检测子程序
 788          {   unsigned char i,d;
 789   1          P1=0xff;
 790   1          CDPIN=1;                            //CD=1 CE=0 RD=0
 791   1          CEPIN=0;
 792   1          for(i=0;i<20;i++)                   //
 793   1          {   RDPIN=0;
 794   2              _nop_();
 795   2              d=P1;
 796   2              RDPIN=1;
 797   2              if( (d&0x3) == 0x3 ) break;     //D0D1=11 空闲退出
 798   2          }
