   1          //SMG240128A标准图形点阵型液晶显示模块的扩展演示程序[C51编程语言][MCS51模拟口线方式]
   2          //应用产品: SMG240128A标准图形点阵型液晶显示模块
   3          //  本演示程序适用于SMG240128A液晶显示模块与MCS51系列单片机采用MCS51模拟口线的
   4          //硬件连线方式。
   5          //  本演示程序包括T6963C兼容芯片的MCS51模拟口线方式子程序集,T6963C兼容芯片的240128
   6          //液晶显示模块的基本子程序,240128系列绘图子程序集,240128系列图形子程序集,240128系
   7          //列精简中英文字库子程序集,以及SMG240128系列标准图形点阵型液晶显示的扩展演示子程序.
   8          //  本演示的内容为,在240列X128行的点阵液晶显示屏上清屏,图片演示,英文字符串演示,中文
   9          //字符串演示,反白显示字符串,绘制矩形,写点,绘制直线,全屏显示.
  10          //-------------------------------------------------------------------------------
  11          //创建日期: 2009.08.17
  12          //软件环境: VW For Windows
  13          //硬件环境: AT89C52 MCU,MCS-51系列 MCU,etc.
  14          //创建人: 褚建军(chujianjun@sunman.cn),谭超(tanchao@sunman.cn).
  15          //技术支持: 电话(0731-84167806,84167807),传真(0731-84167807),网址(www.sunman.cn)
  16          //版权信息: 长沙太阳人电子有限公司版权所有,转载请指明出处.
  17          //参考网页: http:/www.sunman.cn/lcm/product/SMG240128A.html
  18          //-------------------------------------------------------------------------------
  19          #include <reg51.h>
  20          #include <intrins.h>
  21          //以下为演示程序的函数定义
  22          void exsample(void);                    //演示程序
  23          void exdelay(void);                     //演示延时子程序
  24          void putchar(unsigned int c);           //定位写字符子程序
  25          void putstr(unsigned char code *s);     //显示字符串子程序,字符码为0时退出
  26          unsigned char code *getchinesecodepos(unsigned int ac);
  27          unsigned char code *getenglishcodepos(unsigned char ac);
  28          void putimage(unsigned char code *s);   //显示图形子程序
  29          void putsizeimage(unsigned char XSIZE,unsigned char YSIZE,unsigned char code *s);
  30                                                  //显示指定大小的图形子程序
  31          void point(bit b);
  32          void line(unsigned char x0,unsigned char y0,unsigned char x1,unsigned char y1,bit b);
  33          void lineto(unsigned char x1,unsigned char y1,bit b);//绘制(XPOS,YPOS)-(X1,Y1)的直线
  34          void rect(unsigned char x0,unsigned char y0,unsigned char x1,unsigned char y1,bit b);
  35          void lcdfill(unsigned char d);          //整屏显示d代表的字节数据子程序
  36          void lcdpos(void);                      //设置坐标点(XPOS,YPOS)内部RAM地址的子程序
  37          void lcdreset(void);                    //液晶显示控制器初始化子程序
  38          void lcdwd(unsigned char d);            //送图形数据子程序
  39          unsigned char lcdrd(void);              //读图形数据子程序
  40          void lcdwc(unsigned char c);            //送指令子程序
  41          void lcdwc2(unsigned char c,unsigned char d);//送2字节指令子程序
  42          void lcdwc3(unsigned char c,unsigned char d1,unsigned char d2);//送3字节指令子程序
  43          unsigned char lcdrdata(void);           //读数据子程序
  44          void lcdwdata(unsigned char d);         //送数据子程序
  45          void lcdwaitidle(void);                 //忙检测子程序
  46          //-------------------------------------------------------------------------------
  47          //SMG240128A产品引脚说明及演示连线
  48          //PIN1: FG   [构造地]-------------------VSS
  49          //PIN2: VSS  [电源地]-------------------VSS
  50          //PIN3: VDD  [电源正极]-----------------VDD(+5V)
  51          //PIN4: Vo   [LCD 偏压输入]-------------接10K的可调电阻2K电阻到VSS及VEE
  52          //                                      Vo=VEE时为显示最深
  53          //PIN5: WR   [写信号 低有效]------------P3.1
  54          //PIN6: RD   [读信号 低有效]------------P3.2
