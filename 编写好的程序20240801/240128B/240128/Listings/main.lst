 450   1          min=0;
 451   1          max=ENGLISHCHARNUMBER-1;
 452   1          while(1)
 453   1          {   if(max-min<2)
 454   2              {   if(EnglishCode[min]==ac)
 455   3                      mid=min;
 456   3                  else if(EnglishCode[max]==ac)
 457   3                      mid=max;
 458   3                  else
 459   3                      mid=0;
 460   3                  break;
 461   3              }
 462   2              mid=(max+min)/2;
 463   2              midc=EnglishCode[mid];
 464   2              if(midc==ac)
 465   2                  break;
 466   2              else if(midc>ac)
 467   2                  max=mid-1;
 468   2              else
 469   2                  min=mid+1;
 470   2          }
 471   1          return EnglishCharDot+mid*ENGLISHCHARDOTSIZE;
 472   1      }
