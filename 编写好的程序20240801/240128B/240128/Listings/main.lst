 402          //-------------------------------------------------------------------------------
 403          void putstr(unsigned char code *s)      //显示字符串子程序,字符码为0时退出
 404          {   unsigned int c;
 405   1          while(1)
 406   1          {   c=*s;
 407   2              s++;
 408   2              if(c==0) break;
 409   2              if(c<128)
 410   2                  putchar(c);
 411   2              else
 412   2              {   putchar(c*256+*s);
 413   3                  s++;
 414   3              }
 415   2          }
 416   1      }
