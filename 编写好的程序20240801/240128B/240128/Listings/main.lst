 391          void putchar(unsigned int c)            //定位写字符子程序
 392          {   if(c>128)
 393   1              putsizeimage(CHINESECHARSIZE,CHINESECHARSIZE,getchinesecodepos(c));
 394   1          else
 395   1              putsizeimage(ENGLISHCHARSIZE,CHINESECHARSIZE,getenglishcodepos(c));
 396   1      }
