  75          //=============transfer command to LCM===============串口
  76          
  77          void transfer_command(int data1)
  78          
  79          {
  80   1      char i;
  81   1      cs1=0;
  82   1      rs=0;
  83   1      for(i=0;i<8;i++)
  84   1      {
  85   2      lcd_sclk=0;
  86   2      //delay_us(10); //加少量延时
  87   2      if(data1&0x80) lcd_sid=1;
  88   2      else lcd_sid=0;
  89   2      lcd_sclk=1;
  90   2      //delay_us(10); //加少量延时
  91   2      data1=data1<<=1;
  92   2      }
  93   1      cs1=1;
  94   1      }
