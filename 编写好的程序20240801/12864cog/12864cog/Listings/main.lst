 185          void lcd_address(uchar page,uchar column)
 186          {
 187   1      
 188   1      cs1=0;
 189   1      column=column; //
 190   1      page=page-1;
 191   1      transfer_command(0xb0+page); 
 192   1      transfer_command(((column>>4)&0x0f)+0x10); //设置列地址的高4 位
 193   1      transfer_command(column&0x0f); //设置列地址的低4 位
 194   1      }
