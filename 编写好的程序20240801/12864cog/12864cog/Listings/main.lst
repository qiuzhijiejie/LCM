 157          /*LCD 模块初始化*/
 158          void initial_lcd()
 159          {
 160   1      cs1=0;
 161   1      reset=0; /*低电平复位*/
 162   1      delay(20);
 163   1      reset=1; /*复位完毕*/
 164   1      delay(20);
 165   1      transfer_command(0xe2); /*软复位*/
 166   1      delay(50);
 167   1      transfer_command(0x2c); /*升压步聚1*/
 168   1      delay(50);
 169   1      transfer_command(0x2e); /*升压步聚2*/
 170   1      delay(50);
 171   1      transfer_command(0x2f); /*升压步聚3*/
 172   1      delay(50);
 173   1      transfer_command(0x24); /*粗调对比度，可设置范围0x20～0x27*/
 174   1      transfer_command(0x81); /*微调对比度*/
 175   1      transfer_command(0x20); /*0x1a,微调对比度的值，可设置范围0x00～0x3f 1f*/
 176   1      transfer_command(0xa2); /*1/9 偏压比（bias）*/
 177   1      transfer_command(0xc8); /*行扫描顺序：从上到下*/
 178   1      transfer_command(0xa0); /*列扫描顺序：从左到右*/
