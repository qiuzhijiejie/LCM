 196          void Picture_display(unsigned char *ptr_pic)
 197          {
 198   1              unsigned char page,column;
 199   1              for(page=0;page<8;page++)        //page loop
 200   1              {
 201   2                      Page_set(page);
 202   2                      Column_set(0);
