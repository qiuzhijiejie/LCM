 282          //-------------------------------------------------------------------------------
 283          //字符操作区域
 284          //16032ZK字符区域定义为:
 285          //   CXPOS(0-19) 对应于第1列到第19列位置,每个字符列位置实际占位8点,总计对应160点
 286          //   CYPOS(0-1)对应于第1行到第2行,每个行位置实际占位16点,总计对应32点
 287          //警告:直接设置CXPOS的位置时,请将CXPOS的值设置为偶数,否则显示的字符值会不正确.
 288          //-------------------------------------------------------------------------------
 289          //以下为charlcdfill,putchar,putstr,setcharcgram为ST7920兼容芯片的液晶显示控制器
 290          //的通用子程序,putstrxy为扩充子程序.
 291          //-------------------------------------------------------------------------------
 292          //子程序名称:void charlcdfill(unsigned int c).
 293          //功能:整屏显示A代表的ASCII字符.
 294          //修改日期:2009.10.29
 295          //修改人:xiejianren
 296          //-------------------------------------------------------------------------------
 297          void charlcdfill(unsigned int c)        //整屏显示A代表的ASCII字符子程序
 298          {   for(CXPOS=CYPOS=0;1;)
 299   1          {   putchar(c);                     //定位写字符
 300   2              if((CXPOS==0) && (CYPOS==0)) break;
 301   2          }
 302   1      }
C51 COMPILER V9.60.7.0   MAIN                                                              06/18/2025 10:51:24 PAGE 6   

 303          //-------------------------------------------------------------------------------
 304          //子程序名称:void putchar(unsigned int c).
 305          //功能:在(XPOS,YPOS)位置写单个字符点阵,若c>128 表示为中文字符,否则为西文字符
 306          //修改日期:2009.8.18
 307          //修改人:xiejianren
 308          //-------------------------------------------------------------------------------
 309          void putchar(unsigned int c)            //定位写字符子程序
 310          {   unsigned char d;
 311   1          if(c>128)                           //字符码大于128表示为汉字
 312   1          {   if( (CXPOS&0x1)==1 )            //写汉字时,CXPOS字符位置在奇数位置,则
 313   2              {   lcdwd(' ');                 //自动补添一个空格对齐后再显示汉字
 314   3                  charcursornext();           //置字符位置为下一个有效位置
 315   3              }
 316   2              charlcdpos();
 317   2              if((c&0xff00)==0xff00)          //若高位字节为0FFH则表示为自定义字符
 318   2                  c=0xffff-c;                 //则转换为ST7920的字符码
 319   2              lcdwd(c/256);                   //写高位字符
 320   2              charcursornext();
 321   2              lcdwd(c&0xff);                  //写低位字符
 322   2              charcursornext();
 323   2          }
 324   1          else                                //字符码小于128表示为ASCII字符
 325   1          {   charlcdpos();
 326   2              if( (CXPOS&0x1)==1 )            //写ASCII字符时,CXPOS字符位置在奇数位置,则
 327   2              {   d=lcdrd();                  //读高位字符
 328   3                  charlcdpos();
 329   3                  lcdwd(d);                   //重新写高位字符
 330   3                  lcdwd(c);
 331   3              }
 332   2              else
 333   2              {   lcdwd(c);                   //写ASCII字符时,CXPOS字符位置在偶数位置,则
 334   3                  lcdwd(' ');                 //直接写入,同时自动补显一个空格.
 335   3              }
 336   2              charcursornext();               //置字符位置为下一个有效位置
 337   2          }
 338   1      }
 339          //-------------------------------------------------------------------------------
 340          //子程序名称:void putstr(unsigned char code *s).
 341          //功能:写字符串点阵,若*s=0 表示字符串结束.
 342          //修改日期:2009.8.18
 343          //修改人:xiejianren
 344          //-------------------------------------------------------------------------------
 345          void putstr(unsigned char code *s)      //显示字符串子程序,字符码为0时退出
 346          {   unsigned int c;
 347   1          while(1)
 348   1          {   c=*s;
 349   2              s++;
 350   2              if(c==0) break;
 351   2              if(c<128)
 352   2                  putchar(c);
 353   2              else
 354   2              {   putchar(c*256+*s);
 355   3                  s++;
 356   3              }
 357   2          }
 358   1      }
 359          //-------------------------------------------------------------------------------
 360          //子程序名称:void putstrxy(unsigned char cx,unsigned char cy,unsigned char *s).
 361          //功能:在(cx,cy)字符位置写字符串.
 362          //修改日期:2009.08.11
 363          //修改人:xiejianren
 364          //-------------------------------------------------------------------------------
C51 COMPILER V9.60.7.0   MAIN                                                              06/18/2025 10:51:24 PAGE 7   

 365          void putstrxy(unsigned char cx,unsigned char cy,unsigned char code *s)
 366          {                                       //在(cx,cy)字符位置写字符串子程序
 367   1          CXPOS=cx;                           //置当前X位置为cx
 368   1          CYPOS=cy;                           //置当前Y位置为cy
 369   1          putstr(s);
 370   1      }
 371          //-------------------------------------------------------------------------------
 372          //子程序名称:void setcharcgram(unsigned char cindex,unsigned char code *s).
 373          //功能:将*s所指32字节点阵写到自定义字符cindex(0-3)中.
 374          //修改日期:2009.10.29
 375          //修改人:xiejianren
 376          //-------------------------------------------------------------------------------
 377          void setcharcgram(unsigned char cindex,unsigned char code *s)
 378          {   unsigned char i;
 379   1          lcdwc(0x34);                        //扩充指令集,图形模式关闭
 380   1          lcdwc(0x02);                        //SR=0 激活CGRAM
 381   1          lcdwc(0x30);                        //恢复为基本指令集
