 552          //-------------------------------------------------------------------------------
 553          //以下lcdwc,lcdwd为ST7920兼容芯片的MCS51三线式串行接口方式的基本子程序,lcdwaitidle
 554          //为内部子程序.
 555          //-------------------------------------------------------------------------------
 556          //子程序名称:unsigned char lcdrd(void).
 557          //功能:从液晶显示控制器读数据.
 558          //修改日期:2009.10.29
 559          //修改人:XIEJIANREN
 560          //-------------------------------------------------------------------------------
 561          unsigned char lcdrd(void)               //从液晶显示控制器读数据
 562          {   unsigned char d;
 563   1          lcdwaitidle();                      //ST7920液晶显示控制器忙检测
 564   1          RSPIN=1;                            //RS=1 RW=1 E=高脉冲
 565   1          RWPIN=1;
 566   1          EPIN=1;
 567   1          _nop_();
 568   1          d=P1;
 569   1          EPIN=0;
 570   1          return d;
 571   1      }
 572          //-------------------------------------------------------------------------------
 573          //子程序名称:void lcdwd(unsigned char d).
