 462          //修改人:XIEJIANREN
 463          //-------------------------------------------------------------------------------
 464          void lcdreset(void)                     //液晶显示控制器初始化子程序
 465          {   lcdwc(0x33);                        //接口模式设置
 466   1          delay3ms();                         //延时3MS
 467   1          lcdwc(0x30);                        //基本指令集
 468   1          delay3ms();                         //延时3MS
 469   1          lcdwc(0x30);                        //重复送基本指令集
 470   1          delay3ms();                         //延时3MS
 471   1          lcdwc(0x01);                        //清屏控制字
 472   1          delay3ms();                         //延时3MS
 473   1          lcdwc(0x06);                        //显示光标移动设置
 474   1          lcdon();                            //开显示
 475   1      }
 476          void delay3ms(void)                     //延时3MS子程序
 477          { unsigned char i,j,k;
 478   1        for(i=0;i<3;i++)
 479   1          for(j=0;j<64;j++)
 480   1            for(k=0;k<51;k++);
 481   1      }
