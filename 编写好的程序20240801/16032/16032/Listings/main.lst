 395          //-------------------------------------------------------------------------------
 396          void putsizeimage(unsigned char XSIZE,unsigned char YSIZE,unsigned char code *s)
 397          {  unsigned char lx,ly,x;
 398   1         x=GXPOS;
 399   1         for(ly=0;ly<YSIZE;ly++,GYPOS++)
 400   1         {  for(GXPOS=x,lx=0;lx<XSIZE;)
 401   2            {  if((GXPOS&0x08)==0) glcdpos();
 402   3               lcdwd(*s);
 403   3               s++;
 404   3               lx+=8;
 405   3               GXPOS+=8;
 406   3            }
 407   2         }
 408   1         GXPOS=x;
 409   1      }
