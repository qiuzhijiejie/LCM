 427          //-------------------------------------------------------------------------------
 428          //子程序名称:void charlcdpos(void).
 429          //功能:设置坐标点(CXPOS,CYPOS)位置对应的内部RAM地址.
 430          //修改日期:2009.11.02
 431          //修改人:XIEJIANREN
 432          //-------------------------------------------------------------------------------
 433          void charlcdpos(void)                   //设置坐标点(CXPOS,CYPOS)内部RAM地址的子程序
 434          {   unsigned char ddaddr;
 435   1          if(CXPOS>19) CXPOS=0;               //字符位置CXPOS的有效范围为(0到19)
 436   1          CYPOS&=0X1;                         //字符位置CYPOS的有效范围为(0到1)
 437   1          ddaddr=CXPOS/2;
 438   1          if(CYPOS==0)                        //(第一行)X: 第0----19个字符
 439   1              lcdwc(ddaddr|0x80);             //    DDRAM:  80----89H
 440   1          else                                //(第二行)X: 第0----19个字符
 441   1              lcdwc(ddaddr|0x90);             //    DDRAM:  90----99H
 442   1      }
 443          //-------------------------------------------------------------------------------
 444          //子程序名称:void charcursornext(void).
 445          //功能:置字符位置为下一个有效位置.
 446          //修改日期:2009.11.02
 447          //修改人:XIEJIANREN
 448          //-------------------------------------------------------------------------------
 449          void charcursornext(void)               //置字符位置为下一个有效位置子程序
 450          {
 451   1          CXPOS++;                            //字符位置加1
 452   1          if(CXPOS>19) CXPOS=0;               //字符位置CXPOS的有效范围为(0到19)
 453   1          if(CXPOS==0)                        //字符位置CXPOS=0表示要换行
 454   1          {   CYPOS++;                        //行位置加1
 455   2              CYPOS&=0X1;                     //字符位置CYPOS的有效范围为(0到1)
 456   2          }
 457   1      }
 458          //-------------------------------------------------------------------------------
 459          //子程序名称:void lcdreset(void)
