 610   1          P1=0xff;
 611   1          RSPIN=0;
 612   1          RWPIN=1;
C51 COMPILER V9.60.7.0   MAIN                                                              06/18/2025 10:51:24 PAGE 11  

 613   1          EPIN=1;
 614   1          for(i=0;i<20;i++)                   //
 615   1              if( (P1&0x80) != 0x80 ) break;  //D7=0 空闲退出
 616   1          EPIN=0;
 617   1      }


