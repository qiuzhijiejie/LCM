1111          void Locatexy(void)   
1112          {   
1113   1       unsigned char x,y;   
1114   1       switch (Col&0xc0) /*  col.and.0xC0 */   
1115   1       {    
1116   2        case 0: {BusyL();break;}  
1117   2        case 0x40: {BusyM();break;}  
1118   2        case 0x80: {BusyR();break;} 
1119   2       }   
1120   1       x = Col&0x3F|0x40; /* col.and.0x3f.or.Set X Address*/   
1121   1       y = Page&0x07|0xB8; /* row.and.0x07.or.set Page */   
1122   1         
1123   1       RS = 0;      
1124   1       RW = 0;      
1125   1       P1 = y;  
1126   1       E  = 1;   
1127   1       _nop_();   
1128   1       E  = 0;   
1129   1       _nop_();   
1130   1       
1131   1       RS = 0;   
1132   1       RW = 0;   
1133   1       P1 = x;      
1134   1       E  = 1;   
1135   1       _nop_();   
1136   1       E  = 0;   
1137   1       _nop_(); 
1138   1       
1139   1      
1140   1      }   
