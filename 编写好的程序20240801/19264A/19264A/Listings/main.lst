 263          void main(void)
 264          {   while(1)
 265   1          {   lcdreset();                     //初始化液晶显示控制器
 266   2              exsample();                     //演示程序
 267   2          }
 268   1      }
 269          void exsample(void)                     //演示程序
 270          {
 271   1      //0.演示前的准备,将LCD液晶显示全部清空
 272   1          CharImageReverse=0;                 //反显关闭
 273   1          lcdfill(0);                         //清屏
 274   1      
 275   1      //1.图片测试: 在(5,1)位置显示32点阵Oriental图标
 276   1          XPOS=5;
 277   1          YPOS=1;
 278   1          putimage(Img_sunman_32);            //写数据到当前LCDRAM地址中
 279   1          exdelay();                          //延时约600mS
 280   1      
 281   1      //2.字符串测试: 在(60,0)位置显示"LCM19264A"字符串.
 282   1          XPOS=60;
 283   1          YPOS=0;
 284   1          putstr("LCM19264A");
 285   1          exdelay();                          //延时约600mS
 286   1      
 287   1      //3.字符串测试: 在(36,16)位置显示"ShenZhen Oriental"字符串.
 288   1          XPOS=36;
 289   1          YPOS=16;
 290   1          putstr("ShenZhen Oriental");
 291   1          exdelay();                          //延时约600mS
 292   1      
 293   1      //4.字符串测试: 在(16,32)位置显示"WWW.ORIENTAL-LCD.COM"字符串.
 294   1          XPOS=16;
 295   1          YPOS=32;
 296   1          putstr("WWW.ORIENTAL-LCD.COM");
