1079   1       RW = 1; 
1080   1      
1081   1       P1 = 0xFF;  
1082   1      while ((flag&0x80)==0x80)
1083   1       {
1084   2       E=1;
1085   2       _nop_();
1086   2       flag=P1;
1087   2       E=0;
1088   2       }  
1089   1      }   
1090             
