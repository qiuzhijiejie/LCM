1055          void BusyL(void)   
1056          {unsigned char flag=0xff;  
1057   1       CS1= 0;   
1058   1       CS2= 1;   
1059   1       CS3= 1;   
1060   1       RS = 0;   
1061   1       RW = 1;  
1062   1      
1063   1       P1 = 0xFF; 
1064   1      while ((flag&0x80)==0x80)
1065   1       {
1066   2       E=1;
1067   2       _nop_();
1068   2       flag=P1;
1069   2       E=0;
1070   2       }    
1071   1      }   
