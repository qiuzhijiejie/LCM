 377          //功能:根据当前中文字符码查表后计算得到当前中文字符码的字库点阵位置.
 378          //修改日期:2009.8.18
 379          //修改人:谢建仁
 380          //-------------------------------------------------------------------------------
 381          unsigned char code *getchinesecodepos(unsigned int ac)
 382          {   unsigned int min,max,mid,midc;
 383   1          min=0;
 384   1          max=CHINESECHARNUMBER-1;
 385   1          while(1)
 386   1          {   if(max-min<2)
 387   2              {   if(ChineseCode[min]==ac)
 388   3                      mid=min;
 389   3                  else if(ChineseCode[max]==ac)
 390   3                      mid=max;
 391   3                  else
 392   3                      mid=0;
 393   3                  break;
 394   3              }
 395   2              mid=(max+min)/2;
 396   2              midc=ChineseCode[mid];
 397   2              if(midc==ac)
 398   2                  break;
 399   2              else if(midc>ac)
 400   2                  max=mid-1;
 401   2              else
 402   2                  min=mid+1;
 403   2          }
 404   1          return ChineseCharDot+mid*CHINESECHARDOTSIZE;
 405   1      }
