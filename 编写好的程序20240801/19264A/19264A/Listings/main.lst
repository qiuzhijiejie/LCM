1300          void Display_8_8(unsigned char C[],unsigned char i)
1301          { unsigned char k,num=0;
1302   1       num=i*0x08;
1303   1       for(k=0;k<0x08;k++)
1304   1       {
1305   2        WriteData(C[num+k]);
1306   2        Col+=0x01;
1307   2       } 
1308   1      
1309   1      }
1310          
1311          
1312          void Display_16_16(unsigned char F[],unsigned char i)
1313          {
1314   1       unsigned char k=0;
1315   1       unsigned int   num=0;
1316   1       num=i*0x20;
1317   1      
1318   1       for(k=0;k<0x10;k++)
1319   1       {
1320   2        WriteData(F[num+k]);
1321   2        Col+=0x01;
1322   2       } 
1323   1        Col-=0x10;
1324   1        Page+=0x01;   
1325   1        for(k=16;k<0x20;k++)
1326   1       {
1327   2        WriteData(F[num+k]);
1328   2        Col+=0x01;
1329   2       } 
1330   1        Page-=0x01; 
1331   1        Delay(80); 
1332   1      }
