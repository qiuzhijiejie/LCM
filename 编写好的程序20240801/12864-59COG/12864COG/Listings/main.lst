 444          void ShowNum(unsigned char x,unsigned char y,unsigned int num,unsigned char len,unsigned char size2)
 445          {               
 446   1              unsigned char t,temp;
 447   1              unsigned char enshow=0;                                            
 448   1              for(t=0;t<len;t++)
 449   1              {
 450   2                      temp=(num/pow(10,len-t-1))%10;
 451   2                      if(enshow==0&&t<(len-1))
 452   2                      {
 453   3                              if(temp==0)
 454   3                              {
 455   4                                      ShowChar(x+(size2/2)*t,y,' ');
 456   4                                      continue;
 457   4                              }else enshow=1; 
 458   3                               
 459   3                      }
 460   2                      ShowChar(x+(size2/2)*t,y,temp+'0'); 
 461   2              }
 462   1      } 
