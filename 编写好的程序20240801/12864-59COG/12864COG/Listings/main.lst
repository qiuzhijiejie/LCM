 388          // ShowChar   size: 16/8 
 389          void ShowChar(unsigned char x,unsigned char y,unsigned char chr)
 390          {       
 391   1              unsigned char c=0,i=0;  
 392   1                      c=chr-' ';                      
 393   1                      if(x>Max_Column-1){x=0;if(SIZE==16)y+=2;else y+=1;}
 394   1                      if(SIZE ==16)
 395   1                              {
 396   2                              Set_Pos(x,y);   
 397   2                              for(i=0;i<8;i++)
 398   2                              Write_Data(F8X16[c*16+i]);
 399   2                              Set_Pos(x,y+1);
 400   2                              for(i=0;i<8;i++)
 401   2                              Write_Data(F8X16[c*16+i+8]);
 402   2                              }
 403   1                              else {  
 404   2                                      Set_Pos(x,y);
 405   2                                      for(i=0;i<6;i++)
 406   2                                      Write_Data(F6x8[c][i]);
 407   2                                      
 408   2                              }
 409   1      }
