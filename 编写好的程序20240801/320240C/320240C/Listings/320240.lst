 227          void roll_h(uint x,bit dir,bit part)
 228          {
 229   1       uchar i;
 230   1       uint  addr;
 231   1       if(dir) addr = x;  //Horizontally to the right
 232   1       else addr = 0;     //Horizontally to the left
 233   1       while(x--)
 234   1       {
 235   2        for(i = 0; i < 8; i++)
 236   2        {
 237   3         write_cmd(hdotscr);
