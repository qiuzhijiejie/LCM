 239   3         else write_dat(i);        //Horizontally to the left
 240   3        delay(50000);
C51 COMPILER V9.60.7.0   320240                                                            09/22/2025 09:37:09 PAGE 5   

 241   3        delay(50000);
 242   3        }
 243   2        if(dir) addr--;   //Horizontally to the right
 244   2        else addr++;      //Horizontally to the left
 245   2        if(part) set_addr2(addr); //2area
 246   2        else  set_addr1(addr);    //1area
 247   2       }
 248   1      }
