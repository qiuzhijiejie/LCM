 707          void DisplayDots(unsigned num1, unsigned num2)
 708          {
 709   1          uchar y;
 710   1          uint i;
 711   1      
 712   1          for (y = 0; y < 240; y++)  // RW8835 支持 240 行
 713   1          {
 714   2              locate_xy2(0, y);       // 设置当前行的起始位置为 X=0
 715   2      
 716   2              write_cmd(mwrite);      // 进入图形写入模式
 717   2      
 718   2              for (i = 0; i < 40; i++) // 每行写 320 像素 / 8 = 40 字节
 719   2              {
 720   3                  if (y % 2 == 1)
 721   3                      write_dat(num1);  // 奇数行：写满（点亮）
 722   3                  else
 723   3                      write_dat(num2);  // 偶数行：清零（熄灭）
 724   3              }
 725   2          }
 726   1      }
