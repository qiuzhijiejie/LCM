 730          {
 731   1          if (LCD_KEY == 1)           
 732   1              {  // 按键被按下
 733   2              delay(10);  // 简单的去抖动处理
 734   2              if (LCD_KEY == 1) 
 735   2                      {  // 检查按键是否仍然按下
C51 COMPILER V9.60.7.0   320240                                                            09/22/2025 09:37:09 PAGE 13  

 736   3                  while (LCD_KEY == 1);  // 等待按键释放
