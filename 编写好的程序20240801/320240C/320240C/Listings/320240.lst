 259   1       for(i = 0; i <= x; i++)
 260   1       {
 261   2        if(dir) addr = AP * (x - i); //Vertically upwards
 262   2        else addr = AP * i;          //Vertically downwards
 263   2        if(part) set_addr2(addr);    //2 area
 264   2        else  set_addr1(addr);       //1 area 
 265   2       delay(50000);
 266   2        delay(50000);
 267   2       }
 268   1      }
