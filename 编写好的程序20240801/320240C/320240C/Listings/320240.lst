 387          void show_line(uint x1,uchar y1,uint x2,uchar y2,bit attr)
 388          {
 389   1       int  dx, dy;
 390   1       char inc_x, inc_y;
 391   1       int  xerr = 0, yerr = 0;    //Initialize variables
 392   1       uint i, ds;
 393   1          dx = x2 - x1;       //Calculate the coordinates increment
 394   1          dy = y2 - y1;
 395   1       if(dx > 0) inc_x = 1;     //Set the single-step direction
 396   1       else 
 397   1       {
 398   2        if(dx == 0) {inc_x = 0;     } //Vertical line
 399   2        else  {inc_x = -1; dx = -dx;}
 400   2       }
 401   1       if(dy > 0) inc_y = 1;     //Set the single-step direction
 402   1       else
 403   1          {
 404   2        if(dy == 0) {inc_y = 0;     } //Horizontal line
 405   2        else  {inc_y = -1; dy = -dy;}
 406   2       }
 407   1       if(dx > dy) ds = dx;     //select the basic incremental axis
 408   1       else  ds = dy;
 409   1       for(i = 0; i <= ds+1; i++)    //drawing line
 410   1       {
 411   2        show_pixel(x1, y1, attr);   //drawing pixel
 412   2        xerr += dx;
 413   2        yerr += dy;
 414   2        if(xerr > ds)
 415   2        {
 416   3         xerr -= ds;
 417   3         x1   += inc_x;
 418   3        }
 419   2        if(yerr > ds)
 420   2        {
 421   3         yerr -= ds;
 422   3         y1   += inc_y;
 423   3        }
 424   2       }
 425   1      }
