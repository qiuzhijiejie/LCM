 677          /******************************************************* 
 678          show moving circle   显示移动圆圈
 679          *******************************************************/
 680          void demo_game(void)
 681          {uchar cs=500;
 682   1       uchar r = 20;    //Radius
 683   1       uchar i = 3;    //Stepping variables
 684   1       int   x = 30,y = 30;     //Starting position
 685   1       int   dx = i,  dy = i;    //Stepping
 686   1       int   x1, y1;      //Save the last position
 687   1       
 688   1       //lcd_init();
 689   1       lcd_cls(0);
 690   1       while(cs--)
 691   1       {
 692   2        show_circle(x, y, r, 0);
 693   2        x1 = x, y1 = y;     //Save location
 694   2        if((x-r) < 0) dx = i;
 695   2        if((x+r) > 319) dx = -i;
 696   2        if((y-r) < 0) dy = i;
 697   2        if((y+r) > 239) dy = -i;
 698   2        x += dx;
 699   2        y += dy; 
 700   2        delay(50000);     
 701   2        show_circle(x1, y1, r, 1);   //Disappear before a round
 702   2        show_pixel(x1, y1, x&0x01);  //Locus
 703   2       }
 704   1      }
