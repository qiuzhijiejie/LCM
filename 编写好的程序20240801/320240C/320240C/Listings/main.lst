 193          /******************************************************* 
 194                              Write instruction code  写指令码
 195          *******************************************************/
 196          void write_cmd(unsigned char cmd)
 197          {
 198   1       CS = 0;
 199   1       _RD = 1;  
 200   1       P1 = cmd;
 201   1       CD = 1;    //command
 202   1       _WR = 0;    //Rising edge of write
 203   1       _WR = 1;
 204   1       CS = 1;
 205   1      }
 206          /******************************************************* 
 207                        Write command parameters, display data  写命令参数，显示数据
 208          *******************************************************/
 209          void write_dat(unsigned char dat)
 210          {chkbusy();
 211   1       CS = 0;
 212   1       _RD = 1;
 213   1       P1 = dat;
 214   1       CD = 0;    //data
 215   1       _WR = 0;    //Rising edge of write
 216   1       _WR = 1;
 217   1       CS = 1;
 218   1      }
 219          /******************************************************* 
 220                              read data  读取数据
 221          *******************************************************/
 222          uchar read_dat(void)
 223          { uchar temp=0;
 224   1      chkbusy();
 225   1       CS = 0;
 226   1       CD   = 1;
 227   1       _WR   = 1;
 228   1       _RD   = 0;
 229   1       temp = P1;
 230   1       _RD   = 1;
 231   1        CS = 1;
 232   1       return (temp);
 233   1      }
 234          
 235          /******************************************************* 
 236                                check busy  检查忙碌状态
 237          *******************************************************/
 238          void chkbusy(void)
 239          {
C51 COMPILER V9.60.7.0   MAIN                                                              08/12/2024 12:13:52 PAGE 5   

 240   1           uchar b;
 241   1         b=1;
 242   1        if(b!=0)
 243   1        {
 244   2          b=lcd_cmdread();
 245   2          b&=0x40; 
 246   2        } 
 247   1       
 248   1      }
 249          
 250          /******************************************************* 
 251                                read status 阅读状态
 252          *******************************************************/
 253          uchar lcd_cmdread(void)
 254          {   
 255   1          uchar address_cmd;
 256   1          P1=0xff;
 257   1          CS = 0;
 258   1          CD = 0;
 259   1        _WR = 1;
 260   1          _RD = 0;
 261   1          address_cmd =P1;
 262   1          _RD = 1;
 263   1          CS = 1;
 264   1        return(address_cmd);
 265   1      }
