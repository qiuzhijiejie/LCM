 629          void show_circle(uint x,uchar y,uchar r,bit attr)
 630          {
 631   1       uchar dx,dy = r; 
 632   1       for(dx = 0; dx <= r; dx++)
 633   1       {
 634   2        while((r * r + 1 - dx * dx) < (dy * dy)) dy--;
 635   2        show_pixel(x + dx, y - dy, attr);
 636   2        show_pixel(x - dx, y - dy, attr);
 637   2        show_pixel(x - dx, y + dy, attr);
 638   2        show_pixel(x + dx, y + dy, attr);
 639   2        show_pixel(x + dy, y - dx, attr);
 640   2        show_pixel(x - dy, y - dx, attr);
 641   2        show_pixel(x - dy, y + dx, attr);
 642   2        show_pixel(x + dy, y + dx, attr);
 643   2       }
 644   1      }
