 379   1       write_dat((uchar)(addr >> 8) + basepart2); //After writing the high eight
 380   1      }
 381          /******************************************************* 
 382                               set 1 area address   Text  设置1个地区地址文本
 383          *******************************************************/
 384          void set_addr1(uint addr)
 385          {
 386   1       addr += basepart1;
