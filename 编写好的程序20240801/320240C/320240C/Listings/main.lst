1013   2        if((x+r) > 319) dx = -i;
1014   2        if((y-r) < 0) dy = i;
1015   2        if((y+r) > 239) dy = -i;
1016   2        x += dx;
1017   2        y += dy; 
1018   2        delay(50000);     
1019   2        show_circle(x1, y1, r, 1);  //Disappear before a round
1020   2        show_pixel(x1, y1, x&0x01);  //Locus
1021   2       }
1022   1      }
