 338          /******************************************************* 
 339                                Cursor positioning  光标定位
 340                          x: 0~39 320/8=40
 341                          y: 0~29 240/8=30
 342                            1 area Text
 343          *******************************************************/
 344          void locate_xy1(unsigned char x, unsigned char y)
 345          {
 346   1       unsigned int  addr;
 347   1       addr  =(unsigned int)(y) * AP + x;
 348   1       write_cmd(csrw);       //Write cursor address
 349   1       write_dat((unsigned char)(addr & 0xff));  //First write the low eight
 350   1       write_dat((unsigned char)(addr >> 8));  //After writing the high eight
 351   1      }
 352          
 353          /******************************************************* 
 354                               Cursor positioning  光标定位
 355                            x: 0~319 320
 356                            y: 0~239 240
 357                          2  area   Graphics
 358          *******************************************************/
 359          void locate_xy2(uint x, uchar y)
 360          {
 361   1       uint  addr;
 362   1       addr  = (uint)(y) * AP + x/8;
 363   1       write_cmd(csrw);         //Write cursor address
C51 COMPILER V9.60.7.0   MAIN                                                              08/12/2024 12:13:52 PAGE 7   

 364   1       write_dat((uchar)(addr & 0xff));    //First write the low eight
 365   1       write_dat((uchar)(addr >> 8) + basepart2); //After writing the high eight
 366   1      }
 367          /******************************************************* 
 368                                Cursor positioning  光标定位
 369                            x: 0~319 320
 370                            y: 0~239 240
 371                            2  area      Graphics         
 372          *******************************************************/
 373          void locate_xy22(uint x, uchar y)
 374          {
