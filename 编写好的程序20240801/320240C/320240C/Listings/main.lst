 391          /******************************************************* 
 392                               set 2 area address   Graphics 设置2个区域地址图形
 393          *******************************************************/
 394          void set_addr2(uint addr)
 395          {
 396   1       addr += basepart2;
 397   1       write_cmd(scroll);
 398   1       write_dat(scroll_P10[0]);
 399   1       write_dat(scroll_P10[1]);
 400   1       write_dat(scroll_P10[2]);
 401   1       write_dat((uchar)(addr & 0xff));
 402   1       write_dat((uchar)(addr >> 8));   
 403   1      }
 404          /******************************************************* 
 405                          Vertical direction scrolling display  垂直方向滚动显示器
 406                  x?? Rolling distance  Text--x  row ??Graphics--x pixels
 407                dir?? Rolling direction  0--left ??1--right
 408                 part??Scroll area  0--1area?? 1--2area                    
 409          *******************************************************/
 410          void roll_h(uint x,bit dir,bit part)
 411          {
 412   1       uchar i;
 413   1       uint  addr;
 414   1       if(dir) addr = x;  //Horizontally to the right
 415   1       else addr = 0;     //Horizontally to the left
 416   1       while(x--)
 417   1       {
 418   2        for(i = 0; i < 8; i++)
 419   2        {
 420   3         write_cmd(hdotscr);
 421   3         if(dir) write_dat(7 - i); //Horizontally to the right
 422   3         else write_dat(i);        //Horizontally to the left
 423   3       delay(50000);
 424   3        delay(50000);
 425   3        }
C51 COMPILER V9.60.7.0   MAIN                                                              08/12/2024 12:13:52 PAGE 8   

 426   2        if(dir) addr--;   //Horizontally to the right
 427   2        else addr++;      //Horizontally to the left
 428   2        if(part) set_addr2(addr); //2area
 429   2        else  set_addr1(addr);    //1area
 430   2       }
 431   1      }
 432          /******************************************************* 
 433                          Vertical direction scrolling display 垂直方向滚动显示器
 434                  x?? Rolling distance  Text--x  row ??Graphics--x pixels
 435                dir?? Rolling direction  0--Up ??1--Down
 436                 part??Scroll area  0--1area?? 1--2area                    
 437          *******************************************************/
 438          void roll_v(unsigned char x, bit dir, bit part)
 439          {
 440   1       unsigned char i;
