 267          
 268          /******************************************************* 
 269                                Delay  延迟
 270          *******************************************************/
 271          void delay(uint a)
 272          {
 273   1       uint  b1,c;
 274   1       for(b1=a  ;b1>0;b1--);
 275   1       for(c=24000;c>0;c--);
 276   1      }
 277          /******************************************************* 
 278          
 279          /******************************************************* 
 280                          LCM  Initialization  LCM初始化
 281          *******************************************************/
 282          void lcd_init(void)
 283          {
 284   1       uchar i;
 285   1       write_cmd(systemset);//Initialization settings
 286   1       for(i=0;i<8 ;i++)
 287   1       write_dat(systemset_P8[i]);
 288   1       write_cmd(scroll);   //Setting the display start address and the display range
 289   1       for(i=0;i<10;i++) 
 290   1       write_dat(scroll_P10[i]);
 291   1       write_cmd(hdotscr);  //Point displacement amount set
 292   1       write_dat(0x00);     //Do not move
 293   1       write_cmd(ovlay);    //Display synthesis settings
 294   1       write_dat(0x00);     //Synthesis of double, text display, logic or
 295   1       show_off();          //display off
 296   1       lcd_cls(0);          //clrar dispay
 297   1       show_on();           //display on
 298   1      }
 299          /******************************************************* 
 300                       clear display  清晰的显示屏
 301                         32KB RAM 
C51 COMPILER V9.60.7.0   MAIN                                                              08/12/2024 12:13:52 PAGE 6   

 302                     part = 1  1area
 303                     part = 2  2area
 304                     part = 3  3area
 305                     part = 4  4area              
 306          *******************************************************/
 307          void lcd_cls(uchar part)
 308          {
 309   1       uint i = 10240;       //10240 = 0x2800  10KB RAM
 310   1       write_cmd(csrw);      //Write cursor address
 311   1       write_dat(0x00);      //First write the low eight
 312   1            if(part == 1) write_dat(0x00);     //1area
 313   1       else if(part == 2) write_dat(basepart2);//2area
 314   1       else if(part == 3) write_dat(basepart3);//3area
 315   1       else if(part == 4) write_dat(basepart4);//4area
 316   1       else {i = 32768;   write_dat(0x00);}    //After writing the high eight, All dispay area 32KB RAM
 317   1       write_cmd(csrdirr);   //Cursor right direction
 318   1       write_cmd(mwrite);    //write data 
 319   1       while(i--) write_dat(0x00);//Write 0
 320   1      }
 321          /******************************************************* 
 322                            Display on
 323          *******************************************************/
 324          void show_on(void)
 325          {
 326   1       write_cmd(dispon);    //Display on
 327   1       write_dat(0x57);      //the cursor 1Hz flashes
 328   1      }
 329          /******************************************************* 
 330                              Display  off
 331          *******************************************************/
 332          void show_off(void)
 333          {
 334   1       write_cmd(dispoff);   //Display  off
 335   1       write_dat(0x57);      //the cursor 1Hz flashes
 336   1      }
