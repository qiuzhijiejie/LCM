 561   1       write_cmd(mwrite);     //write data 
 562   1       write_dat(temp);
 563   1      }
 564          /******************************************************* 
 565                              display line 显示线
 566                           x: 0~319 320
 567                           y: 0~239 240
 568                 attr:Display Properties??0-Drawing   1-clear
 569          *******************************************************/
 570          void show_line(uint x1,uchar y1,uint x2,uchar y2,bit attr)
 571          {
 572   1       int  dx, dy;
 573   1       char inc_x, inc_y;
 574   1       int  xerr = 0, yerr = 0;    //Initialize variables
 575   1       uint i, ds;
 576   1          dx = x2 - x1;       //Calculate the coordinates increment
 577   1          dy = y2 - y1;
 578   1       if(dx > 0) inc_x = 1;     //Set the single-step direction
 579   1       else 
 580   1       {
 581   2        if(dx == 0) {inc_x = 0;     } //Vertical line
 582   2        else  {inc_x = -1; dx = -dx;}
 583   2       }
 584   1       if(dy > 0) inc_y = 1;     //Set the single-step direction
 585   1       else
 586   1          {
 587   2        if(dy == 0) {inc_y = 0;     } //Horizontal line
 588   2        else  {inc_y = -1; dy = -dy;}
 589   2       }
 590   1       if(dx > dy) ds = dx;     //select the basic incremental axis
 591   1       else  ds = dy;
 592   1       for(i = 0; i <= ds+1; i++)    //drawing line
 593   1       {
 594   2        show_pixel(x1, y1, attr);   //drawing pixel
 595   2        xerr += dx;
 596   2        yerr += dy;
 597   2        if(xerr > ds)
 598   2        {
 599   3         xerr -= ds;
 600   3         x1   += inc_x;
 601   3        }
 602   2        if(yerr > ds)
 603   2        {
 604   3         yerr -= ds;
 605   3         y1   += inc_y;
 606   3        }
 607   2       }
 608   1      }
