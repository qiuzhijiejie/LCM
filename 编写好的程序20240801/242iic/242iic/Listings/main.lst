 177          //写入  最后将SDA拉高，以等待从设备产生应答
 178          void IIC_write(unsigned char date)
C51 COMPILER V9.60.7.0   MAIN                                                              11/06/2024 16:39:49 PAGE 4   

 179          {
 180   1        unsigned char i, temp;
 181   1        temp = date;
 182   1            
 183   1        for(i=0; i<8; i++)
 184   1        { IIC_SCK_0;
 185   2          
 186   2                      if ((temp&0x80)==0)
 187   2                        IIC_SDA_0;
 188   2                      else IIC_SDA_1;
 189   2          temp = temp << 1;
 190   2                    //最少250ns延时
 191   2          IIC_SCK_1;
 192   2          
 193   2        }
 194   1        IIC_SCK_0;
 195   1        
 196   1        IIC_SDA_1;
 197   1        
 198   1        IIC_SCK_1;
 199   1        
 200   1         ACK =0;
 201   1        IIC_SCK_0;
 202   1        
 203   1      
 204   1      }
