 219   1      }
 220          
 221          //停止信号
 222          //SCL在高电平期间，SDA由低电平向高电平的变化定义为停止信号
 223          void IIC_stop()
 224          {
 225   1        IIC_SDA_0;
 226   1        
 227   1        IIC_SCK_1;
 228   1        
 229   1        IIC_SDA_1;
 230   1        
 231   1      }
