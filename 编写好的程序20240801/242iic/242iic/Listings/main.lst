 206          //SCL在高电平期间，SDA由高电平向低电平的变化定义为启动信号
 207          void IIC_start()
 208          {
 209   1        IIC_SDA_1;
 210   1        
 211   1        IIC_SCK_1;
 212   1                   //所有操作结束释放SCL  
 213   1        IIC_SDA_0;
 214   1        
 215   1        IIC_SCK_0;
 216   1        
 217   1              IIC_write(0x78);
