  lcd.Init_lcd();                         //显示屏和引脚初始化
}
//图像旋转90度显示是通过将图像旋转90度后取模显示的
void loop() {
    lcd.WriteData(0xc2,0);                //写入正常方向显示指令
    
    lcd.WriteData(0xa6,0);                //写入正显示指令
    lcd.Dispgraphic(pic_f);               //显示正常图片
    delay(888);

    lcd.WriteData(0xa7,0);                //写入反显示指令
    lcd.Dispgraphic(pic_f);               //显示正常图片
    delay(888);

    lcd.WriteData(0xc4,0);                //写入旋转180度指令
    lcd.Dispgraphic(pic_f);               //显示正常图片
    delay(888);
}
