 110          //*************写命令****************************
 111          void LCD_write_command(unsigned char command)
 112          {
 113   1              delay_nus(16);
 114   1              LCD_data&=~(1<<(1-1));//RS=0;
 115   1              LCD_data&=~(1<<(2-1));//RW=0;
 116   1          Write_Random_Address_Byte(0x40,LCD_data);
