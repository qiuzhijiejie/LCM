 124   1              LCD_data&=0x0f; //清高四位
 125   1              LCD_data|=command&0xf0; //写低四位
 126   1          Write_Random_Address_Byte(0x40,LCD_data);
 127   1          Enable_LCD_write();
 128   1      }
