  60          //******************************************
  61          void  Write_A_Byte(unsigned char c)
  62          {
  63   1       unsigned char BitCnt;
  64   1        for(BitCnt=0;BitCnt<8;BitCnt++)  //要传送的数据长度为8位
  65   1          {
  66   2           if((c<<BitCnt)&0x80)  SDA=1;   //判断发送位
  67   2           else  SDA=0;                
  68   2           _nop_();
  69   2           SCL=1;               //置时钟线为高，通知被控器开始接收数据位
  70   2           nop4(); 
  71   2           _nop_();       
  72   2           SCL=0; 
  73   2          }  
  74   1          _nop_();
  75   1          _nop_();
  76   1          SDA=1;               //8位发送完后释放数据线，准备接收应答位
  77   1          _nop_();
  78   1          _nop_();  
  79   1          SCL=1;
  80   1          _nop_();
  81   1          _nop_();
  82   1          _nop_();
  83   1          if(SDA==1)ack=0;     
  84   1             else ack=1;        //判断是否接收到应答信号
  85   1          SCL=0;
  86   1          _nop_();
  87   1          _nop_();
  88   1      }
  89          
  90          bit Write_Random_Address_Byte(unsigned char add,unsigned char dat)
  91          {
  92   1              Start();    //启动总线
  93   1              Write_A_Byte(add); //发送器件地址
  94   1          if(ack==0)return(0);
  95   1              Write_A_Byte(dat);   //发送数据
  96   1          if(ack==0)return(0);
  97   1              Stop(); //结束总线
  98   1          return(1);
  99   1      }
 100          //********************液晶屏使能*********************
 101          void Enable_LCD_write()
 102          {
 103   1          LCD_data|=(1<<(3-1));//E=1;
