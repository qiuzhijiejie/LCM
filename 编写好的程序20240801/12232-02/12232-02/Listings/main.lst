 580          //修改人:XIEJIANREN
 581          //-------------------------------------------------------------------------------
 582          void lcdwd(unsigned char d)             //向液晶显示控制器写数据
 583          {   lcdwaitidle();                      //ST7920液晶显示控制器忙检测
 584   1          P1=d;
 585   1          RSPIN=1;                            //RS=1 RW=0 E=高脉冲
 586   1          RWPIN=0;
 587   1          EPIN=1;
 588   1          _nop_();
 589   1          EPIN=0;
 590   1      }
 591          //-------------------------------------------------------------------------------
 592          //子程序名称:lcdwc(unsigned char c).
