 428          //-------------------------------------------------------------------------------
 429          //以下为charlcdpos,charcursornext,lcdreset为ST7920兼容芯片的液晶显示控制器的
 430          //20ASCII字符X2行的LCM16032系列标准中文字符点阵型液晶显示模块的接口程序.
 431          //-------------------------------------------------------------------------------
 432          //子程序名称:void charlcdpos(void).
 433          //功能:设置坐标点(CXPOS,CYPOS)位置对应的内部RAM地址.
 434          //修改日期:2009.11.02
 435          //修改人:XIEJIANREN
 436          //-------------------------------------------------------------------------------
 437          void charlcdpos(void)                   //设置坐标点(CXPOS,CYPOS)内部RAM地址的子程序
 438          {   unsigned char ddaddr;
 439   1          if(CXPOS>19) CXPOS=0;               //字符位置CXPOS的有效范围为(0到19)
 440   1          CYPOS&=0X1;                         //字符位置CYPOS的有效范围为(0到1)
 441   1          ddaddr=CXPOS/2;
 442   1          if(CYPOS==0)                        //(第一行)X: 第0----19个字符
 443   1              lcdwc(ddaddr|0x80);             //    DDRAM:  80----89H
 444   1          else                                //(第二行)X: 第0----19个字符
 445   1              lcdwc(ddaddr|0x90);             //    DDRAM:  90----99H
 446   1      }
 447          //-------------------------------------------------------------------------------
 448          //子程序名称:void charcursornext(void).
 449          //功能:置字符位置为下一个有效位置.
 450          //修改日期:2009.11.02
 451          //修改人:XIEJIANREN
 452          //-------------------------------------------------------------------------------
 453          void charcursornext(void)               //置字符位置为下一个有效位置子程序
 454          {
 455   1          CXPOS++;                            //字符位置加1
 456   1          if(CXPOS>19) CXPOS=0;               //字符位置CXPOS的有效范围为(0到19)
 457   1          if(CXPOS==0)                        //字符位置CXPOS=0表示要换行
 458   1          {   CYPOS++;                        //行位置加1
 459   2              CYPOS&=0X1;                     //字符位置CYPOS的有效范围为(0到1)
 460   2          }
 461   1      }
 462          //-------------------------------------------------------------------------------
 463          //子程序名称:void lcdreset(void)
 464          //功能:液晶显示控制器初始化
 465          //修改日期:2009.08.31
 466          //修改人:XIEJIANREN
 467          //-------------------------------------------------------------------------------
 468          void lcdreset(void)                     //液晶显示控制器初始化子程序
 469          {   lcdwc(0x33);                        //接口模式设置
 470   1          delay3ms();                         //延时3MS
 471   1          lcdwc(0x30);                        //基本指令集
 472   1          delay3ms();                         //延时3MS
 473   1          lcdwc(0x30);                        //重复送基本指令集
 474   1          delay3ms();                         //延时3MS
 475   1          lcdwc(0x01);                        //清屏控制字
 476   1          delay3ms();                         //延时3MS
 477   1          lcdwc(0x06);                        //显示光标移动设置
 478   1          lcdon();                            //开显示
 479   1      }
 480          void delay3ms(void)                     //延时3MS子程序
 481          { unsigned char i,j,k;
 482   1        for(i=0;i<3;i++)
 483   1          for(j=0;j<64;j++)
 484   1            for(k=0;k<51;k++);
 485   1      }
 486          //-------------------------------------------------------------------------------
 487          //子程序名称:void glcdfill(unsigned char d).
 488          //功能:整屏显示d表示的字节数据.
C51 COMPILER V9.60.7.0   MAIN                                                              09/14/2025 22:22:26 PAGE 9   

 489          //修改日期:2009.11.02
 490          //修改人:XIEJIANREN
 491          //-------------------------------------------------------------------------------
 492          void glcdfill(unsigned char d)          //整屏显示d代表的字数据子程序
 493          {   unsigned char i;
 494   1          GXPOS=0;
 495   1          GYPOS=0;
 496   1          while(GYPOS<32)
 497   1          {   glcdpos();
 498   2              for(i=0;i<20;i++)
 499   2                  lcdwd(d);
 500   2              GYPOS++;
 501   2          }
 502   1          GYPOS=0;
 503   1      }
 504          //-------------------------------------------------------------------------------
 505          //子程序名称:void glcdpos(void)
 506          //功能:设置(GXPOS,GYPOS)对应绘图区域内部RAM指针.
 507          //修改日期:2009.11.02
 508          //修改人:XIEJIANREN
 509          //-------------------------------------------------------------------------------
 510          void glcdpos(void)                      //写入绘图区域内部RAM指针子程序
 511          {   lcdwc(0x36);                        //扩展指令集
 512   1          lcdwc((GYPOS&0x1f)|0x80);           //先送Y地址
 513   1          lcdwc((GXPOS/16)|0x80);             //再送X地址
 514   1          lcdwc(0x30);                        //恢复为基本指令集
 515   1      }
