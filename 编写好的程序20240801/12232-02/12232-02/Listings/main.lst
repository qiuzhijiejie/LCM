 556          //-------------------------------------------------------------------------------
 557          //以下lcdwc,lcdwd为ST7920兼容芯片的MCS51三线式串行接口方式的基本子程序,lcdwaitidle
 558          //为内部子程序.
 559          //-------------------------------------------------------------------------------
 560          //子程序名称:unsigned char lcdrd(void).
 561          //功能:从液晶显示控制器读数据.
 562          //修改日期:2009.10.29
 563          //修改人:XIEJIANREN
 564          //-------------------------------------------------------------------------------
 565          unsigned char lcdrd(void)               //从液晶显示控制器读数据
 566          {   unsigned char d;
 567   1          lcdwaitidle();                      //ST7920液晶显示控制器忙检测
 568   1          RSPIN=1;                            //RS=1 RW=1 E=高脉冲
 569   1          RWPIN=1;
 570   1          EPIN=1;
 571   1          _nop_();
 572   1          d=P1;
 573   1          EPIN=0;
 574   1          return d;
 575   1      }
 576          //-------------------------------------------------------------------------------
 577          //子程序名称:void lcdwd(unsigned char d).
 578          //功能:向液晶显示控制器写数据.
