 390          //-------------------------------------------------------------------------------
 391          //以下putsizeimage为图形对象的基本子程序,putimage为图形对象的扩充子程序
 392          //-------------------------------------------------------------------------------
 393          //子程序名称:void putsizeimage(unsigned char XSIZE,unsigned YSIZE,
 394          //                             unsigned char code *s)
 395          //功能:在(GXPOS,GYPOS)位置绘制XSIZE列及YISZE行点阵的图形*S(XSIZE仅取8的倍数
 396          //     GXPOS仅取16的倍数).
 397          //修改日期:2009.10.29
 398          //修改人:xiejianren
 399          //-------------------------------------------------------------------------------
 400          void putsizeimage(unsigned char XSIZE,unsigned char YSIZE,unsigned char code *s)
 401          {  unsigned char lx,ly,x;
 402   1         x=GXPOS;
 403   1         for(ly=0;ly<YSIZE;ly++,GYPOS++)
 404   1         {  for(GXPOS=x,lx=0;lx<XSIZE;)
 405   2            {  if((GXPOS&0x08)==0) glcdpos();
 406   3               lcdwd(*s);
 407   3               s++;
 408   3               lx+=8;
 409   3               GXPOS+=8;
 410   3            }
 411   2         }
 412   1         GXPOS=x;
 413   1      }
