 286          //-------------------------------------------------------------------------------
 287          //字符操作区域
 288          //16032ZK字符区域定义为:
 289          //   CXPOS(0-19) 对应于第1列到第19列位置,每个字符列位置实际占位8点,总计对应160点
 290          //   CYPOS(0-1)对应于第1行到第2行,每个行位置实际占位16点,总计对应32点
 291          //警告:直接设置CXPOS的位置时,请将CXPOS的值设置为偶数,否则显示的字符值会不正确.
 292          //-------------------------------------------------------------------------------
 293          //以下为charlcdfill,putchar,putstr,setcharcgram为ST7920兼容芯片的液晶显示控制器
 294          //的通用子程序,putstrxy为扩充子程序.
 295          //-------------------------------------------------------------------------------
 296          //子程序名称:void charlcdfill(unsigned int c).
 297          //功能:整屏显示A代表的ASCII字符.
 298          //修改日期:2009.10.29
 299          //修改人:xiejianren
 300          //-------------------------------------------------------------------------------
 301          void charlcdfill(unsigned int c)        //整屏显示A代表的ASCII字符子程序
 302          {   for(CXPOS=CYPOS=0;1;)
C51 COMPILER V9.60.7.0   MAIN                                                              09/14/2025 22:22:26 PAGE 6   

 303   1          {   putchar(c);                     //定位写字符
 304   2              if((CXPOS==0) && (CYPOS==0)) break;
 305   2          }
 306   1      }
 307          //-------------------------------------------------------------------------------
 308          //子程序名称:void putchar(unsigned int c).
 309          //功能:在(XPOS,YPOS)位置写单个字符点阵,若c>128 表示为中文字符,否则为西文字符
 310          //修改日期:2009.8.18
 311          //修改人:xiejianren
 312          //-------------------------------------------------------------------------------
 313          void putchar(unsigned int c)            //定位写字符子程序
 314          {   unsigned char d;
 315   1          if(c>128)                           //字符码大于128表示为汉字
 316   1          {   if( (CXPOS&0x1)==1 )            //写汉字时,CXPOS字符位置在奇数位置,则
 317   2              {   lcdwd(' ');                 //自动补添一个空格对齐后再显示汉字
 318   3                  charcursornext();           //置字符位置为下一个有效位置
 319   3              }
 320   2              charlcdpos();
 321   2              if((c&0xff00)==0xff00)          //若高位字节为0FFH则表示为自定义字符
 322   2                  c=0xffff-c;                 //则转换为ST7920的字符码
 323   2              lcdwd(c/256);                   //写高位字符
 324   2              charcursornext();
 325   2              lcdwd(c&0xff);                  //写低位字符
 326   2              charcursornext();
 327   2          }
 328   1          else                                //字符码小于128表示为ASCII字符
 329   1          {   charlcdpos();
 330   2              if( (CXPOS&0x1)==1 )            //写ASCII字符时,CXPOS字符位置在奇数位置,则
 331   2              {   d=lcdrd();                  //读高位字符
 332   3                  charlcdpos();
 333   3                  lcdwd(d);                   //重新写高位字符
 334   3                  lcdwd(c);
 335   3              }
 336   2              else
 337   2              {   lcdwd(c);                   //写ASCII字符时,CXPOS字符位置在偶数位置,则
 338   3                  lcdwd(' ');                 //直接写入,同时自动补显一个空格.
 339   3              }
 340   2              charcursornext();               //置字符位置为下一个有效位置
 341   2          }
 342   1      }
 343          //-------------------------------------------------------------------------------
 344          //子程序名称:void putstr(unsigned char code *s).
 345          //功能:写字符串点阵,若*s=0 表示字符串结束.
 346          //修改日期:2009.8.18
 347          //修改人:xiejianren
 348          //-------------------------------------------------------------------------------
 349          void putstr(unsigned char code *s)      //显示字符串子程序,字符码为0时退出
 350          {   unsigned int c;
 351   1          while(1)
 352   1          {   c=*s;
 353   2              s++;
 354   2              if(c==0) break;
 355   2              if(c<128)
 356   2                  putchar(c);
 357   2              else
 358   2              {   putchar(c*256+*s);
 359   3                  s++;
 360   3              }
 361   2          }
 362   1      }
 363          //-------------------------------------------------------------------------------
 364          //子程序名称:void putstrxy(unsigned char cx,unsigned char cy,unsigned char *s).
C51 COMPILER V9.60.7.0   MAIN                                                              09/14/2025 22:22:26 PAGE 7   

 365          //功能:在(cx,cy)字符位置写字符串.
 366          //修改日期:2009.08.11
 367          //修改人:xiejianren
 368          //-------------------------------------------------------------------------------
 369          void putstrxy(unsigned char cx,unsigned char cy,unsigned char code *s)
 370          {                                       //在(cx,cy)字符位置写字符串子程序
 371   1          CXPOS=cx;                           //置当前X位置为cx
 372   1          CYPOS=cy;                           //置当前Y位置为cy
 373   1          putstr(s);
 374   1      }
 375          //-------------------------------------------------------------------------------
 376          //子程序名称:void setcharcgram(unsigned char cindex,unsigned char code *s).
 377          //功能:将*s所指32字节点阵写到自定义字符cindex(0-3)中.
 378          //修改日期:2009.10.29
 379          //修改人:xiejianren
 380          //-------------------------------------------------------------------------------
 381          void setcharcgram(unsigned char cindex,unsigned char code *s)
 382          {   unsigned char i;
 383   1          lcdwc(0x34);                        //扩充指令集,图形模式关闭
 384   1          lcdwc(0x02);                        //SR=0 激活CGRAM
