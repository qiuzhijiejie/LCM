 598          {   lcdwaitidle();                      //ST7920液晶显示控制器忙检测
 599   1          P1=c;
 600   1          RSPIN=0;                            //RS=0 RW=0 E=高脉冲
 601   1          RWPIN=0;
 602   1          EPIN=1;
 603   1          _nop_();
 604   1          EPIN=0;
 605   1      }
 606          //-------------------------------------------------------------------------------
 607          //子程序名称:void lcdwaitidle(void).
 608          //功能:忙检测,在对液晶显示控制器操作的每一条指令之前,需检测液晶显示器是否空闲.
 609          //修改日期:2009.10.30
 610          //修改人:XIEJIANREN
 611          //-------------------------------------------------------------------------------
 612          void lcdwaitidle(void)                  //控制器忙检测子程序
C51 COMPILER V9.60.7.0   MAIN                                                              09/14/2025 22:22:26 PAGE 11  

 613          {   unsigned char i;
 614   1          P1=0xff;
 615   1          RSPIN=0;
 616   1          RWPIN=1;
 617   1          EPIN=1;
 618   1          for(i=0;i<20;i++)                   //
 619   1              if( (P1&0x80) != 0x80 ) break;  //D7=0 空闲退出
 620   1          EPIN=0;
 621   1      }


