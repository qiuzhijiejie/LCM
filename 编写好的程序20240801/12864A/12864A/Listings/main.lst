 798          void lcdwaitidle1(void)                 //控制器1忙检测子程序
 799          {   unsigned char i;
 800   1          P1=0xff;
 801   1          RSPIN=0;
 802   1          RWPIN=1;
 803   1          CS1PIN=1;
 804   1          CS2PIN=0;
 805   1          EPIN=1;
 806   1          for(i=0;i<20;i++)                   //
 807   1              if( (P1&0x80) != 0x80 ) break;  //D7=0 空闲退出
 808   1          EPIN=0;
 809   1          CS1PIN=0;
 810   1      }
 811          //-------------------------------------------------------------------------------
 812          //子程序名称:voidlcdwaitidle2(void).
