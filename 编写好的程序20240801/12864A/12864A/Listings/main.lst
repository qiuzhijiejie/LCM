 373          //子程序名称:unsigned char code *getchinesecodepos(unsigned char ac).
 374          //功能:根据当前中文字符码查表后计算得到当前中文字符码的字库点阵位置.
 375          //修改日期:2009.8.18
 376          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 377          //-------------------------------------------------------------------------------
 378          unsigned char code *getchinesecodepos(unsigned int ac)
 379          {   unsigned int min,max,mid,midc;
 380   1          min=0;
 381   1          max=CHINESECHARNUMBER-1;
 382   1          while(1)
 383   1          {   if(max-min<2)
 384   2              {   if(ChineseCode[min]==ac)
 385   3                      mid=min;
 386   3                  else if(ChineseCode[max]==ac)
 387   3                      mid=max;
 388   3                  else
 389   3                      mid=0;
 390   3                  break;
 391   3              }
 392   2              mid=(max+min)/2;
 393   2              midc=ChineseCode[mid];
 394   2              if(midc==ac)
 395   2                  break;
 396   2              else if(midc>ac)
 397   2                  max=mid-1;
 398   2              else
 399   2                  min=mid+1;
 400   2          }
 401   1          return ChineseCharDot+mid*CHINESECHARDOTSIZE;
 402   1      }
