 815          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 816          //-------------------------------------------------------------------------------
 817          void lcdwaitidle2(void)                 //控制器2忙检测子程序
 818          {   unsigned char i;
 819   1          P1=0xff;
 820   1          RSPIN=0;
 821   1          RWPIN=1;
 822   1          CS1PIN=0;
 823   1          CS2PIN=1;
 824   1          EPIN=1;
 825   1          for(i=0;i<20;i++)                   //
 826   1              if( (P1&0x80) != 0x80 ) break;  //D7=0 空闲退出
 827   1          EPIN=0;
 828   1          CS2PIN=0;
 829   1      }


