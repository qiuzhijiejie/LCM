 369          //-------------------------------------------------------------------------------
 370          unsigned char code *getchinesecodepos(unsigned int ac)
 371          {   unsigned int min,max,mid,midc;
 372   1          min=0;
 373   1          max=CHINESECHARNUMBER-1;
 374   1          while(1)
 375   1          {   if(max-min<2)
 376   2              {   if(ChineseCode[min]==ac)
 377   3                      mid=min;
 378   3                  else if(ChineseCode[max]==ac)
 379   3                      mid=max;
 380   3                  else
 381   3                      mid=0;
 382   3                  break;
 383   3              }
 384   2              mid=(max+min)/2;
 385   2              midc=ChineseCode[mid];
 386   2              if(midc==ac)
 387   2                  break;
 388   2              else if(midc>ac)
 389   2                  max=mid-1;
 390   2              else
 391   2                  min=mid+1;
 392   2          }
 393   1          return ChineseCharDot+mid*CHINESECHARDOTSIZE;
 394   1      }
