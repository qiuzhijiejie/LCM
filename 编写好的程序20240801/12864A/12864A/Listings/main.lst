 800          //-------------------------------------------------------------------------------
 801          //子程序名称:voidlcdwaitidle1(void).
 802          //功能:忙检测,在对液晶显示控制器操作的每一条指令之前,需检测液晶显示器是否空闲.
 803          //修改日期:2009.10.30
 804          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 805          //-------------------------------------------------------------------------------
 806          void lcdwaitidle1(void)                 //控制器1忙检测子程序
 807          {   unsigned char i;
 808   1          P1=0xff;
 809   1          RSPIN=0;
 810   1          RWPIN=1;
 811   1          CS1PIN=1;
 812   1          CS2PIN=0;
 813   1          EPIN=1;
 814   1          for(i=0;i<20;i++)                   //
 815   1              if( (P1&0x80) != 0x80 ) break;  //D7=0 空闲退出
 816   1          EPIN=0;
 817   1          CS1PIN=0;
 818   1      }
