 252          void main(void)
 253          {   while(1)
 254   1          {   lcdreset();                     //初始化液晶显示控制器
 255   2              exsample();                     //演示程序
 256   2          }
 257   1      }
 258          void exsample(void)                     //演示程序
 259          {
 260   1      //0.演示前的准备,将LCD液晶显示全部清空
 261   1          CharImageReverse=0;                 //反显关闭
 262   1          lcdfill(0);                         //清屏
 263   1      
 264   1      //1.图片测试: 在(2,1)位置显示32点阵Oriental图标
 265   1          XPOS=2;
 266   1          YPOS=1;
 267   1          putimage(Img_sunman_32);            //写数据到当前LCDRAM地址中
 268   1          exdelay();                          //延时约600mS
 269   1      
 270   1      //2.字符串测试: 在(40,0)位置显示"LCM12864A"字符串.
 271   1          XPOS=40;
 272   1          YPOS=0;
 273   1          putstr("LCM12864A");
 274   1          exdelay();                          //延时约600mS
 275   1      
 276   1      //3.字符串测试: 在(36,16)位置显示"Oriental"字符串.
 277   1          XPOS=36;
 278   1          YPOS=16;
 279   1          putstr("Oriental");
 280   1          exdelay();                          //延时约600mS
 281   1      
 282   1      //4.字符串测试: 在(1,32)位置显示"ORIENTAL-LCD.COM"字符串.
 283   1          XPOS=1;
 284   1          YPOS=32;
 285   1          putstr("ORIENTAL-LCD.COM");
 286   1          exdelay();                          //延时约600mS
 287   1      
 288   1      //5.反显测试: 在(1,32)位置反显"ORIENTAL-LCD.COM"字符串.
