  66          void BusyL(void)   
  67          {unsigned char flag=0xff;  
  68   1       CS1= 1;       //active "H"
  69   1       CS2= 0;   
  70   1       RS = 0;   
  71   1       RW = 1;  
  72   1      
  73   1       P1 = 0xFF; 
  74   1      while ((flag&0x80)==0x80)
  75   1       {
  76   2       E=1;
  77   2       _nop_();
  78   2       flag=P1;
  79   2       E=0;
  80   2       }    
  81   1      }   
  82             
  83          void BusyR(void)   
  84          { unsigned char flag=0xff;  
  85   1       CS1= 0;   
  86   1       CS2= 1;        //active "H"
  87   1       RS = 0;    
  88   1       RW = 1; 
  89   1      
  90   1       P1 = 0xFF;  
  91   1      while ((flag&0x80)==0x80)
  92   1       {
  93   2       E=1;
  94   2       _nop_();
  95   2       flag=P1;
  96   2       E=0;
  97   2       }  
  98   1      }   
