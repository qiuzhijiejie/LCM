  81          void    main(void)
  82               {
  83   1             delayms(40);             //Delay 40ms
  84   1                 RES=0;                 //Reset
  85   1                 delay(1);             
  86   1                 RES=1;                 //Reset set H
  87   1                 delay(10);
  88   1      
  89   1               while(1)
  90   1            {
  91   2            initina2();            //Graphic display Mode
  92   2      
  93   2                DisplayGraphic(pic1);  //show Graphic 
  94   2                delayms(2000);
  95   2        
  96   2                DisplayGraphic(pic2);  //show Graphic 
  97   2                delayms(2000);
  98   2      
  99   2                DisplayGraphic(pic3);  //show Graphic 
 100   2                delayms(2000);
 101   2      
 102   2                initinal();        // Fonts Mode
 103   2                delay(100);           
 104   2                lcd_mesg(IC_DAT);      //Show chanese fonts
 105   2                delayms(2000);
 106   2      
 107   2          
 108   2              }
 109   1            }
