  47          void     initinal(void)           //LCD initinal  Fonts Mode
  48                    {
  49   1      
  50   1                 TransferData(0x30,0);  //Extended Function Set :8BIT,RE=0: basic instruction set, G=0 :graphic 
             -display OFF
  51   1                 delay(100);            
  52   1                 TransferData(0x30,0);  //Function Set
  53   1                 delay(37);             
C51 COMPILER V9.60.7.0   MAIN                                                              08/13/2024 19:10:59 PAGE 2   

  54   1                 TransferData(0x08,0);  //Display on Control
  55   1                 delay(100);            
  56   1                 TransferData(0x10,0);  //Cursor Display Control
  57   1                 delay(100);            
  58   1                 TransferData(0x0C,0);  //Display Control,D=1,display on
  59   1                 delay(100);            
  60   1                 TransferData(0x01,0);  //Display Clear
  61   1                 delayms(10);             
  62   1                 TransferData(0x06,0);  //Enry Mode Set
  63   1                 delay(100);            
  64   1                }
  65          
  66          
  67          void     initina2(void)           //Graphic display Mode
  68                    {
  69   1      
  70   1                 TransferData(0x30,0);  //Extended Function Set RE=1: extended instruction
  71   1                 delay(100);       
  72   1                 TransferData(0x01,0);  //Display Clear
  73   1                 delayms(10);     
  74   1                 TransferData(0x36,0);  //Extended Function Set:RE=1: extended instruction set
  75   1                 delay(37);            
  76   1                 TransferData(0x3E,0);  //EXFUNCTION(DL=8BITS,RE=1,G=1)
  77   1                 delay(100);                      
  78   1                }
