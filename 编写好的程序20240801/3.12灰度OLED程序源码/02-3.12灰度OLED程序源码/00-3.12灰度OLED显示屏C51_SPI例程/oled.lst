  18          //    入口数据：dat 数据
  19          //    返回值：  无
  20          //******************************************************************************
  21          void OLED_WR_Bus(u8 dat)
  22          {
  23   1              u8 i;
  24   1              OLED_CS_Clr();
  25   1              for(i=0;i<8;i++)
  26   1              {                         
  27   2                      OLED_SCL_Clr();
  28   2                      if(dat&0x80)
  29   2                      {
  30   3                         OLED_SDA_Set();
  31   3                      }
  32   2                      else 
  33   2                      {
  34   3                         OLED_SDA_Clr();
  35   3                      }
  36   2                      OLED_SCL_Set();
  37   2                      dat<<=1;   
  38   2              }                                                 
  39   1              OLED_CS_Set();
  40   1      }
