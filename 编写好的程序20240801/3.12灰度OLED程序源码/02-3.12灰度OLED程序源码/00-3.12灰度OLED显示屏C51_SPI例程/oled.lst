 100          void OLED_Fill(u16 xstr,u8 ystr,u16 xend,u8 yend,u8 color)
 101          {
 102   1              u8 x,y;
 103   1              xstr/=4;
 104   1              xend/=4;
 105   1              Column_Address(xstr,xend-1);
