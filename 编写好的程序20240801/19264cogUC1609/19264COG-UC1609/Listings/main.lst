 434          //----------------------------------------------------------
 435          void Delay(Uint times)
 436            {
 437   1         while(times)
 438   1         {
 439   2          times--;
 440   2         }
 441   1        }
 442          //----------------------------------------------------------
 443          void M_Delay(Uint NOs)
 444            {
 445   1         while(NOs)
 446   1         {
 447   2          Delay(50);
 448   2          NOs--;
 449   2         }
 450   1        }
 451          
 452          void WriteData(Uchar data1, bit di)
 453          {
 454   1             Uchar i,temp;
 455   1              CS=0;
 456   1                      CD=di;
 457   1                      for(i=0;i<8;i++)
 458   1                          {
 459   2                        SCK=0;
 460   2                        temp=data1;
 461   2                        SDA=(bit)(temp&0x80);
 462   2      
 463   2                        somenop();
 464   2                    SCK=1;
 465   2                temp=data1<<1;
 466   2                    data1=temp;
 467   2                           }
 468   1              CS=1;
 469   1                      CD=~di;
 470   1      }
 471          
 472          //----------------------------------------------------------
 473          void Init_lcd(void)
 474            {
 475   1         int i;
 476   1         RST=0;
 477   1         Delay(200);
 478   1         RST=1;
 479   1         Delay(50000);
 480   1         for(i=0;i<8;i++)
 481   1         {
 482   2          WriteData(IC[i],0);
 483   2         }
 484   1        }
 485          
 486          //----------------------------------------------------------
 487          void Displine(Uchar array[])
 488            {
C51 COMPILER V9.60.7.0   MAIN                                                              06/20/2025 14:11:22 PAGE 9   

 489   1         Uint i,j,k;
 490   1         for(i=0;i<9;i++)
 491   1         {
 492   2      
 493   2          WriteData(0x40,0);  //set scroll line
 494   2          WriteData(0xb0|i,0);//set page address
 495   2          WriteData(0x10,0);  //column  msb
 496   2          WriteData(0x00,0);  //column  lsb
 497   2          for(j=0;j<48;j++)
 498   2          for(k=0;k<4;k++)
 499   2          {
 500   3           WriteData(array[k],1);
 501   3          }
 502   2         }
 503   1        }
 504          
 505          //----------------------------------------------------------
 506          
 507          void Dispgraphic(Uchar *p)
 508              {
 509   1                 Uchar i,j;
 510   1      
 511   1                         for(i=0;i<8;i++)
 512   1                         {
 513   2                                  WriteData(0x40,0);
 514   2                                  WriteData(0xb0|i,0);
 515   2                                  WriteData(0x10,0);
 516   2                                  WriteData(0x00,0);
 517   2                                  for(j=0;j<192;j++)
 518   2                                          {
 519   3                                           WriteData(p[i*192+j],1);
 520   3                                       }
 521   2                 }
 522   1      
 523   1        }
 524            
 525          void lcd_address(Uint page,Uint column)
 526          {
 527   1      column=column-0x01;
 528   1      WriteData(0xB0+page-1,0); //设置页地址，每8 行为一页，全屏共64 行，被分成8 页
 529   1      WriteData(0x10+(column>>4&0x0F),0); //设置列地址的高4 位
 530   1      WriteData(column&0x0F,0); //设置列地址的低4 位
 531   1      }
 532          
 533          
 534          //显示16x16 点阵图像、汉字、生僻字或16x16 点阵的其他图标
 535          void display_graphic_16x16(Uchar page,Uchar column,Uchar *dp)
 536          {
 537   1      Uint i,j;
 538   1      for(j=0;j<2;j++)
 539   1      {
 540   2      lcd_address(page+j,column);
 541   2      for (i=0;i<16;i++)
 542   2      {
 543   3      WriteData(*dp,1); //写数据到LCD,每写完一个8 位的数据后列地址自动加1
 544   3      dp++;
 545   3      }
 546   2      }
 547   1      }  
 548          
 549          //显示32x64 点阵图像、汉字、生僻字或32x64 点阵的其他图标
 550          void display_graphic_32x64(Uchar page,Uchar column,Uchar *dp)
C51 COMPILER V9.60.7.0   MAIN                                                              06/20/2025 14:11:22 PAGE 10  

 551          {
 552   1      Uint i,j;
 553   1      for(j=0;j<8;j++)
 554   1      {
 555   2      lcd_address(page+j,column);
 556   2      for (i=0;i<32;i++)
 557   2      {
 558   3      WriteData(*dp,1); //写数据到LCD,每写完一个8 位的数据后列地址自动加1
 559   3      dp++;
 560   3      }
 561   2      }
 562   1      }  
