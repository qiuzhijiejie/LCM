 610          ;-------------------------------------------------------------------------------
 611          ;以下PUTSIZEIMAGE,GLCDFILL,GLCDPOS为图形对象的基本子程序,PUTIMAGE为图形对象的
 612          ;扩充子程序
 613          ;-------------------------------------------------------------------------------
 614          ;子程序名称:PUTSIZEIMAGE(GXPOS,GYPOS,XSIZE,YSIZE,*S).
 615          ;功能:在(GXPOS,GYPOS)位置绘制XSIZE列及YISZE行点阵的图形*S(XSIZE仅取8的倍数
 616          ;     GXPOS仅取16的倍数).
 617          ;输入:位置GXPOS,GYPOS;XSIZE=R6,YSIZE=R7,S=DPTR.
 618          ;输出:GXPOS=GXPOS+XSIZE;GYPOS=GYPOS+YSIZE.
 619          ;影响:R0,R4,R5.
 620          ;修改日期:2009.10.29
 621          ;修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 622          ;-------------------------------------------------------------------------------
 623          PUTSIZEIMAGE:                           ;显示图形子程序
 624                                                  ;图形的大小,XSIZE=R6,YSIZE=R7
 625                                                  ;图形的大小循环变量LX=R4,LY=R5
