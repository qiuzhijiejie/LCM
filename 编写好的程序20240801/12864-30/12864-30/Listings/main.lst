 811          ;以下LCDWC,LCDWD为ST7920兼容芯片的MCS51三线式串行接口方式的基本子程序,TRANSBYTE,
 812          ;TRANSBIT为内部子程序.
 813          ;-------------------------------------------------------------------------------
 814          ;子程序名称:LCDWC(A).
 815          ;功能:送控制字到液晶显示控制器.
 816          ;输入:A.
 817          ;输出:无.
 818          ;影响:R0.
 819          ;修改日期:2009.10.28
 820          ;修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 821          ;-------------------------------------------------------------------------------
 822          LCDWC:                                  ;送控制字子程序
 823                  PUSH    ACC
 824                  PUSH    B
 825                  MOV     B,A
 826                  SETB    CSPIN                  ;片选使能
 827                  MOV     A,#0F8H                ;SYNCODE=0F8H,RW=0,RS=0,D0=0
 828                  CALL    TRANSBYTE
 829                  MOV     A,B
 830                  ANL     A,#0F0H
 831                  CALL    TRANSBYTE              ;D7D6D5D4 0000
 832                  MOV     A,B
 833                  SWAP    A
 834                  ANL     A,#0F0H
 835                  CALL    TRANSBYTE              ;D3D2D1D0 0000
 836                  CLR     CSPIN                  ;片选禁止
 837                  POP     B
 838                  POP     ACC
 839                  RET
 840          ;-------------------------------------------------------------------------------
 841          ;子程序名称:LCDWD(A).
 842          ;功能:送数据到液晶显示控制器.
