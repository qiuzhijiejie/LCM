 642                  ADD     A,#08H
 643                  MOV     R4,A
 644                  MOV     A,GXPOS                 ;GXPOS+=8
 645                  ADD     A,#08H
 646                  MOV     GXPOS,A
 647          
 648                  MOV     A,R6                    ;XSIZE与LX比较
 649                  XRL     A,R4
 650                  JZ      PIM_PBX                 ;XSIZE=LX
 651                  JMP     PIM_PB                  ;XSIZE<>LX
 652          PIM_PBX:
 653          
 654                  POP     GXPOS                   ;恢复列首位置
 655          
 656                  INC     GYPOS                   ;位置转下一行
 657                  INC     R5                      ;LY++
 658          
 659                  MOV     A,R7                    ;YSIZE与LY比较
 660                  XRL     A,R5
 661                  JZ      PIM_PAX                 ;YSIZE=LY
C51 COMPILER V9.60.7.0   MAIN                                                              06/21/2025 18:38:06 PAGE 13  

 662                  JMP     PIM_PA                  ;YSIZE<>LY
 663          PIM_PAX:
 664                  RET
