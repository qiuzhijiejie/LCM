 596                  MOV     A,#30H                 ;重复送基本指令集
 597                  CALL    LCDWC
 598                  CALL    DELAY3MS                ;延时3MS
 599                  MOV     A,#01H                 ;清屏控制字
C51 COMPILER V9.60.7.0   MAIN                                                              06/21/2025 18:38:06 PAGE 12  

 600                  CALL    LCDWC
 601                  CALL    DELAY3MS                ;延时3MS
 602                  CALL    LCDON                  ;字符显示开
 603                  RET
 604          DELAY3MS:                               ;延时3MS子程序
 605                  MOV     R1,#15
