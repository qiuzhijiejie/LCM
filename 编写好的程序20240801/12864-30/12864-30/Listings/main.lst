 666          ;子程序名称:PUTIMAGE(GXPOS,GYPOS,*S).
 667          ;功能:在(GXPOS,GYPOS)位置绘制XSIZE列及YISZE行点阵的图形*(S+2).
 668          ;输入:位置GXPOS,GYPOS;XSIZE=*S,YSIZE=*(S+1),S=DPTR+2.
 669          ;输出:GXPOS=GXPOS+XSIZE;GYPOS=GYPOS+YSIZE.
 670          ;影响:R0,R4,R5,R6,R7.
 671          ;修改日期:2009.7.17
 672          ;修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 673          ;-------------------------------------------------------------------------------
 674          PUTIMAGE:                               ;显示图象子程序,在(XPOS,YPOS)位置显示一幅
 675                                                  ;图象,图象地址指针为DPTR,
 676                                                  ;第2个字节为Y方向点阵数,随后的数据为图象
 677                                                  ;点阵数据.
 678                  CLR     A                       ;图象数据的第1个字节为X方向点阵数
 679                  MOVC    A,@A+DPTR               ;XSIZE=*S
 680                  MOV     R6,A                    ;
 681                  INC     DPTR                    ;S++
 682                  CLR     A                       ;图象数据的第2个字节为Y方向点阵数
 683                  MOVC    A,@A+DPTR               ;YSIZE=*S
 684                  MOV     R7,A                    ;
 685                  INC     DPTR                    ;S++
 686                  CALL    PUTSIZEIMAGE            ;绘制图形
 687                  RET
