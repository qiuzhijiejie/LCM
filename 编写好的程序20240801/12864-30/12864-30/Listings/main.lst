 848          ;-------------------------------------------------------------------------------
 849          LCDWD:                                  ;送数据子程序
 850                  PUSH    ACC
 851                  PUSH    B
 852                  MOV     B,A
 853                  SETB    CSPIN                   ;片选使能
 854                  MOV     A,#0FAH                 ;SYNCODE=0FAH,RW=0,RS=1,D0=0
 855                  CALL    TRANSBYTE
 856                  MOV     A,B
 857                  ANL     A,#0F0H
 858                  CALL    TRANSBYTE               ;D7D6D5D4 0000
 859                  MOV     A,B
 860                  SWAP    A
 861                  ANL     A,#0F0H
 862                  CALL    TRANSBYTE               ;D3D2D1D0 0000
 863                  CLR     CSPIN                   ;片选禁止
 864                  POP     B
 865                  POP     ACC
 866                  RET
