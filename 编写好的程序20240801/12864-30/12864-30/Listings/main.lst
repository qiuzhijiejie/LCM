 697          ;-------------------------------------------------------------------------------
 698          GLCDFILL:                               ;整屏显示A代表的字数据子程序
 699                  MOV     GYPOS,#0                ;第1行位置
 700                  MOV     GXPOS,#0                ;第1列位置
 701          GLF_PB:
 702                  CALL    GLCDPOS
 703                  MOV     R2,#16
 704          GLF_PA: CALL    LCDWD
 705                  DJNZ    R2,GLF_PA
