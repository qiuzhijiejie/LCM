 347          ;-------------------------------------------------------------------------------
 348          ;字符操作区域
 349          ;12864ZK字符区域定义为:
 350          ;   CXPOS(0-15) 对应于第1列到第16列位置,每个字符列位置实际占位8点,总计对应128点
 351          ;   CYPOS(0-3)对应于第1行到第4行,每个行位置实际占位16点,总计对应64点
C51 COMPILER V9.60.7.0   MAIN                                                              06/21/2025 18:38:06 PAGE 8   

 352          ;警告:直接设置CXPOS的位置时,请将CXPOS的值设置为偶数,否则显示的字符值会不正确.
 353          ;-------------------------------------------------------------------------------
 354          ;以下为CHARLCDFILL,PUTSTR,PUTCHAR,SETCHARCGRAM为ST7920兼容芯片的液晶显示控制器
 355          ;的通用子程序
 356          ;-------------------------------------------------------------------------------
 357          ;子程序名称:CHARLCDFILL(A,B).
 358          ;功能:整屏显示A/B表示的字符.
 359          ;输入:A,B.
 360          ;输出:无.
 361          ;影响:R0,R2.
 362          ;修改日期:2009.10.28
 363          ;修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 364          ;-------------------------------------------------------------------------------
 365          CHARLCDFILL:                            ;整屏显示A/B代表的字数据子程序
 366                  MOV     CYPOS,#0                ;第1行位置
 367                  MOV     CXPOS,#0                ;第1列位置
 368          CLF_PA:
 369                  CALL    CHARLCDPOS
 370                  XCH     A,B
 371                  CALL    LCDWD
 372                  XCH     A,B
 373                  CALL    LCDWD
 374                  CALL    CHARCURSORNEXT          ;置字符位置为下一个有效位置
 375                  CALL    CHARCURSORNEXT          ;置字符位置为下一个有效位置
 376                  MOV     R2,CXPOS
 377                  CJNE    R2,#00H,CLF_PA
 378                  MOV     R2,CYPOS
 379                  CJNE    R2,#00H,CLF_PA
 380                  RET
 381          ;-------------------------------------------------------------------------------
 382          ;子程序名称:PUTSTR(*S).
 383          ;功能:写字符串点阵,若*S=0 表示字符串结束.
 384          ;输入:*S.
 385          ;输出:.
 386          ;影响:R0,R1,R2,R3,R4,R5,R6,R7,A,B.
 387          ;修改日期:2009.7.17
 388          ;修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 389          ;-------------------------------------------------------------------------------
 390          PUTSTR:                                 ;显示字符串子程序,字符码为00H时退出
 391                  CALL    GETSTRCHAR
 392                  JZ      PSR_LAX
 393                  CALL    PUTCHAR
 394                  JMP     PUTSTR
 395          PSR_LAX:
 396                  RET
 397          ;-------------------------------------------------------------------------------
 398          ;子程序名称:GETSTRCHAR(*S).
 399          ;功能:读单个字符串字符代码,本子程序仅供PUTSTR使用,若*S<128 表示字符为ASCII码,
 400          ;     A=*S后退出;否则表示为中文汉字代码,B=*S后,再读一个字符置入A中.
 401          ;输入:*S(DPTR).
 402          ;输出:.
 403          ;影响:R0,R1,R2,R3,R4,R5,R6,R7,A,B.
 404          ;修改日期:2009.7.17
 405          ;修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 406          ;-------------------------------------------------------------------------------
 407          GETSTRCHAR:                             ;字符串中取字符码子程序
 408                  MOV     B,#00H
 409                  CLR     A
 410                  MOVC    A,@A+DPTR
 411                  INC     DPTR
 412                  JNB     ACC.7,GSC_LAX
 413                  MOV     B,A
C51 COMPILER V9.60.7.0   MAIN                                                              06/21/2025 18:38:06 PAGE 9   

 414                  CLR     A
 415                  MOVC    A,@A+DPTR
 416                  INC     DPTR
 417          GSC_LAX:
 418                  RET
 419          ;-------------------------------------------------------------------------------
 420          ;子程序名称:PUTCHAR(A,B).
 421          ;功能:在(CXPOS,CYPOS)字符位置写字符A/B.
 422          ;输入:A,B.
 423          ;输出:无.
 424          ;影响:R0.
 425          ;修改日期:2009.10.29
 426          ;修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 427          ;-------------------------------------------------------------------------------
 428          PUTCHAR:                                ;在(CXPOS,CYPOS)字符位置写字符子程序
 429                  PUSH    DPL
 430                  PUSH    DPH
 431                  JNB     B.7,PCR_LAY
 432          ;CHINESE:                               ;高位字节大于128表示为汉字
 433                                                  ;奇数位置判断功能
 434                  PUSH    ACC                     ;写汉字时,CXPOS字符位置在奇数位置,则
 435                  MOV     A,CXPOS                 ;自动补添一个空格对齐后再显示汉字
 436                  JNB     ACC.0,PCR_LDX
 437                  MOV     A,#' '
 438                  CALL    LCDWD
 439                  CALL    CHARCURSORNEXT          ;置字符位置为下一个有效位置
 440          PCR_LDX:
 441                  POP     ACC
 442                  CALL    CHARLCDPOS              ;定位第CXPOS个字符位置的DDRAM地址
 443                  XCH     A,B
 444                  CJNE    A,#0FFH,PCR_LFY
 445                                                  ;若高位字节为0FFH则表示为自定义字符
 446                  CPL     A                       ;则转换为ST7920的字符码
 447                  CALL    LCDWD                   ;写高位字符
 448                  CPL     A
 449                  XCH     A,B
 450                  CALL    CHARCURSORNEXT          ;置字符位置为下一个有效位置
 451                  CPL     A
 452                  CALL    LCDWD                   ;写低位字符
 453                  CPL     A
 454                  JMP     PCR_LFX
 455          PCR_LFY:
 456                  CALL    LCDWD                   ;写高位字符
 457                  XCH     A,B
 458                  CALL    CHARCURSORNEXT          ;置字符位置为下一个有效位置
 459                  CALL    LCDWD                   ;写低位字符
 460          PCR_LFX:
 461                  CALL    CHARCURSORNEXT          ;置字符位置为下一个有效位置
 462                  JMP     PCR_LAX
 463          PCR_LAY:
 464          ;ENGLISH:                               ;高位字节小于128表示为ASCII字符
 465                  CALL    CHARLCDPOS              ;定位第CXPOS个字符位置的DDRAM地址
 466          
 467                  PUSH    B
 468                  MOV     B,CXPOS
 469                  JNB     B.0,PCR_LEY
 470                                                  ;写ASCII字符时,CXPOS字符位置在奇数位置,则
 471                                                  ;重新写高位字符缓冲区内容
 472                  XCH     A,FCHARBUF
 473                  CALL    LCDWD
 474                  XCH     A,FCHARBUF
 475                  CALL    LCDWD                   ;低字节写ASCII字符
C51 COMPILER V9.60.7.0   MAIN                                                              06/21/2025 18:38:06 PAGE 10  

 476                  JMP     PCR_LEX
 477          PCR_LEY:                                ;CXPOS字符位置在偶数位置则
 478                  CALL    LCDWD                   ;高字节写ASCII字符后补显空格
 479                  MOV     FCHARBUF,A
 480                  PUSH    ACC
 481                  MOV     A,#' '                  ;如果为偶数位置,则将奇数位置显示为空格
 482                  CALL    LCDWD
 483                  POP     ACC
 484          PCR_LEX:
 485                  POP     B
 486                  CALL    CHARCURSORNEXT          ;置字符位置为下一个有效位置
 487          
 488          PCR_LAX:
 489                  POP     DPH
 490                  POP     DPL
 491                  RET
 492          ;-------------------------------------------------------------------------------
 493          ;子程序名称:SETCHARCGRAM(A,*S).
 494          ;功能:将DPTR所指32字节数据设置到自定义字符A(0-3)的CGRAM中.
 495          ;输入:A,DPTR.
 496          ;输出:无.
 497          ;影响:R0,R2,A.
 498          ;修改日期:2009.10.28
 499          ;修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 500          ;-------------------------------------------------------------------------------
 501          SETCHARCGRAM:
 502                  PUSH    ACC
 503                  MOV     A,#34H
 504                  CALL    LCDWC                   ;扩充指令集,图形模式关闭
 505                  MOV     A,#02H
 506                  CALL    LCDWC                   ;SR=0 激活CGRAM
 507                  MOV     A,#30H
 508                  CALL    LCDWC                  ;恢复为基本指令集
 509                  POP     ACC
 510                  ANL     A,#03H
 511                  SWAP    A
 512                  ORL     A,#40H
 513                  CALL    LCDWC                   ;设置CGRAM地址
 514                  MOV     R2,#32
 515          SCG_PA:
 516                  CLR     A
 517                  MOVC    A,@A+DPTR
 518                  CALL    LCDWD
 519                  INC     DPTR
 520                  DJNZ    R2,SCG_PA
 521                  RET
 522          ;-------------------------------------------------------------------------------
 523          ;以下为CHARLCDPOS,CHARCURSORNEXT,LCDRESET为ST7920兼容芯片的液晶显示控制器的
 524          ;16ASCII字符X4行的SMG12864系列标准中文字符点阵型液晶显示模块的接口程序.
 525          ;-------------------------------------------------------------------------------
 526          ;子程序名称:CHARLCDPOS().
 527          ;功能:设置(CXPOS,CYPOS)字符位置的DDRAM地址.
 528          ;输入:无.
 529          ;输出:无.
 530          ;影响:无.
 531          ;修改日期:2009.10.28
 532          ;修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 533          ;-------------------------------------------------------------------------------
 534          CHARLCDPOS:                             ;设置(CXPOS,CYPOS)字符位置的DDRAM地址
 535                  PUSH    ACC                     ;保护ACC的值
 536                  ANL     CXPOS,#0FH              ;X位置范围(0到15)
 537                  MOV     A,CXPOS
C51 COMPILER V9.60.7.0   MAIN                                                              06/21/2025 18:38:06 PAGE 11  

 538                  CLR     C
 539                  RRC     A
 540                  MOV     R0,A
 541                  MOV     A,CYPOS
 542                  CJNE    A,#0,LPS_LA1
 543                  MOV     A,#80H                  ;第一行 DDRAM:80H--87H
 544                  ADD     A,R0
 545                  JMP     LPS_LAX
 546          LPS_LA1:CJNE    A,#1,LPS_LA2
 547                  MOV     A,#90H                  ;第二行 DDRAM:90H--97H
 548                  ADD     A,R0
 549                  JMP     LPS_LAX
 550          LPS_LA2:CJNE    A,#2,LPS_LA3
 551                  MOV     A,#88H                  ;第三行 DDRAM:88H--8FH
 552                  ADD     A,R0
 553                  JMP     LPS_LAX
 554          LPS_LA3:CJNE    A,#3,LPS_LAX
 555                  MOV     A,#98H                  ;第四行 DDRAM:98H--9FH
 556                  ADD     A,R0
 557                  JMP     LPS_LAX
 558          LPS_LAX:                                ;
 559                  CALL    LCDWC
 560                  POP     ACC                     ;恢复ACC的值
 561                  RET
 562          ;-------------------------------------------------------------------------------
 563          ;子程序名称:CHARCURSORNEXT().
 564          ;功能:置字符位置为下一个有效位置.
 565          ;输入:无.
 566          ;输出:无.
 567          ;影响:R0.
 568          ;修改日期:2009.10.28
 569          ;修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 570          ;-------------------------------------------------------------------------------
 571          CHARCURSORNEXT:                         ;置字符位置为下一个有效位置子程序
 572                  INC     CXPOS                   ;字符位置加1
 573                  ANL     CXPOS,#0FH              ;字符位置CXPOS的有效范围为(0到15)
 574                  MOV     R0,CXPOS
 575                  CJNE    R0,#0,CSN_LAX           ;CXPOS为0表示要换行
 576                  INC     CYPOS
 577                  ANL     CYPOS,#03H              ;字符位置CYPOS的有效范围为(0到3)
 578          CSN_LAX:
 579                  RET
