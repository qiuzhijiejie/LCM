 183          ascll：一个指向ASCII字符数组（字符串）的指针，即要显示的字符串内容。
 184          */
 185          void Display_Str(uchar x,uchar y,uchar *ascll)
 186          {
 187   1              Locatexy(x,y,Character);
 188   1              while(*ascll>0)//=!\0
 189   1              {
 190   2                      WriteCommand(*ascll-0x20,0,0xc0,1 );//Table 6-19-Data Write and Increment ADP  
 191   2                      ascll++;//*ascll - 0x20 将其转换为LCD可以识别的字符编码
 192   2              } 
 193   1              
 194   1      }
