 520   2              case 8: DisplayBMP(0, 0, 240, 128, BMP1); Delay(2000); break;
 521   2              case 9: ReverseDisplayBMP(0, 0, 240, 128, BMP1); Delay(2000); break;
 522   2              case 10: ReverseDisplayBMP(0, 0, 240, 128, BMP0); Delay(2000); break;
 523   2          }
