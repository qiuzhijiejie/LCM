 154          /*
 155          光标位置，支持图形模式和字符模式
 156          x：光标的横坐标（列数）。
 157          y：光标的纵坐标（行数）。
 158          mode：操作模式，决定是图形模式还是字符模式：
 159          mode = 1：图形模式。
 160          mode = 0：字符模式。
 161          */
 162          void Locatexy(uchar x,uchar y,uchar mode)   
 163          {  uint a=0;
 164   1              if(mode)                                //Graphic mode   x=0-29  y=0-127    START ADDRESS ：0800
 165   1              {
 166   2                      a=y*30+x;                              
 167   2                      WriteCommand((uchar)a,(uchar)(a>>8)+0x08,0x24,2);//a 是一个 16 位的整数，
 168   2      //                                                                 包含了高位和低位
 169   2              }
 170   1      
 171   1              else                                    //Character mode   x=0-29  y=0-15    START ADDRESS ：0000
 172   1              {
 173   2                      a=y*30+x;                             //0x24-Set Address Pointer-Table 6-6 
 174   2                      WriteCommand((uchar)(a),(uchar)(a>>8),0x24,2);
 175   2              }
 176   1      }
