 306          */
 307          void Display_16_16(uchar x,uchar y,uchar  code *Chinese_character,uchar character_code)
 308          {       
 309   1      
 310   1              uchar j;    // 行循环控制变量
 311   1          uint num = 0;  // 偏移量初始为0
