 382          /* 
 383          函数用于在LCD屏幕的指定位置绘制位图图像
 384          x:图像在LCD屏幕上的起始横坐标
 385          y:图像在LCD屏幕上的起始纵坐标
 386          W:图像的宽度（以像素为单位）
 387          H:图像的高度（以像素为单位）
 388          puts：指向位图图像数据的指针,数据以位为单位
 389          */
 390          void DisplayBMP(uchar x,uchar y,uchar W,uchar H,  uchar code *puts )   
 391          {       uchar k,j;
 392   1              Locatexy(x,y,Graphic); 
 393   1                      for(j = 0; j < H; j++)  // 遍历每一行
 394   1              {
 395   2                      WriteCommand(0, 0, 0xb0, 0);  // 进入数据自动写入模式
 396   2                      for(k = 0; k < W/8; k++)  // 每行遍历W/8个字节（8个像素为1字节）
 397   2                      {
 398   3                              WriteData(*puts++);  // 逐字节写入图像数据
 399   3                      }
 400   2                      WriteCommand(0, 0, 0xb2, 0);  // 退出数据自动写入模式
 401   2                      y += 1;  // 移动到下一行
 402   2                      Locatexy(x, y, Graphic);  // 更新光标位置
 403   2              }
 404   1        
 405   1      } 
 406          //图片取反
 407          void ReverseDisplayBMP(uchar x,uchar y,uchar W,uchar H,  uchar code *puts )   
 408          {       uchar i,j;
 409   1              Locatexy(x,y,Graphic); 
 410   1            
 411   1              for(j=0;j<H;j++)
 412   1                      {       WriteCommand(0,0,0xb0,0 ); 
 413   2                              for(i=0;i<W/8;i++)
 414   2                              {
 415   3                                      WriteData(~(*puts));//取反
 416   3                                      puts++;
 417   3                              } 
 418   2                      WriteCommand(0,0,0xb2,0 ); 
 419   2                              y+=1;
 420   2                              Locatexy(x,y,Graphic);
 421   2                      }  
 422   1      } 
