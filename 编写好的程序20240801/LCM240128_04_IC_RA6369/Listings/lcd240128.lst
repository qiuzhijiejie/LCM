 117          parameters_num: 参数数量，指定要发送的数据字节数（1或2）。
 118          */
 119          void WriteCommand( uchar dat1,uchar dat2,uchar command,uchar parameters_num )   
 120          {   
 121   1        if((parameters_num==1)|(parameters_num==2))
 122   1              {
 123   2                      CheckBusy();    
 124   2                  WriteData(dat1);
 125   2              }
 126   1              
 127   1        if(parameters_num==2)
 128   1              {
 129   2                      CheckBusy();    
 130   2                  WriteData(dat2);
 131   2              }
 132   1      
 133   1              AUTOWRITE_CheckBus();//写检测忙信号
 134   1              
 135   1              LCD_CD = 1;   
 136   1              DataBus = command; 
 137   1              LCD_WR = 0; 
 138   1              _nop_();     
 139   1              LCD_WR  = 1;      
 140   1      }
