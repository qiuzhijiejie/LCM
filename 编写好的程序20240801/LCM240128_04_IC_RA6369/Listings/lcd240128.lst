 196          void Display_FullCGROM()
 197          {
 198   1          uchar x = 0, y = 0;       // 起始位置 (0, 0)
 199   1          uchar charCode = 0x01;    // 从 CGROM 的 0x01 开始
 200   1      
 201   1          // 遍历整个 LCD240128 屏幕 (30 列 x 16 行)
 202   1          while (y < 16)
 203   1          {
 204   2              Locatexy(x, y, Character);  // 设置光标位置
 205   2      
 206   2              // 显示当前的 CGROM 字符
 207   2              WriteCommand(charCode, 0, 0xc0, 1);  // 发送当前字符的代码到 LCD
 208   2      
 209   2              // 更新位置和字符
 210   2              x++;             // 移动到下一列
 211   2              charCode++;      // 显示下一个字符
 212   2      
 213   2      
 214   2              if (x >= 30)
 215   2              {
 216   3                  x = 0;       // 列回到 0
 217   3                  y++;         // 行数增加，换行
 218   3              }
 219   2      
 220   2      
 221   2              if (charCode > 0xFF)
 222   2              {
 223   3                  charCode = 0x01;
 224   3                              break;
 225   3              }
 226   2                      
 227   2          }
 228   1              Display_Str(0,8,"ABCDEFGopkrst435"); 
 229   1              Display_FullCGROM_SpecifiedPositions();
 230   1              Display_FullCGROM_SpecifiedPositions2();
 231   1      }
