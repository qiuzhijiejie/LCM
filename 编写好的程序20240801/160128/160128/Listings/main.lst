 393          //-------------------------------------------------------------------------------
 394          //子程序名称:void putchar(unsigned int c).
 395          //功能:在(XPOS,YPOS)位置写单个字符点阵,若c>128 表示为中文字符,否则为西文字符
 396          //修改日期:2009.8.18
 397          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 398          //-------------------------------------------------------------------------------
 399          void putchar(unsigned int c)            //定位写字符子程序
 400          {   if(c>128)
 401   1              putsizeimage(CHINESECHARSIZE,CHINESECHARSIZE,getchinesecodepos(c));
 402   1          else
 403   1              putsizeimage(ENGLISHCHARSIZE,CHINESECHARSIZE,getenglishcodepos(c));
 404   1      }
 405          //-------------------------------------------------------------------------------
 406          //子程序名称:void putstr(unsigned char code *s).
 407          //功能:写字符串点阵,若*s=0 表示字符串结束.
 408          //修改日期:2009.8.18
 409          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 410          //-------------------------------------------------------------------------------
 411          void putstr(unsigned char code *s)      //显示字符串子程序,字符码为0时退出
 412          {   unsigned int c;
 413   1          while(1)
 414   1          {   c=*s;
 415   2              s++;
 416   2              if(c==0) break;
 417   2              if(c<128)
 418   2                  putchar(c);
 419   2              else
 420   2              {   putchar(c*256+*s);
 421   3                  s++;
 422   3              }
 423   2          }
 424   1      }
 425          //-------------------------------------------------------------------------------
 426          //子程序名称:unsigned char code *getchinesecodepos(unsigned char ac).
C51 COMPILER V9.60.7.0   MAIN                                                              09/14/2025 21:54:32 PAGE 8   

 427          //功能:根据当前中文字符码查表后计算得到当前中文字符码的字库点阵位置.
 428          //修改日期:2009.8.18
 429          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 430          //-------------------------------------------------------------------------------
 431          unsigned char code *getchinesecodepos(unsigned int ac)
 432          {   unsigned int min,max,mid,midc;
 433   1          min=0;
 434   1          max=CHINESECHARNUMBER-1;
 435   1          while(1)
 436   1          {   if(max-min<2)
 437   2              {   if(ChineseCode[min]==ac)
 438   3                      mid=min;
 439   3                  else if(ChineseCode[max]==ac)
 440   3                      mid=max;
 441   3                  else
 442   3                      mid=0;
 443   3                  break;
 444   3              }
 445   2              mid=(max+min)/2;
 446   2              midc=ChineseCode[mid];
 447   2              if(midc==ac)
 448   2                  break;
 449   2              else if(midc>ac)
 450   2                  max=mid-1;
 451   2              else
 452   2                  min=mid+1;
 453   2          }
 454   1          return ChineseCharDot+mid*CHINESECHARDOTSIZE;
 455   1      }
