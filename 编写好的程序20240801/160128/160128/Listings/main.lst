 467   1          {   if(max-min<2)
 468   2              {   if(EnglishCode[min]==ac)
 469   3                      mid=min;
 470   3                  else if(EnglishCode[max]==ac)
 471   3                      mid=max;
 472   3                  else
 473   3                      mid=0;
 474   3                  break;
 475   3              }
 476   2              mid=(max+min)/2;
 477   2              midc=EnglishCode[mid];
 478   2              if(midc==ac)
 479   2                  break;
 480   2              else if(midc>ac)
 481   2                  max=mid-1;
 482   2              else
 483   2                  min=mid+1;
 484   2          }
 485   1          return EnglishCharDot+mid*ENGLISHCHARDOTSIZE;
 486   1      }
