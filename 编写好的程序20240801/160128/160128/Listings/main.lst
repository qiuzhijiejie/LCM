 489          //-------------------------------------------------------------------------------
 490          //子程序名称:void putsizeimage(unsigned char XSIZE,unsigned YSIZE,
 491          //                             unsigned char code *s)
 492          //功能:在(XPOS,YPOS)位置绘制XSIZE列及YISZE行点阵的图形*S.
 493          //修改日期:2009.8.17
 494          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 495          //-------------------------------------------------------------------------------
 496          void putsizeimage(unsigned char XSIZE,unsigned char YSIZE,unsigned char code *s)
 497          {  unsigned char k,lx,ly,a1,a2,x,Lcd_Mask;
 498   1         k=XPOS&0x7;
 499   1         XSIZE+=k;
 500   1         x=XPOS;
 501   1         s--;
 502   1         for(ly=0;ly<YSIZE;ly++,YPOS++)
 503   1         {  for(XPOS=x,lx=k;lx<XSIZE;)
 504   2            {  unsigned char p;
 505   3               a1=*s;
 506   3               s++;
 507   3               a2=*s;
 508   3               if(CharImageReverse)
 509   3               {   a1=~a1;
 510   4                   a2=~a2;
 511   4               }
 512   3               for(p=0;p<k;p++)
 513   3               {  a2>>=1;
 514   4                  if((a1&0x1)==1)
 515   4                     a2+=0x80;
 516   4                  a1>>=1;
 517   4               }
 518   3               if((k==0) && (XSIZE<lx+8))
 519   3               {   lcdpos();
 520   4                   lx+=8;
 521   4                   XPOS+=8;
 522   4               }
 523   3               else
 524   3               {   lcdpos();
 525   4                   a1=lcdrd();
 526   4                   lcdpos();
 527   4                   lx+=8;
 528   4                   XPOS+=8;
 529   4                   Lcd_Mask=0xff;
 530   4                   p=XSIZE&0x7;
 531   4                   while(p>0)
 532   4                   {   Lcd_Mask>>=1;
 533   5                       XPOS--;
 534   5                       p--;
 535   5                   }
 536   4                   p=0xff;
 537   4                   while(XSIZE<lx)
 538   4                   {   lx--;
 539   5                       XPOS--;
 540   5                       p<<=1;
 541   5                   }
 542   4                   Lcd_Mask&=p;
 543   4                   a2&=Lcd_Mask;
 544   4                   a2|=a1&(~Lcd_Mask);
 545   4               }
 546   3               lcdwd(a2);
 547   3            }
 548   2            if((k!=0) && (XSIZE&0x7 != 0) && (k >= XSIZE&0x7)) s--;
 549   2         }
 550   1         if(XDOTS-x < XSIZE-k)
C51 COMPILER V9.60.7.0   MAIN                                                              09/14/2025 21:54:32 PAGE 10  

 551   1             XPOS=0;
 552   1         else
 553   1             YPOS-=YSIZE;
 554   1      }
