 570          //以下point为绘图操作的基本子程序,line,lineto,rect为绘图操作的扩充子程序.
 571          //-------------------------------------------------------------------------------
 572          //子程序名称:void point(bit b).
 573          //功能:按b的数据在(XPOS,YPOS)位置绘制点.
 574          //修改日期:2009.8.18
 575          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 576          //-------------------------------------------------------------------------------
 577          void point(bit b)
 578          {   unsigned char i,Lcd_Mask,j;
 579   1          Lcd_Mask=0x80;
 580   1          i=XPOS&0x7;
 581   1          while(i>0)
 582   1          {   Lcd_Mask>>=1;
 583   2              i--;
 584   2          }
 585   1          lcdpos();
 586   1          j=lcdrd();
 587   1          lcdpos();
 588   1          if(b)
 589   1              lcdwd(j|Lcd_Mask);
 590   1          else
 591   1              lcdwd(j&(~Lcd_Mask));
 592   1      }
 593          //-------------------------------------------------------------------------------
 594          //子程序名称:void line(unsigned char x0,unsigned char y0,unsigned char x1,unsigned char y1,bit b)
