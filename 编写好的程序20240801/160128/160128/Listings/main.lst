 613   2          }
 614   1          else if (dx>dy)
 615   1          {   dk=dy;
 616   2              dy=0;
 617   2              while(XPOS!=x1)
 618   2              {   if(x1>x0) XPOS++;else XPOS--;
 619   3                  dy++;
 620   3                  if(y1>y0) YPOS=y0+(dk*dy+dx/2)/dx;else YPOS=y0-(dk*dy+dx/2)/dx;
 621   3                  point(b);
 622   3              }
 623   2          }
 624   1          else
 625   1          {   dk=dx;
 626   2              dx=0;
 627   2              while(YPOS!=y1)
 628   2              {   if(y1>y0) YPOS++;else YPOS--;
 629   3                  dx++;
 630   3                  if(x1>x0) XPOS=x0+(dk*dx+dy/2)/dy;else XPOS=x0-(dk*dx+dy/2)/dy;
 631   3                  point(b);
 632   3              }
 633   2          }
 634   1      }
