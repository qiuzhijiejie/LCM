 780          {   lcdwaitidle();                      //检测液晶显示控制器是否空闲
 781   1          P1=d;
 782   1          CDPIN=0;                            //CD=0 CE=0 WR=0
 783   1          CEPIN=0;
 784   1          WRPIN=0;
 785   1          _nop_();
 786   1          WRPIN=1;
 787   1          CEPIN=1;
 788   1      }
