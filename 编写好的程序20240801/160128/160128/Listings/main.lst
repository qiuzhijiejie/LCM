 759          //-------------------------------------------------------------------------------
 760          unsigned char lcdrdata(void)            //读数据子程序
 761          {   unsigned char d;
 762   1          lcdwaitidle();                      //检测液晶显示控制器是否空闲
 763   1          P1=0xff;
 764   1          CDPIN=0;                            //CD=0 CE=0 RD=0
