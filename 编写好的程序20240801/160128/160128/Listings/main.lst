 598          //-------------------------------------------------------------------------------
 599          void line(unsigned char x0,unsigned char y0,unsigned char x1,unsigned char y1,bit b)
 600          {   unsigned char dx,dy;
 601   1          unsigned int dk;
 602   1          XPOS=x0;
 603   1          YPOS=y0;
 604   1          point(b);
 605   1          dx=(x1>=x0)?x1-x0:x0-x1;
 606   1          dy=(y1>=y0)?y1-y0:y0-y1;
 607   1          if(dx==dy)
 608   1          {   while(XPOS!=x1)
 609   2              {   if(x1>x0) XPOS++;else XPOS--;
 610   3                  if(y1>y0) YPOS++;else YPOS--;
 611   3                  point(b);
 612   3              }
