 790          //子程序名称:voidlcdwaitidle(void).
 791          //功能:忙检测,在对液晶显示控制器操作的每一条指令之前,需检测液晶显示器是否空闲.
 792          //修改日期:2009.08.07
 793          //修改人:chujianjun@sunman.cn,tanchao@sunman.cn
 794          //-------------------------------------------------------------------------------
 795          void lcdwaitidle(void)                  //忙检测子程序
 796          {   unsigned char i,d;
 797   1          P1=0xff;
 798   1          CDPIN=1;                            //CD=1 CE=0 RD=0
C51 COMPILER V9.60.7.0   MAIN                                                              09/14/2025 21:54:32 PAGE 14  

 799   1          CEPIN=0;
 800   1          for(i=0;i<20;i++)                   //
 801   1          {   RDPIN=0;
 802   2              _nop_();
 803   2              d=P1;
 804   2              RDPIN=1;
 805   2              if( (d&0x3) == 0x3 ) break;     //D0D1=11 空闲退出
 806   2          }
 807   1          CEPIN=1;
 808   1      }


