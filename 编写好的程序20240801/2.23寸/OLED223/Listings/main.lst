 187          //写入  最后将SDA拉高，以等待从设备产生应答
 188          void IIC_write(unsigned char date)
 189          {
 190   1              unsigned char i, temp;
 191   1              temp = date;
 192   1                              
 193   1              for(i=0; i<8; i++)
 194   1              {       IIC_SCK_0;
 195   2                      
 196   2                      if ((temp&0x80)==0)
 197   2                        IIC_SDA_0;
 198   2                      else IIC_SDA_1;
 199   2                      temp = temp << 1;
 200   2                                                        //最少250ns延时
 201   2                      IIC_SCK_1;
 202   2                      
 203   2              }
 204   1              IIC_SCK_0;
 205   1              
 206   1              IIC_SDA_1;
 207   1              
 208   1              IIC_SCK_1;
 209   1              
 210   1               ACK =0;
 211   1              IIC_SCK_0;
 212   1              
 213   1      
 214   1      }
