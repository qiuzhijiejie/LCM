  67          void BusyL(void)   
  68          {unsigned char flag=0xff;  
  69   1       CS1= 1;       //active "H"
  70   1       CS2= 0;   
  71   1       RS = 0;   
  72   1       RW = 1;  
  73   1      
  74   1       P1 = 0xFF; 
  75   1      while ((flag&0x80)==0x80)
  76   1       {
  77   2       E=1;
  78   2       _nop_();
  79   2       flag=P1;
  80   2       E=0;
  81   2       }    
  82   1      }   
  83             
  84          void BusyR(void)   
  85          { unsigned char flag=0xff;  
  86   1       CS1= 0;   
  87   1       CS2= 1;        //active "H"
  88   1       RS = 0;    
  89   1       RW = 1; 
  90   1      
  91   1       P1 = 0xFF;  
  92   1      while ((flag&0x80)==0x80)
  93   1       {
  94   2       E=1;
  95   2       _nop_();
  96   2       flag=P1;
  97   2       E=0;
  98   2       }  
  99   1      }   
