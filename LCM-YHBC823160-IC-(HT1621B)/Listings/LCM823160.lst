  94   2                      LCDDATA=0;
  95   2                      LCDWR=0;
  96   2                      _nop_();
  97   2                      _nop_();                
  98   2                      LCDWR=1;
  99   2              }
 100   1              for(x=0; x<8; x++)
 101   1              {
 102   2                      if(com&0x80)
 103   2                              LCDDATA = 1;
 104   2                      else
 105   2                              LCDDATA = 0;
 106   2      
 107   2                      LCDWR=0;        
 108   2                      _nop_();
 109   2              _nop_();        
 110   2                      LCDWR=1;
 111   2                      com <<= 1; 
 112   2              }
 113   1              LCDDATA=1;
 114   1              LCDWR=0;
 115   1              _nop_();
 116   1          _nop_();
