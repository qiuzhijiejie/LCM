 137   2      
 138   2                      LCDWR=0;
 139   2                      _nop_();
 140   2              _nop_();
 141   2                      LCDWR=1;
 142   2      
 143   2                      add1 <<= 1; 
 144   2              }
 145   1              for(y=0;y<4;y++)
