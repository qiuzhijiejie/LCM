 206          void display_digits_simple()
 207          {
 208   1          unsigned char addr;
 209   1          int i, j;
 210   1      
 211   1          for (i = 0; i < 10; i++)  // 显示0~9
 212   1          {
 213   2              j = 0;
 214   2              while (digits[i][j] != 0xFF)  // 以 0xFF 结尾
 215   2              {
 216   3                  unsigned char start = digits[i][j++];
 217   3                  unsigned char end   = digits[i][j++];
 218   3                  unsigned char lbyte = digits[i][j++];
 219   3                  unsigned char rbyte = digits[i][j++];
 220   3      
 221   3                  for (addr = start; addr <= end; addr += 2)
 222   3                  {
 223   4                      write_data(addr,     lbyte);
 224   4                      write_data(addr + 1, rbyte);
 225   4                  }
 226   3              }
 227   2              delay(2000);
 228   2          }
 229   1      }


