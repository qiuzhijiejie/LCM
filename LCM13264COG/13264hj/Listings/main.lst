  79          void transfer_command(int data1)
  80          
  81          {
  82   1      char i;
  83   1      cs1=0;
  84   1      rs=0;
  85   1      for(i=0;i<8;i++)
  86   1      {
  87   2      lcd_sclk=0;
  88   2      //delay_us(10); //加少量延时
  89   2      if(data1&0x80) lcd_sid=1;
  90   2      else lcd_sid=0;
  91   2      lcd_sclk=1;
  92   2      //delay_us(10); //加少量延时
  93   2      data1=data1<<=1;
  94   2      }
  95   1      cs1=1;
  96   1      }
