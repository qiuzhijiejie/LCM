 159          /*LCD 模块初始化*/
 160          void initial_lcd()
 161          {
 162   1      cs1=0;
 163   1      reset=0; /*低电平复位*/
 164   1      delay(20);
 165   1      reset=1; /*复位完毕*/
 166   1      delay(20);
 167   1      transfer_command(0xe2); /*软复位*/
 168   1      delay(50);
 169   1      transfer_command(0x2c); /*升压步聚1*/
 170   1      delay(50);
 171   1      transfer_command(0x2e); /*升压步聚2*/
 172   1      delay(50);
 173   1      transfer_command(0x2f); /*升压步聚3*/
 174   1      delay(50);
 175   1      transfer_command(0x24); /*粗调对比度，可设置范围0x20～0x27*/
 176   1      transfer_command(0x81); /*微调对比度*/
 177   1      transfer_command(0x28); /*0x1a,微调对比度的值，可设置范围0x00～0x3f 1f*/
 178   1      transfer_command(0xa2); /*1/9 偏压比（bias）*/
C51 COMPILER V9.60.7.0   MAIN                                                              03/27/2025 09:27:20 PAGE 4   

 179   1      transfer_command(0xc8); /*行扫描顺序：从上到下*/
 180   1      transfer_command(0xa0); /*列扫描顺序：从左到右*/
 181   1      transfer_command(0x60); /*起始行：第一行开始*/
 182   1      transfer_command(0xaf); /*开显示*/
 183   1      cs1=1;
 184   1      }
