 187          void lcd_address(uchar page,uchar column)
 188          {
 189   1      
 190   1      cs1=0;
 191   1      column=column; //
 192   1      page=page-1;
 193   1      transfer_command(0xb0+page); 
 194   1      transfer_command(((column>>4)&0x0f)+0x10); //设置列地址的高4 位
 195   1      transfer_command(column&0x0f); //设置列地址的低4 位
 196   1      }
