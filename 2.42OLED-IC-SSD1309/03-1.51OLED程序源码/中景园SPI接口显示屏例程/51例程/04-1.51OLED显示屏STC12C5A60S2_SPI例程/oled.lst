 118          //在指定位置显示一个字符,包括部分字符
 119          //x:0~127
 120          //y:0~63                                 
 121          //sizey:选择字体 6x8  8x16
 122          void OLED_ShowChar(u8 x,u8 y,u8 chr,u8 sizey)
 123          {       
 124   1              u8 c=0,sizex=sizey/2;
 125   1              u16 i=0,size1;
 126   1              if(sizey==8)size1=6;
 127   1              else size1=(sizey/8+((sizey%8)?1:0))*(sizey/2);
 128   1              c=chr-' ';//得到偏移后的值
 129   1              OLED_Set_Pos(x,y);
 130   1              for(i=0;i<size1;i++)
 131   1              {
 132   2                      if(i%sizex==0&&sizey!=8) OLED_Set_Pos(x,y++);
 133   2                      if(sizey==8) OLED_WR_Byte(asc2_0806[c][i],OLED_DATA);//6X8字号
 134   2                      else if(sizey==16) OLED_WR_Byte(asc2_1608[c][i],OLED_DATA);//8x16字号
 135   2      //              else if(sizey==xx) OLED_WR_Byte(asc2_xxxx[c][i],OLED_DATA);//用户添加字号
 136   2                      else return;
 137   2              }
 138   1      }
 139          //m^n函数
 140          u32 oled_pow(u8 m,u8 n)
 141          {
 142   1              u32 result=1;    
 143   1              while(n--)result*=m;    
 144   1              return result;
 145   1      }                                 
 146          //显示数字
 147          //x,y :起点坐标
 148          //num:要显示的数字
 149          //len :数字的位数
 150          //sizey:字体大小                  
 151          void OLED_ShowNum(u8 x,u8 y,u32 num,u8 len,u8 sizey)
 152          {               
 153   1              u8 t,temp,m=0;
 154   1              u8 enshow=0;
 155   1              if(sizey==8)m=2;
 156   1              for(t=0;t<len;t++)
 157   1              {
 158   2                      temp=(num/oled_pow(10,len-t-1))%10;
 159   2                      if(enshow==0&&t<(len-1))
 160   2                      {
 161   3                              if(temp==0)
 162   3                              {
 163   4                                      OLED_ShowChar(x+(sizey/2+m)*t,y,' ',sizey);
 164   4                                      continue;
 165   4                              }else enshow=1;
 166   3                      }
 167   2                      OLED_ShowChar(x+(sizey/2+m)*t,y,temp+'0',sizey);
 168   2              }
 169   1      }
 170          //显示一个字符号串
 171          void OLED_ShowString(u8 x,u8 y,u8 *chr,u8 sizey)
 172          {
 173   1              u8 j=0;
 174   1              while (chr[j]!='\0')
 175   1              {               
 176   2                      OLED_ShowChar(x,y,chr[j++],sizey);
 177   2                      if(sizey==8)x+=6;
 178   2                      else x+=sizey/2;
