  85          void OLED_Set_Pos(u8 x, u8 y) 
  86          { 
  87   1              OLED_WR_Byte(0xb0+y,OLED_CMD);
  88   1              OLED_WR_Byte(((x&0xf0)>>4)|0x10,OLED_CMD);
  89   1              OLED_WR_Byte((x&0x0f),OLED_CMD);
  90   1      }         
