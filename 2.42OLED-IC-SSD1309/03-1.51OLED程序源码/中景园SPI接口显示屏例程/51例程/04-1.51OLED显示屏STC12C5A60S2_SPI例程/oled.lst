 216          //初始化                                    
 217          void OLED_Init(void)
 218          {
 219   1              OLED_RES_Clr();
 220   1        delay_ms(20);
 221   1              OLED_RES_Set();
 222   1              
 223   1              OLED_WR_Byte(0xAE,OLED_CMD);//--turn off oled panel
 224   1              OLED_WR_Byte(0xFD,OLED_CMD);
 225   1              OLED_WR_Byte(0x12,OLED_CMD);
 226   1              OLED_WR_Byte(0xd5,OLED_CMD);//--set display clock divide ratio/oscillator frequency
 227   1              OLED_WR_Byte(0xA0,OLED_CMD);
 228   1              OLED_WR_Byte(0xA8,OLED_CMD);//--set multiplex ratio(1 to 64)
 229   1              OLED_WR_Byte(0x3f,OLED_CMD);//--1/64 duty
 230   1              OLED_WR_Byte(0xD3,OLED_CMD);//-set display offset       Shift Mapping RAM Counter (0x00~0x3F)
 231   1              OLED_WR_Byte(0x00,OLED_CMD);//-not offset
 232   1              OLED_WR_Byte(0x40,OLED_CMD);//--set start line address  Set Mapping RAM Display Start Line (0x00~0x3F)
 233   1              OLED_WR_Byte(0xA1,OLED_CMD);//--Set SEG/Column Mapping     0xa0左右反置 0xa1正常
 234   1              OLED_WR_Byte(0xC8,OLED_CMD);//Set COM/Row Scan Direction   0xc0上下反置 0xc8正常
 235   1              OLED_WR_Byte(0xDA,OLED_CMD);//--set com pins hardware configuration
 236   1              OLED_WR_Byte(0x12,OLED_CMD);
 237   1              OLED_WR_Byte(0x81,OLED_CMD);//--set contrast control register
 238   1              OLED_WR_Byte(0xBF,OLED_CMD);// Set SEG Output Current Brightness
 239   1              OLED_WR_Byte(0xD9,OLED_CMD);//--set pre-charge period
 240   1              OLED_WR_Byte(0x25,OLED_CMD);//Set Pre-Charge as 15 Clocks & Discharge as 1 Clock
C51 COMPILER V9.60.7.0   OLED                                                              06/26/2025 15:47:14 PAGE 5   

 241   1              OLED_WR_Byte(0xDB,OLED_CMD);//--set vcomh
 242   1              OLED_WR_Byte(0x34,OLED_CMD);//Set VCOM Deselect Level
 243   1              OLED_WR_Byte(0xA4,OLED_CMD);// Disable Entire Display On (0xa4/0xa5)
 244   1              OLED_WR_Byte(0xA6,OLED_CMD);// Disable Inverse Display On (0xa6/a7)
 245   1              OLED_Clear();
 246   1              OLED_WR_Byte(0xAF,OLED_CMD);
