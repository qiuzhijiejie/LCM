  57          void OLED_WR_Byte(u8 dat,u8 cmd)
  58          {       
  59   1              u8 i;                     
  60   1              if(cmd)
  61   1                OLED_DC_Set();
  62   1              else 
  63   1                OLED_DC_Clr();                  
  64   1              OLED_CS_Clr();
  65   1              for(i=0;i<8;i++)
  66   1              {                         
  67   2                      OLED_SCL_Clr();
  68   2                      if(dat&0x80)
  69   2                      {
  70   3                       OLED_SDA_Set();
  71   3                      }
  72   2                      else
  73   2                      {
  74   3                       OLED_SDA_Clr();
  75   3                      }
  76   2                OLED_SCL_Set();
  77   2                      dat<<=1;   
  78   2              }                                                 
  79   1              OLED_CS_Set();
  80   1              OLED_DC_Set();            
  81   1      } 
