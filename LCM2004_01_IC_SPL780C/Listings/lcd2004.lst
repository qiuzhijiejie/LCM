  59          void LCD_WriteCommand(unsigned char Command) 
  60          {
  61   1              Busy();
  62   1          LCD_RS = 0; // 选择为指令，1为数据，0为指令
  63   1          LCD_RW = 0; // 选择为写， 1为读，0为写
