 279          void displayCustomCharacter1(const unsigned char pattern[8]) 
 280          {
 281   1          unsigned char row, col;
 282   1      
 283   1          // 将自定义字符数组写入CGRAM
 284   1          Write_CGRAM(pattern);
 285   1      
 286   1          // 遍历LCD的每一行和每一列，显示自定义字符
 287   1          for (row = 0; row < 4; row++) 
 288   1          {
 289   2              for (col = 0; col < 20; col++) 
 290   2              {
 291   3                  // 针对LCD2004的行起始地址做出修正
 292   3                  unsigned char position;
 293   3                  if (row == 0) 
 294   3                  {
 295   4                      position = 0x80 + col;   // 第1行地址 0x80 起始
 296   4                  } 
 297   3                  else if (row == 1)
 298   3                  {
 299   4                      position = 0xC0 + col;   // 第2行地址 0xC0 起始
 300   4                  } 
 301   3                  else if (row == 2) 
 302   3                  {
C51 COMPILER V9.60.7.0   LCD2004                                                           08/26/2025 18:46:25 PAGE 6   

 303   4                      position = 0x94 + col;   // 第3行地址 0x94 起始
 304   4                  } 
 305   3                  else 
 306   3                  {
 307   4                      position = 0xD4 + col;   // 第4行地址 0xD4 起始
 308   4                  }
 309   3      
 310   3                  // 设置光标位置并显示自定义字符
 311   3                  LCD_WriteCommand(position);
 312   3                  LCD_WriteData(0x00);  // 显示存储在CGRAM中的第一个自定义字符
 313   3              }
 314   2          }
 315   1      }
