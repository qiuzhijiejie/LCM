 205          //每次写入的字符 a 是递增的
 206          void write_CGROM(unsigned char a)
 207          {
 208   1          unsigned char j;
 209   1          LCD_WriteCommand(0x02);  // 光标归位命令 (光标位置回到初始位置，通常是DDRAM的起始地址)
 210   1          Delay(1);                // 延时一段时间，确保命令有效
 211   1          LCD_WriteCommand(0x80);  // 设置光标到第1行的起始地址 (0x80对应DDRAM的第1行起始地址)
 212   1          
 213   1          // 向第1行写入40个字符数据
 214   1          for (j = 0; j < 40; j++) 
 215   1          {
 216   2              LCD_WriteData(a);    // 向LCD写入数据 'a'
 217   2              a += 1;              // 自增'a'，以便下一个字符是'a'的下一个值
 218   2          }
 219   1      
 220   1          LCD_WriteCommand(0xC0);  // 设置光标到第2行的起始地址 (0xC0对应DDRAM的第2行起始地址)
 221   1          
 222   1          // 向第2行写入40个字符数据
 223   1          for (j = 0; j < 40; j++) 
 224   1          {
 225   2              LCD_WriteData(a);    // 向LCD写入数据 'a'
 226   2              a += 1;              // 自增'a'，同样依次写入下一个字符
 227   2          }
 228   1          
 229   1          Delay(1);                // 再次延时，确保数据全部写入
 230   1      }
