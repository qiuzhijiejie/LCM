 133          /**
 134            * @brief  LCD2004设置光标位置
 135            * @param  Line 行位置，范围：1~4
 136            * @param  Column 列位置，范围：1~20
 137            * @retval 无
 138            */
 139          void LCD_SetCursor(unsigned int Line, unsigned int Column) 
 140          {
 141   1          // 确保列值在0-19之间
 142   1          if (Column >= 20) Column = 0;
 143   1          // 确保行值在0-3之间
 144   1          Line &= 0x03;  // 限制 Y 位置在 0 到 3 之间
 145   1              
 146   1              
 147   1          if (Line == 0) 
 148   1          {
 149   2              LCD_WriteCommand(0x80 | Column);  // 第一行
 150   2          } 
 151   1          else if (Line == 1) 
 152   1          {
 153   2              LCD_WriteCommand(0xC0 | Column);  // 第二行
 154   2          } 
 155   1          else if (Line == 2) 
 156   1          {
 157   2              LCD_WriteCommand(0x80 | (Column + 20));  // 第三行
 158   2          } 
 159   1          else 
 160   1          {
 161   2              LCD_WriteCommand(0xC0 | (Column + 20));  // 第四行
 162   2          }
 163   1      }
