 610          void MAPPING(unsigned char bit_value) // bit_value: 1 or 0
 611          {
 612   1          unsigned char flag = 0xff;
 613   1          A0_RS = 0;  // command
 614   1          CS1 = 0;    // Left
 615   1          E_RD = 0;
 616   1          RW_WR = 1;
 617   1      
 618   1          if (bit_value == 1) {
 619   2              // Set the 6th bit to 1
 620   2              while ((flag & 0x40) == 0x40) { // Check the 6th bit (0x40)
 621   3                  E_RD = 1;
 622   3                  _nop_();
 623   3                  flag = DATA_BUS;
 624   3                  E_RD = 0;
 625   3              }
 626   2          } else {
 627   2              // Set the 6th bit to 0
 628   2              while ((flag & 0x40) != 0x40) { // Check the 6th bit (0x40)
 629   3                  E_RD = 1;
 630   3                  _nop_();
 631   3                  flag = DATA_BUS;
 632   3                  E_RD = 0;
 633   3              }
 634   2          }
 635   1      
 636   1          CS1 = 1;
 637   1      }


