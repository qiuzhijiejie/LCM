 228          *******************************************************/
 229          void roll_h(uint x,bit dir,bit part)
 230          {
 231   1       uchar i;
 232   1       uint  addr;
 233   1       if(dir) addr = x;  //Horizontally to the right
 234   1       else addr = 0;     //Horizontally to the left
 235   1       while(x--)
 236   1       {
 237   2        for(i = 0; i < 8; i++)
 238   2        {
 239   3         write_cmd(hdotscr);
 240   3         if(dir) write_dat(7 - i); //Horizontally to the right
C51 COMPILER V9.60.7.0   320240                                                            09/15/2025 15:40:47 PAGE 5   

 241   3         else write_dat(i);        //Horizontally to the left
 242   3        delay(50000);
 243   3        delay(50000);
 244   3        }
 245   2        if(dir) addr--;   //Horizontally to the right
 246   2        else addr++;      //Horizontally to the left
 247   2        if(part) set_addr2(addr); //2area
 248   2        else  set_addr1(addr);    //1area
 249   2       }
 250   1      }
 251          /******************************************************* 
 252          Vertical direction scrolling display 垂直方向滚动显示器
 253          x?? Rolling distance  Text--x  row ??Graphics--x pixels
 254          dir?? Rolling direction  0--Up ??1--Down
