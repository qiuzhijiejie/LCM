 749          void DisplayFullCGROM(void)
 750          {
 751   1          uchar x, y;
 752   1          uchar charCode = 0x01;  // CGROM 从 0x01 开始，0x00 是空格
 753   1      
 754   1          for (y = 0; y < 30; y++)      // 30 行（240 / 8 = 30）
 755   1          {
 756   2              for (x = 0; x < 40; x++)  // 40 列（320 / 8 = 40）
 757   2              {
 758   3                  locate_xy1(x, y);        // 文字区定位
 759   3                  write_cmd(mwrite);       // 写入模式
 760   3                  write_dat(charCode);     // 写入 CGROM 字符码
 761   3      
 762   3                  charCode++;
 763   3                  if (charCode == 0x00)    // 跳过 0x00（一般是空格）
 764   3                      charCode = 0x01;
 765   3              }
 766   2          }
