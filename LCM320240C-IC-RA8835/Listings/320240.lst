 256          *******************************************************/
 257          void roll_v(unsigned char x, bit dir, bit part)
 258          {
 259   1       unsigned char i;
 260   1       unsigned int  addr = 0;
 261   1       for(i = 0; i <= x; i++)
 262   1       {
 263   2        if(dir) addr = AP * (x - i); //Vertically upwards
 264   2        else addr = AP * i;          //Vertically downwards
 265   2        if(part) set_addr2(addr);    //2 area
 266   2        else  set_addr1(addr);       //1 area 
 267   2       delay(50000);
 268   2        delay(50000);
 269   2       }
 270   1      }
