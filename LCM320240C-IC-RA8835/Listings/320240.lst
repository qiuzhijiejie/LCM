 713          void DisplayDots(unsigned num1, unsigned num2)
 714          {
 715   1          uchar y;
 716   1          uint i;
 717   1      
 718   1          for (y = 0; y < 240; y++)  // RW8835 支持 240 行
 719   1          {
 720   2              locate_xy2(0, y);       // 设置当前行的起始位置为 X=0
 721   2      
 722   2              write_cmd(mwrite);      // 进入图形写入模式
 723   2      
 724   2              for (i = 0; i < 40; i++) // 每行写 320 像素 / 8 = 40 字节
 725   2              {
 726   3                  if (y % 2 == 1)
 727   3                      write_dat(num1);  // 奇数行：写满（点亮）
 728   3                  else
 729   3                      write_dat(num2);  // 偶数行：清零（熄灭）
 730   3              }
 731   2          }
 732   1      }
