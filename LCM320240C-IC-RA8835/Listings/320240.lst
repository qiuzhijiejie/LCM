 683          /******************************************************* 
 684          show moving circle   显示移动圆圈
 685          *******************************************************/
 686          void demo_game(void)
 687          {uchar cs=500;
 688   1       uchar r = 20;    //Radius
 689   1       uchar i = 3;    //Stepping variables
 690   1       int   x = 30,y = 30;     //Starting position
 691   1       int   dx = i,  dy = i;    //Stepping
 692   1       int   x1, y1;      //Save the last position
 693   1       
 694   1       //lcd_init();
 695   1       lcd_cls(0);
 696   1       while(cs--)
 697   1       {
 698   2        show_circle(x, y, r, 0);
 699   2        x1 = x, y1 = y;     //Save location
 700   2        if((x-r) < 0) dx = i;
 701   2        if((x+r) > 319) dx = -i;
 702   2        if((y-r) < 0) dy = i;
 703   2        if((y+r) > 239) dy = -i;
 704   2        x += dx;
 705   2        y += dy; 
 706   2        delay(50000);     
 707   2        show_circle(x1, y1, r, 1);   //Disappear before a round
 708   2        show_pixel(x1, y1, x&0x01);  //Locus
 709   2       }
 710   1      }
