 389          void show_line(uint x1,uchar y1,uint x2,uchar y2,bit attr)
 390          {
 391   1       int  dx, dy;
 392   1       char inc_x, inc_y;
 393   1       int  xerr = 0, yerr = 0;    //Initialize variables
 394   1       uint i, ds;
 395   1          dx = x2 - x1;       //Calculate the coordinates increment
 396   1          dy = y2 - y1;
 397   1       if(dx > 0) inc_x = 1;     //Set the single-step direction
 398   1       else 
 399   1       {
 400   2        if(dx == 0) {inc_x = 0;     } //Vertical line
 401   2        else  {inc_x = -1; dx = -dx;}
 402   2       }
 403   1       if(dy > 0) inc_y = 1;     //Set the single-step direction
 404   1       else
 405   1          {
 406   2        if(dy == 0) {inc_y = 0;     } //Horizontal line
 407   2        else  {inc_y = -1; dy = -dy;}
 408   2       }
 409   1       if(dx > dy) ds = dx;     //select the basic incremental axis
 410   1       else  ds = dy;
 411   1       for(i = 0; i <= ds+1; i++)    //drawing line
 412   1       {
 413   2        show_pixel(x1, y1, attr);   //drawing pixel
 414   2        xerr += dx;
 415   2        yerr += dy;
 416   2        if(xerr > ds)
 417   2        {
 418   3         xerr -= ds;
 419   3         x1   += inc_x;
 420   3        }
 421   2        if(yerr > ds)
 422   2        {
 423   3         yerr -= ds;
 424   3         y1   += inc_y;
 425   3        }
