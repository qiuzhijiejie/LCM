 118          /******************************************************* 
 119          clear display  清晰的显示屏
 120          32KB RAM 
 121          part = 1  1area
 122          part = 2  2area
 123          part = 3  3area
 124          part = 4  4area              
 125          *******************************************************/
 126          void lcd_cls(uchar part)
 127          {
 128   1       uint i = 10240;       //10240 = 0x2800  10KB RAM
 129   1       write_cmd(csrw);      //Write cursor address
 130   1       write_dat(0x00);      //First write the low eight
 131   1            if(part == 1) write_dat(0x00);     //1area
 132   1       else if(part == 2) write_dat(basepart2);//2area
 133   1       else if(part == 3) write_dat(basepart3);//3area
 134   1       else if(part == 4) write_dat(basepart4);//4area
 135   1       else {i = 32768;   write_dat(0x00);}    //After writing the high eight, All dispay area 32KB RAM
 136   1       write_cmd(csrdirr);   //Cursor right direction
 137   1       write_cmd(mwrite);    //write data 
 138   1       while(i--) write_dat(0x00);//Write 0
 139   1      }
