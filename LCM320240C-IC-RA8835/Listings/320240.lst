  13          void write_cmd(unsigned char cmd)
  14          {
  15   1       CS = 0;
  16   1       _RD = 1;  
  17   1       P1 = cmd;
  18   1       CD = 1;    //command
  19   1       _WR = 0;    //Rising edge of write
  20   1       _WR = 1;
  21   1       CS = 1;
  22   1      }
  23          /******************************************************* 
  24          Write command parameters, display data  写命令参数，显示数据
  25          *******************************************************/
  26          void write_dat(unsigned char dat)
  27          {chkbusy();
  28   1       CS = 0;
  29   1       _RD = 1;
  30   1       P1 = dat;
  31   1       CD = 0;    //data
  32   1       _WR = 0;    //Rising edge of write
  33   1       _WR = 1;
  34   1       CS = 1;
  35   1      }
  36          /******************************************************* 
  37          read data  读取数据
  38          *******************************************************/
  39          uchar read_dat(void)
  40          { uchar temp=0;
  41   1      chkbusy();
  42   1       CS = 0;
  43   1       CD   = 1;
  44   1       _WR   = 1;
  45   1       _RD   = 0;
  46   1       temp = P1;
  47   1       _RD   = 1;
  48   1        CS = 1;
  49   1       return (temp);
  50   1      }
